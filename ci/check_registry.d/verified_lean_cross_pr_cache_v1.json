{
  "schema_version": "0.2",
  "policy": {
    "boundaries": [
      "Canonical artifact transport does not replace exact-head strict Lean.",
      "Unknown or invalid origin, scope, digest, expiry or transport is a cache miss."
    ]
  },
  "checks": {
    "verified-lean-cross-pr-cache-v1": {
      "name": "Verified canonical Lean cross-PR cache trust and transport",
      "runner": "python",
      "command": "python3 -m unittest -v tests.test_ci_verified_lean_project_cache_v1",
      "group": "static",
      "tier": "critical",
      "paths": [
        "scripts/ci_verified_lean_project_cache_v1.py",
        ".github/workflows/lean-certified-project-cache-v1.yml",
        "tests/test_ci_verified_lean_project_cache_v1.py",
        ".github/workflows/lean-certified-project-cache-sandbox-v1.yml",
        ".github/workflows/pr-governance-gate.yml",
        "docs/CI_VERIFIED_LEAN_CROSS_PR_CACHE_V1.md",
        "ci/check_registry.d/verified_lean_cross_pr_cache_v1.json"
      ],
      "depends_on": [
        "ci-audit-tests",
        "workflow-integrity"
      ],
      "timeout_minutes": 10,
      "pr_required": true,
      "full_audit_member": true
    }
  }
}
