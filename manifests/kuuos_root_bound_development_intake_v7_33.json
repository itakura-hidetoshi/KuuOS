    "root_bound_task_intake_ready_local_reconciliation_required",
    "root_bound_task_intake_ready_future_mutation_authority_required",
    "root_bound_task_intake_route_degraded",
    "root_main_reobservation_required",
    "root_binding_obstruction",
    "task_binding_obstruction"
  ],
  "routing_contract": {
    "router": "KuuOS Development MCP Capability Routing v7.24",
    "routing_is_preview_only": true,
    "routing_request_write": false,
    "mutation_requested_preserved_separately": true,
    "required_fact_planes_are_task_specific": true,
    "maximal_profile_activated_by_default": false
  },
  "root_freshness_contract": {
    "fresh_current_main_observation_required": true,
    "current_main_must_equal_bound_root_for_task_intake": true,
    "changed_current_main_returns_to_v7_32": true
  },
  "next": "Materialize the required fresh observations for the root-bound task and only then derive repair/readiness states; acquire new authority separately when mutation is requested."
}
