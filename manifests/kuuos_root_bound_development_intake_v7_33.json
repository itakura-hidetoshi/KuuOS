    "KuuOS Development Lineage Re-rooting v7.32",
    "KuuOS Development MCP Capability Routing v7.24"
  ],
  "core_rules": {
    "task_must_bind_exact_lineage_root": true,
    "task_must_bind_root_main_sha": true,
    "task_must_bind_intent_and_scope_digests": true,
    "root_movement_requires_reroot_reobservation": true,
    "mutation_intent_is_allowed": true,
    "intake_executes_mutation": false,
    "intake_grants_write_authority": false,
    "intake_grants_merge_authority": false,
    "predecessor_authority_may_be_reused": false,
    "missing_required_mcp_plane_rejects_task": false,
    "local_reconciliation_blocks_remote_only_intake": false,
    "target_paths_must_remain_inside_repository": true
