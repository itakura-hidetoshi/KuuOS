    "detach_label": "issue_write(method=update,labels=[])",
    "verify_detached": "issue_read(method=get_labels) returns an empty set",
    "delete_label": "label_write(method=delete)",
    "verify_deleted": "get_label returns bounded not-found",
    "compensation": "restore an empty Issue label set before deleting the nonce label; compensation never upgrades to verified success",
