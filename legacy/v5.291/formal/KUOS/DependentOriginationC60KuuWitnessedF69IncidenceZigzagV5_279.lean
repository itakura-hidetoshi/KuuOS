/-!
# v5.279 / F112 seventh stage — original F69 incidence ZIGZAG bridge

The ORIGINAL physical C60 incidence poset contains vertices, edges,
and pentagon/hexagon faces, with arrows vertex → edge → face, but
it does NOT contain a direct original arrow between two distinct
physical edges (the v5.278 formal no-go).

v5.278 independently constructed a free path category of arbitrary
finite proof-relevant REAL physical overlap sites, supporting an
original F47 source Cat-valued functor and a genuine Grothendieck
total category, with entire Int×Int and ZMod2 phase preserved.

This stage bridges the two TRUE geometries WITHOUT identifying them:
* a second FREE ZIGZAG category is generated by an ACTUAL, typed
  original F69 incidence inequality, used either FORWARD or as a
  FORMALLY REVERSED edge. These reverse steps are NOT falsely
  morphisms in the original F69 preorder category.
* every witnessed physical overlap edge i→j is realized as an
  EXACT TWO-LEG zigzag through W.common.1, an ACTUAL F69 cell
  shared by its original distinct C60 edge stars;
* arbitrary witnessed C60 paths map to concatenated ORIGINAL
  F69-incidence zigzags via an honest Mathlib FUNCTOR;
* geometry supports all original F47 Grothendieck total objects:
  composing the original F47 projection with that zigzag functor
  yields a real full source→geometry functor, retaining the
  original F42/F54 boundary tags in the total category;
* there is a PROVEN impossibility of any functor from the new
  free zigzag category to the ORIGINAL F69 incidence poset
  that sends every site to the same original site, whenever
  a genuine distinct-edge overlap witness exists.

This is a CATEGORICAL SPAN/ZIGZAG BRIDGE with genuine original
oriented incidence legs, NOT a modification to the old F69
partial order, not an assertion that formal inverses are genuine
old morphisms, and not global original F42/F54/F55 effective
descent. Original F55 Delta non-lift, F77 phase erasure and
signed F68 north curvature charge -5 remain.
-/

/-! ## I. Original-incidence-oriented free zigzag category -/

/-- New object wrapper is INTENTIONAL: the genuine original F69
site already has its ORIGINAL partial-order category. The
zigzag/free-reversal category must not overwrite that category. -/
structure C60F113ZigzagSite where
  site : C60F69PhysicalCellSite

/-- A finite path of genuine ORIGINAL F69 incidence arrows and
their FORMAL REVERSES. Each generator carries an ACTUAL original
site inequality; an inverted generator is NOT asserted to exist
as a hom in the underlying old original F69 poset. -/
inductive C60F113IncidenceZigzag :
    C60F69PhysicalCellSite → C60F69PhysicalCellSite → Type where
  | nil (s : C60F69PhysicalCellSite) :
      C60F113IncidenceZigzag s s
  | forward {s t u : C60F69PhysicalCellSite}
      (h : s ≤ t) (rest : C60F113IncidenceZigzag t u) :
      C60F113IncidenceZigzag s u
  | backward {s t u : C60F69PhysicalCellSite}
      (h : t ≤ s) (rest : C60F113IncidenceZigzag t u) :
      C60F113IncidenceZigzag s u

/-- Concatenate proof-carrying genuine old F69 oriented legs,
without cancelling formal backtracking or identifying old sites. -/
def c60F113ZigzagAppend
    {s t u : C60F69PhysicalCellSite}
    (first : C60F113IncidenceZigzag s t)
    (second : C60F113IncidenceZigzag t u) :
    C60F113IncidenceZigzag s u :=
  match first with
  | .nil _ => second
  | .forward h rest => .forward h (c60F113ZigzagAppend rest second)
  | .backward h rest => .backward h (c60F113ZigzagAppend rest second)

theorem c60F113ZigzagAppend_nil_right
    {s t : C60F69PhysicalCellSite}
    (p : C60F113IncidenceZigzag s t) :
    c60F113ZigzagAppend p (.nil t) = p := by
  induction p with
  | nil _ => rfl
  | forward h rest ih =>
      change C60F113IncidenceZigzag.forward h
          (c60F113ZigzagAppend rest (.nil _)) =
        C60F113IncidenceZigzag.forward h rest
      rw [ih]
  | backward h rest ih =>
      change C60F113IncidenceZigzag.backward h
          (c60F113ZigzagAppend rest (.nil _)) =
        C60F113IncidenceZigzag.backward h rest
      rw [ih]

theorem c60F113ZigzagAppend_assoc
    {s t u v : C60F69PhysicalCellSite}
    (p : C60F113IncidenceZigzag s t)
    (q : C60F113IncidenceZigzag t u)
    (r : C60F113IncidenceZigzag u v) :
    c60F113ZigzagAppend (c60F113ZigzagAppend p q) r =
      c60F113ZigzagAppend p (c60F113ZigzagAppend q r) := by
  induction p with
  | nil _ => rfl
  | forward h rest ih =>
      change C60F113IncidenceZigzag.forward h
          (c60F113ZigzagAppend (c60F113ZigzagAppend rest q) r) =
        C60F113IncidenceZigzag.forward h
          (c60F113ZigzagAppend rest (c60F113ZigzagAppend q r))
      rw [ih]
  | backward h rest ih =>
      change C60F113IncidenceZigzag.backward h
          (c60F113ZigzagAppend (c60F113ZigzagAppend rest q) r) =
        C60F113IncidenceZigzag.backward h
          (c60F113ZigzagAppend rest (c60F113ZigzagAppend q r))
      rw [ih]

/-- TRUE Mathlib category of finite forward/reverse original
F69 incidence legs, on NEW site objects. The ORIGINAL
F69 incidence category remains completely unchanged. -/
instance c60F113IncidenceZigzagCategory :
    Category C60F113ZigzagSite where
  Hom X Y := C60F113IncidenceZigzag X.site Y.site
  id X := .nil X.site
  comp f g := c60F113ZigzagAppend f g
  id_comp := by intro X Y f; rfl
  comp_id := by
    intro X Y f
    exact c60F113ZigzagAppend_nil_right f
  assoc := by
    intro W X Y Z f g h
    exact c60F113ZigzagAppend_assoc f g h

/-! ## II. Each REAL distinct-edge overlap is a TWO-LEG F69 zigzag -/

/-- The actual original F69 physical-star condition contains
one of two GENUINE, oriented incidence arrows. This builds
the ONE formal zigzag leg from the physical EDGE to the
common ORIGINAL site, reversing an original arrow only if
the physical partial order requires that orientation. -/
def c60F113EdgeToCommonSite
    (e : TruncatedIcosahedralEdge)
    (site : C60F69PhysicalCellSite)
    (hstar : c60F106IncidenceStar e site) :
    C60F113IncidenceZigzag (.edge e) site := by
  classical
  have h : site ≤ C60F69PhysicalCellSite.edge e ∨
      C60F69PhysicalCellSite.edge e ≤ site := hstar
  by_cases hle : site ≤ C60F69PhysicalCellSite.edge e
  · exact .backward hle (.nil site)
  · exact .forward (h.resolve_left hle) (.nil site)

/-- The second genuine incident old F69 leg leads FROM the
common original cell TO the different real physical edge.
Only the direction of old incidence may need formal reversal. -/
def c60F113CommonSiteToEdge
    (e : TruncatedIcosahedralEdge)
    (site : C60F69PhysicalCellSite)
    (hstar : c60F106IncidenceStar e site) :
    C60F113IncidenceZigzag site (.edge e) := by
  classical
  have h : site ≤ C60F69PhysicalCellSite.edge e ∨
      C60F69PhysicalCellSite.edge e ≤ site := hstar
  by_cases hle : site ≤ C60F69PhysicalCellSite.edge e
  · exact .forward hle (.nil _)
  · exact .backward (h.resolve_left hle) (.nil _)

/-- A GENUINE v5.277 distinct-C60-edge incidence overlap
provides an exact two-leg oriented zigzag
  edge_i → common ORIGINAL vertex/edge/face ←/→ edge_j.
No old F69 direct edge_i→edge_j Hom is introduced. -/
def c60F113RealOverlapTwoLegZigzag
    {n : Nat} (C : C60F108BothFaceContexts n)
    {i j : Fin n} (W : C60F112DistinctEdgeOverlap C i j) :
    C60F113IncidenceZigzag (.edge (C.edge i)) (.edge (C.edge j)) :=
  c60F113ZigzagAppend
    (c60F113EdgeToCommonSite
      (C.edge i) W.common.1 (W.common.2 i (by simp)))
    (c60F113CommonSiteToEdge
      (C.edge j) W.common.1 (W.common.2 j (by simp)))

/-- At the original categorical level, the REAL two-leg
physical bridge is a morphism only in the NEW zigzag category,
not in the old original F69 incidence category. -/
def c60F113RealOverlapZigzagHom
    {n : Nat} (C : C60F108BothFaceContexts n)
    {i j : Fin n} (W : C60F112DistinctEdgeOverlap C i j) :
    (⟨.edge (C.edge i)⟩ : C60F113ZigzagSite) ⟶
      (⟨.edge (C.edge j)⟩ : C60F113ZigzagSite) :=
  c60F113RealOverlapTwoLegZigzag C W

/-! ## III. Arbitrary witnessed overlap paths to genuine F69 zigzags -/

/-- Map an ARBITRARY finite path of ORIGINAL physical edge
overlap witnesses to a finite path of typed original F69
forward/backward incidence arrows. Every source edge step
is expanded through its true old common physical cell. -/
def c60F113WitnessedToZigzagPath
    {n : Nat} (C : C60F108BothFaceContexts n)
    {i j : Fin n} (p : C60F112WitnessedOverlapPath C i j) :
    C60F113IncidenceZigzag (.edge (C.edge i)) (.edge (C.edge j)) :=
  match p with
  | .nil i => .nil (.edge (C.edge i))
  | .step (i := i) W tail =>
      c60F113ZigzagAppend
        (c60F113RealOverlapTwoLegZigzag C W)
        (c60F113WitnessedToZigzagPath C tail)

/-- All proof-relevant REAL intersection steps are preserved
when mapping finite physical overlap paths into original
F69 zigzags. Concatenation of two source paths maps to
concatenation of precisely their original F69 oriented legs. -/
theorem c60F113WitnessedToZigzag_append
    {n : Nat} (C : C60F108BothFaceContexts n)
    {i j k : Fin n}
    (first : C60F112WitnessedOverlapPath C i j)
    (second : C60F112WitnessedOverlapPath C j k) :
    c60F113WitnessedToZigzagPath C
        (c60F112WitnessedOverlapAppend first second) =
      c60F113ZigzagAppend
        (c60F113WitnessedToZigzagPath C first)
        (c60F113WitnessedToZigzagPath C second) := by
  induction first with
  | nil i => rfl
  | @step i j k W rest ih =>
      change
        c60F113ZigzagAppend
          (c60F113RealOverlapTwoLegZigzag C W)
          (c60F113WitnessedToZigzagPath C
            (c60F112WitnessedOverlapAppend rest second)) =
        c60F113ZigzagAppend
          (c60F113ZigzagAppend
            (c60F113RealOverlapTwoLegZigzag C W)
            (c60F113WitnessedToZigzagPath C rest))
          (c60F113WitnessedToZigzagPath C second)
      rw [ih]
      exact (c60F113ZigzagAppend_assoc _ _ _).symm

/-- A REAL Mathlib FUNCTOR from the genuine witnessed-original-
physical-overlap PATH category to the new freely reversed
original F69 incidence zigzag category. It does NOT target
the original F69 poset, and does NOT falsely turn reverse
incidence into true original arrows. -/
def c60F113WitnessedToF69Zigzag
    {n : Nat} (C : C60F108BothFaceContexts n) :
    C60F112WitnessedEdge C ⥤ C60F113ZigzagSite where
  obj X := ⟨.edge (C.edge X.index)⟩
  map := fun {_ _} f => c60F113WitnessedToZigzagPath C f
  map_id := by
    intro X
    rfl
  map_comp := by
    intro X Y Z f g
    change
      c60F113WitnessedToZigzagPath C
        (c60F112WitnessedOverlapAppend f g) =
      c60F113ZigzagAppend
        (c60F113WitnessedToZigzagPath C f)
        (c60F113WitnessedToZigzagPath C g)
    exact c60F113WitnessedToZigzag_append C f g

/-- The new witnessed physical-overlap F69 zigzag is
NOT the old physical INCIDENCE preorder. An original-site-
preserving functor from the zigzag category to the original
F69 category would create a forbidden genuine old arrow
between two DISTINCT original physical C60 edges. -/
theorem c60F113NoOriginalIncidenceProjection
    {n : Nat} (C : C60F108BothFaceContexts n)
    {i j : Fin n} (W : C60F112DistinctEdgeOverlap C i j) :
    ¬ ∃ F : C60F113ZigzagSite ⥤ C60F69PhysicalCellSite,
      ∀ s : C60F69PhysicalCellSite,
        F.obj (⟨s⟩ : C60F113ZigzagSite) = s := by
  rintro ⟨F, hF⟩
  have h : C60F69PhysicalCellSite.edge (C.edge i) ≤
      C60F69PhysicalCellSite.edge (C.edge j) := by
    have hmap := CategoryTheory.leOfHom
      (F.map (c60F113RealOverlapZigzagHom C W))
    rw [hF (.edge (C.edge i)), hF (.edge (C.edge j))] at hmap
    exact hmap
  exact W.edge_ne h

/-! ## IV. Pair ORIGINAL source F47 Grothendieck with geometry -/

