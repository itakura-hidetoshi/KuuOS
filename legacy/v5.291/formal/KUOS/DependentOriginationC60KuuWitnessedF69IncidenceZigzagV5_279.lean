/-- The FULL ORIGINAL F42/F54/F55 four-boundary Grothendieck
category of actual F47 source terms now has a rigorously
typed geometric support in the new old-incidence ZIGZAG
category: actual total-source projection followed by the
new TRUE-original-F69-incidence-leg bridge. -/
def c60F113F47TotalToPhysicalZigzag
    {n : Nat} (C : C60F108BothFaceContexts n)
    (P : (i : Fin n) → C60F112IndependentOddFacePair C i) :
    c60F112WitnessedF47Grothendieck
        t₁ t₂ left right C P ⥤ C60F113ZigzagSite :=
  c60F112WitnessedF47TotalProjection t₁ t₂ left right C P ⋙
    c60F113WitnessedToF69Zigzag C

/-- Each total original source F47 object retains precisely
its ACTUAL original C60 physical edge geometric site when
interpreted in the new forward/reverse F69 zigzag category,
and its original four-boundary source fibre remains in the
untouched total category. -/
theorem c60F113F47TotalGeometry_obj
    {n : Nat} (C : C60F108BothFaceContexts n)
    (P : (i : Fin n) → C60F112IndependentOddFacePair C i)
    (X : c60F112WitnessedF47Grothendieck
      t₁ t₂ left right C P) :
    (c60F113F47TotalToPhysicalZigzag
      t₁ t₂ left right C P).obj X =
      (⟨.edge (C.edge X.base.index)⟩ : C60F113ZigzagSite) := rfl

/-- The source four-boundary F47 transport on any true
physical-overlap path keeps every OLD independent integer
charge and phase while its geometric zigzag consists ONLY
of actual original F69 oriented incidence legs. These
are complementary constructions, not identification of
original F42, F54 and F69 Hom types. -/
theorem c60F113WitnessedGeometry_and_F47FullNative
    {n : Nat} (C : C60F108BothFaceContexts n)
    (P : (i : Fin n) → C60F112IndependentOddFacePair C i)
    {i j : Fin n}
    (p : C60F112WitnessedOverlapPath C i j)
    {X Y : c60F112WitnessedF47Fibre t₁ t₂ left right C P i}
    (f : X ⟶ Y) :
    ((c60F113WitnessedToF69Zigzag C).map
        (p : (⟨i⟩ : C60F112WitnessedEdge C) ⟶
          (⟨j⟩ : C60F112WitnessedEdge C)) =
      c60F113WitnessedToZigzagPath C p) ∧
    c60F47MixedEval
      ((c60F112WitnessedF47Transport
        t₁ t₂ left right C P p).map f) =
      c60F47MixedEval f := by
  exact ⟨rfl,
    c60F112WitnessedF47Transport_fullNative
      t₁ t₂ left right C P p f⟩

