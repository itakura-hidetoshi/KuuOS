variable {p₀ p₁ p₂ : Blocks a b}
variable {q₀ q₁ q₂ : Blocks x y}
variable
  (t₁ : OriginalF45BracketTree n₁ m₁ p₀ q₀ p₁ q₁)
  (t₂ : OriginalF45BracketTree n₂ m₂ p₁ q₁ p₂ q₂)
variable
  {leftAfter : OriginalF45BracketTree n₁ m₁ p₀ q₀ p₁ q₁}
  {rightAfter : OriginalF45BracketTree n₂ m₂ p₁ q₁ p₂ q₂}
  (left : OriginalF45BracketTree.LocalRotation t₁ leftAfter)
  (right : OriginalF45BracketTree.LocalRotation t₂ rightAfter)

/-- The original two distinct orderings of actual F54 contextual
rotations, indexed by Bool without identifying the raw routes. -/
def c60F20OriginalSquareRoute (i : Bool) :
    OriginalF45BracketTree.DepthRotationRoute
      (OriginalF45BracketTree.node t₁ t₂)
      (OriginalF45BracketTree.node leftAfter rightAfter) :=
  if i then
    OriginalF45BracketTree.DepthRotationRoute.squareRightFirst left right
  else
    OriginalF45BracketTree.DepthRotationRoute.squareLeftFirst left right

/-- ACTUAL SOURCE LIFT: a square-only word is turned into a true
F55 PresentedCell with endpoints the actual original two F54
DepthRotationRoutes. Each recursive case is type-correct. -/
def C60F55SquareWord.toOriginalF55 :
    {i j : Bool} → (word : C60F55SquareWord i j) →
      OriginalF45BracketTree.DepthRotationRoute.PresentedCell
        (c60F20OriginalSquareRoute t₁ t₂ left right i)
        (c60F20OriginalSquareRoute t₁ t₂ left right j)
  | _, _, .ident i =>
      .ident (c60F20OriginalSquareRoute t₁ t₂ left right i)
  | _, _, .square =>
      .disjointSquare left right
  | _, _, .inverseSquare =>
      .symm (.disjointSquare left right)
  | _, _, .trans before after =>
      .trans (toOriginalF55 before) (toOriginalF55 after)

/-- This SOURCE construction is interpreted by the PREEXISTING
independent F59 braidedPhase HigherCellTarget. It agrees on every
original square-word constructor with the graded target evaluation
as an EQUALITY OF NATIVE GRAY 3-CELLS, not merely numerical charge. -/
theorem C60F55SquareWord.interpretOriginal_eq_evalGray
    {i j : Bool} (word : C60F55SquareWord i j) :
    (word.toOriginalF55 t₁ t₂ left right).interpret
      (OriginalF45BracketTree.DepthRotationRoute.HigherCellTarget.braidedPhase
        (D := D) (E := E)) = word.evalGray := by
  induction word with
  | ident k =>
      change GradedThreeCell.ident 0 = 0
      apply GradedThreeCell.ext <;> rfl
  | square =>
      rfl
  | inverseSquare =>
      change originalF55BraidedSquareGenerator.inv =
        -originalF55BraidedSquareGenerator
      apply GradedThreeCell.ext <;> rfl
  | trans before after ihBefore ihAfter =>
      change ((before.toOriginalF55 t₁ t₂ left right).interpret
        (OriginalF45BracketTree.DepthRotationRoute.HigherCellTarget.braidedPhase
          (D := D) (E := E))).comp
          ((after.toOriginalF55 t₁ t₂ left right).interpret
            (OriginalF45BracketTree.DepthRotationRoute.HigherCellTarget.braidedPhase
              (D := D) (E := E))) = before.evalGray + after.evalGray
      rw [ihBefore, ihAfter]
      exact (grayNeutral_add_eq_native_comp before.evalGray after.evalGray).symm

/-- Rigidity of actual F55 source words at FIXED original F54
disjoint rotation routes: irrespective of any inserted inverse,
identity or vertical paste, the interpreted Gray 3-cell is
exactly the original (0,1;1) square generator. -/
theorem C60F55SquareWord.fixedBoundary_braidedRigidity
    (word : C60F55SquareWord false true) :
    (word.toOriginalF55 t₁ t₂ left right).interpret
      (OriginalF45BracketTree.DepthRotationRoute.HigherCellTarget.braidedPhase
        (D := D) (E := E)) = originalF55BraidedSquareGenerator := by
  rw [word.interpretOriginal_eq_evalGray t₁ t₂ left right,
    word.evalGray_eq_smul,
    word.fixedBoundary_degree]
  simp

/-- This result is about actual original typed F55 cells:
its interpreter has exactly the original integer square charge
and odd exchange phase for every fixed-route square-only word. -/
theorem C60F55SquareWord.fixedBoundary_charge_phase
    (word : C60F55SquareWord false true) :
    ((word.toOriginalF55 t₁ t₂ left right).interpret
      (OriginalF45BracketTree.DepthRotationRoute.HigherCellTarget.braidedPhase
        (D := D) (E := E))).charge =
        ((0 : ℤ), (1 : ℤ)) ∧
    ((word.toOriginalF55 t₁ t₂ left right).interpret
      (OriginalF45BracketTree.DepthRotationRoute.HigherCellTarget.braidedPhase
        (D := D) (E := E))).phase = (1 : ZMod 2) := by
  rw [word.fixedBoundary_braidedRigidity t₁ t₂ left right]
  exact originalF55BraidedSquareGenerator_complete

/-- Source no-go for the complete square-only fixed-boundary
fragment. Assign ANY original F55 PresentedCell square-word
left→right to each actual C60 edge; its local face curvature
cannot be flat on all true pentagonal and hexagonal faces. -/
theorem c60F20SquareWordAssignments_notFlat
    (words : TruncatedIcosahedralEdge →
      C60F55SquareWord false true) :
    ¬ (c60F18GrayEdgeCochain
      (fun e => ((words e).toOriginalF55 t₁ t₂ left right).interpret
        (OriginalF45BracketTree.DepthRotationRoute.HigherCellTarget.braidedPhase
          (D := D) (E := E)))).comp c60IntegralBoundaryTwo = 0 := by
  have hw :
      (fun e : TruncatedIcosahedralEdge =>
        ((words e).toOriginalF55 t₁ t₂ left right).interpret
          (OriginalF45BracketTree.DepthRotationRoute.HigherCellTarget.braidedPhase
            (D := D) (E := E))) = c60F19UniformF55EdgeLabels := by
    funext e
    exact (words e).fixedBoundary_braidedRigidity t₁ t₂ left right
  intro h
  rw [hw] at h
  have hflat : c60F19OriginalF55EdgeCochain.comp
      c60IntegralBoundaryTwo = 0 := h
  obtain ⟨φ, hφ⟩ :=
    (c60F18ClosedEdgeIffVertexPotential
      c60F19OriginalF55EdgeCochain).mp hflat
  exact c60F19OriginalF55EdgeCochain_no_vertexGauge ⟨φ, hφ⟩

/-- Concrete nonliftability of the EXISTING flat 27-edge target
repair into this specific ORIGINAL F55 fixed-square-boundary
fragment: even arbitrary independent source words at all ninety
physical edges cannot match all corrected target edge labels. -/
theorem c60F20Canonical27Repair_noFixedSquareSourceLift :
    ¬ ∃ words : TruncatedIcosahedralEdge →
        C60F55SquareWord false true,
      ∀ e : TruncatedIcosahedralEdge,
        (c60F19OriginalF55EdgeCochain +
          c60F19CanonicalTreeCorrection)
          (Finsupp.single e (1 : ℤ)) =
          ((words e).toOriginalF55 t₁ t₂ left right).interpret
            (OriginalF45BracketTree.DepthRotationRoute.HigherCellTarget.braidedPhase
              (D := D) (E := E)) := by
  rintro ⟨words, hwords⟩
  let e : TruncatedIcosahedralEdge := .around ⟨.north, .s4⟩
  have hword : ((words e).toOriginalF55 t₁ t₂ left right).interpret
        (OriginalF45BracketTree.DepthRotationRoute.HigherCellTarget.braidedPhase
          (D := D) (E := E)) =
            originalF55BraidedSquareGenerator :=
    (words e).fixedBoundary_braidedRigidity t₁ t₂ left right
  have h : c60F19CanonicalTreeCorrection
      (Finsupp.single e (1 : ℤ)) = 0 := by
    have hh := hwords e
    simp only [LinearMap.add_apply] at hh
    rw [hword, c60F20OriginalF55SingleEdge] at hh
    have hhc : originalF55BraidedSquareGenerator +
        c60F19CanonicalTreeCorrection
          (Finsupp.single e (1 : ℤ)) =
        originalF55BraidedSquareGenerator + 0 := by
      simpa using hh
    exact add_left_cancel hhc
  have hdegree : c60F20OriginalTreeCorrectionDegree e ≠ 0 := by decide
  have hnonzero :
      c60F19CanonicalTreeCorrection (Finsupp.single e (1 : ℤ)) ≠ 0 := by
    rw [c60F20CanonicalCorrection_edgeFormula]
    exact (c60F20OriginalGeneratorNonzeroScalar_iff _).mpr hdegree
  exact hnonzero h

