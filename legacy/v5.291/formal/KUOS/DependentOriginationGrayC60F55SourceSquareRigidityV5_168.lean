/-- A genuinely TYPED, freely generated original-square-only
source fragment: false means squareLeftFirst, true means
squareRightFirst. Each constructor remembers BOTH endpoints. -/
inductive C60F55SquareWord : Bool → Bool → Type where
  | ident (i : Bool) : C60F55SquareWord i i
  | square : C60F55SquareWord false true
  | inverseSquare : C60F55SquareWord true false
  | trans {i j k : Bool}
      (before : C60F55SquareWord i j)
      (after : C60F55SquareWord j k) :
        C60F55SquareWord i k

/-- The integer square-generator charge on this ORIGINAL
fixed-boundary word grammar, with all four constructor cases. -/
def C60F55SquareWord.degree :
    {i j : Bool} → C60F55SquareWord i j → ℤ
  | _, _, .ident _ => 0
  | _, _, .square => 1
  | _, _, .inverseSquare => -1
  | _, _, .trans before after =>
      before.degree + after.degree

/-- The only boundary datum needed to determine a square-only
word's integer charge: zero on the left route and one on right. -/
def c60F20SquareEndpointCharge : Bool → ℤ
  | false => 0
  | true => 1

/-- KEY SOURCE-WORD INVARIANT: all inserted loops in the original
square-only grammar have degree zero. This holds for arbitrarily
nested inverse and composite words, not just the generator. -/
theorem C60F55SquareWord.degree_eq_endpointDifference
    {i j : Bool} (word : C60F55SquareWord i j) :
    word.degree =
      c60F20SquareEndpointCharge j -
        c60F20SquareEndpointCharge i := by
  induction word with
  | ident k =>
      simp [C60F55SquareWord.degree]
  | square =>
      decide
  | inverseSquare =>
      decide
  | trans before after ihBefore ihAfter =>
      change before.degree + after.degree = _
      rw [ihBefore, ihAfter]
      abel

/-- Every original F55 square-only source word with the SAME
original left-to-right route boundary has generator charge ONE. -/
theorem C60F55SquareWord.fixedBoundary_degree
    (word : C60F55SquareWord false true) :
    word.degree = 1 := by
  rw [word.degree_eq_endpointDifference]
  norm_num [c60F20SquareEndpointCharge]

/-- Target evaluation that records ALL groupoid source-word
constructors before we connect it to the true original F55
PresentedCell interpreter. This is not the source definition. -/
def C60F55SquareWord.evalGray :
    {i j : Bool} → C60F55SquareWord i j → GradedThreeCell 0 0
  | _, _, .ident _ => 0
  | _, _, .square => originalF55BraidedSquareGenerator
  | _, _, .inverseSquare => -originalF55BraidedSquareGenerator
  | _, _, .trans before after =>
      before.evalGray + after.evalGray

/-- Full word-level Gray value depends ONLY on signed generator
degree, including nontrivial nested inverse/vertical pastes. -/
theorem C60F55SquareWord.evalGray_eq_smul
    {i j : Bool} (word : C60F55SquareWord i j) :
    word.evalGray = word.degree • originalF55BraidedSquareGenerator := by
  induction word with
  | ident k =>
      simp [C60F55SquareWord.evalGray, C60F55SquareWord.degree]
  | square =>
      simp [C60F55SquareWord.evalGray, C60F55SquareWord.degree]
  | inverseSquare =>
      simp [C60F55SquareWord.evalGray, C60F55SquareWord.degree]
  | trans before after ihBefore ihAfter =>
      change before.evalGray + after.evalGray =
        (before.degree + after.degree) • originalF55BraidedSquareGenerator
      rw [ihBefore, ihAfter, add_smul]

/-! ## Map EACH WORD to the ACTUAL dependently typed original F55 source -/

universe uD vD uE vE
variable {D : Type uD} [Category.{vD} D]
variable {E : Type uE} [Category.{vE} E]

section ActualF55Source
variable {a b : D} {x y : E}
