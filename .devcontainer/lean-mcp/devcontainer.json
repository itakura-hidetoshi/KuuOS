{
  "name": "KuuOS — pinned Lean MCP (opt-in, Codespaces free tier)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "leanprover.lean4"
      ]
    }
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.elan/bin:/home/vscode/.local/bin:${containerEnv:PATH}",
    "LEAN_MCP_SCRATCH_SLOTS": "1"
  },
  "postCreateCommand": "bash scripts/bootstrap_kuuos_codespaces_lean_mcp_v1.sh --install",
  "postStartCommand": "bash scripts/bootstrap_kuuos_codespaces_lean_mcp_v1.sh --check",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  }
}
