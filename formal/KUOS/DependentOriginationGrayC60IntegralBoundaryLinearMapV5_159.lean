#print axioms c60IntegralFundamentalSurfaceChain
#print axioms c60IntegralFundamentalSurfaceChain_coeff
#print axioms c60IntegralFundamentalSurfaceChain_ne_zero
#print axioms c60IntegralBoundaryTwo_fundamental_zero
#print axioms c60IntegralFundamentalSurfaceChain_mem_kernel
#print axioms c60IntegralBoundaryTwo_kernel_ne_bot
#print axioms c60IntegralFundamentalCycle_exists

end
