set_option autoImplicit false
noncomputable section

/-!
# F59-F9 / v5.159 — actual integral cellular two-to-one boundary operator

F59-F8 constructed a globally consistent orientation of all 32
real C60 faces, and proved their signed integer one-chain boundary
vanishes. Here the statement is upgraded to the NATURAL ALGEBRAIC
DOMAIN AND CODOMAIN of integer free abelian cellular chains.

The cellular two-chain module is the actual free abelian group on
the 12+20 original polygonal face labels, represented by Finsupp.
The cellular one-chain module is the free abelian group on the
90 actual C60 edges, likewise represented by Finsupp.

Define the genuine Z-LINEAR cellular boundary operator d₂ from
C₂ to C₁, by its action on each genuine face generator: precisely
the signed F59-F8 edge-incidence chain. The whole oriented surface
is a concrete, nonzero integer 2-chain with coefficient 1 on each
of the 32 oriented faces.

Prove d₂(surface)=0 and that the kernel of d₂ is nontrivial:
the fundamental finite surface chain is a nonzero kernel witness.

NO claim is made that the kernel is generated by this chain,
nor a full H₂ homology computation, nontriviality modulo the
image of an unbuilt 3-cell boundary d₃, or an external Gray
3-functor realizing all original F55 source higher comparisons.
-/

/-- Actual C60 cellular integral 2-chains: FREE abelian group
on twelve original pentagon plus twenty hexagon face symbols. -/
abbrev C60IntegralTwoChains :=
  TruncatedIcosahedralSeedFace →₀ ℤ

/-- Actual C60 cellular integral 1-chains: FREE abelian group
on ninety original physical edge symbols. -/
abbrev C60IntegralOneChains :=
  TruncatedIcosahedralEdge →₀ ℤ

/-- Genuine Z-LINEAR cellular boundary d₂: for a single original
face basis vector, this applies its globally coherent oriented
F59-F8 signed boundary 1-chain. -/
def c60IntegralBoundaryTwo :
    C60IntegralTwoChains →ₗ[ℤ] C60IntegralOneChains :=
  Finsupp.linearCombination ℤ c60IntegerFaceBoundaryChain

/-- On EVERY actual face basis element, the cellular boundary is
exactly the previously verified signed physical-edge boundary. -/
theorem c60IntegralBoundaryTwo_singleFace
    (face : TruncatedIcosahedralSeedFace) :
    c60IntegralBoundaryTwo (Finsupp.single face (1 : ℤ)) =
      c60IntegerFaceBoundaryChain face := by
  simp [c60IntegralBoundaryTwo]

/-- The real C60 ORIENTED fundamental 2-chain: a single chosen
globally consistent orientation of each of the 32 genuine faces,
with coefficient exactly +1 on every chosen oriented face. -/
def c60IntegralFundamentalSurfaceChain : C60IntegralTwoChains :=
  ∑ face : TruncatedIcosahedralSeedFace,
    Finsupp.single face (1 : ℤ)

/-- Every original face has coefficient +1 in the chosen
integral surface 2-chain, not merely odd coefficient modulo two. -/
theorem c60IntegralFundamentalSurfaceChain_coeff
    (face : TruncatedIcosahedralSeedFace) :
    c60IntegralFundamentalSurfaceChain face = (1 : ℤ) := by
  classical
  simp [c60IntegralFundamentalSurfaceChain]

/-- This original C60 integral 2-chain is GENUINELY NONZERO,
even though its signed one-dimensional boundary vanishes. -/
theorem c60IntegralFundamentalSurfaceChain_ne_zero :
    c60IntegralFundamentalSurfaceChain ≠ 0 := by
  intro h
  have hh := congrArg
    (fun c : C60IntegralTwoChains => c (.aroundVertex .north)) h
  have hz : (1 : ℤ) = 0 := by
    simpa only [c60IntegralFundamentalSurfaceChain_coeff,
      Finsupp.zero_apply] using hh
  exact one_ne_zero hz

/-- The signed boundary of the genuine nonzero oriented
fundamental 2-chain is ZERO under the actual Z-linear cellular
boundary operator, not just under coordinatewise parity. -/
theorem c60IntegralBoundaryTwo_fundamental_zero :
    c60IntegralBoundaryTwo c60IntegralFundamentalSurfaceChain = 0 := by
  unfold c60IntegralFundamentalSurfaceChain
  rw [map_sum]
  simp only [c60IntegralBoundaryTwo_singleFace]
  exact c60IntegerFullSurfaceBoundaryChain_zero

/-- The real closed oriented C60 surface is a concrete MEMBER
OF THE KERNEL of the formal Z-linear d₂ boundary operator. -/
theorem c60IntegralFundamentalSurfaceChain_mem_kernel :
    c60IntegralFundamentalSurfaceChain ∈
      c60IntegralBoundaryTwo.ker := by
  change c60IntegralBoundaryTwo c60IntegralFundamentalSurfaceChain = 0
  exact c60IntegralBoundaryTwo_fundamental_zero

/-- The degree-two C60 cellular boundary map has a genuinely
NONTRIVIAL KERNEL, not merely a zero image of the zero 2-chain.
No unproved H₂ rank or generator count is asserted. -/
theorem c60IntegralBoundaryTwo_kernel_ne_bot :
    c60IntegralBoundaryTwo.ker ≠ ⊥ := by
  intro h
  have hm := c60IntegralFundamentalSurfaceChain_mem_kernel
  rw [h] at hm
  exact c60IntegralFundamentalSurfaceChain_ne_zero
    (Submodule.mem_bot.mp hm)

/-- Complete algebraic characterization CERTIFIED in F59-F8/F9:
a nonzero all-32-face integer 2-chain exists with truly vanishing
signed boundary in the integer 90-edge free abelian group. -/
theorem c60IntegralFundamentalCycle_exists :
    ∃ c : C60IntegralTwoChains,
      c ≠ 0 ∧ c60IntegralBoundaryTwo c = 0 :=
  ⟨c60IntegralFundamentalSurfaceChain,
    c60IntegralFundamentalSurfaceChain_ne_zero,
    c60IntegralBoundaryTwo_fundamental_zero⟩

#print axioms c60IntegralBoundaryTwo
