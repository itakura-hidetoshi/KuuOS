namespace KUOS.Architecture.WuxingPentagonUnified
open KUOS.Architecture.WuxingCyclicPaths
open Kuu.F112.Physical
open CategoryTheory
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
noncomputable section

/- The REAL original north-C60 first two independent F45
stages; two depth coordinates and both Category Site raw
Blocks and AxisTrace histories are not replaced or quotient. -/
private def fivefoldGK5AKNorthFirstUnit :=
  nativeF54P92UnitRoute northNativeF45FirstStage

private def fivefoldGK5AKNorthSecondUnit :=
  nativeF54P92UnitRoute northNativeF45SecondStage

private def fivefoldGK5AKNorthFirstIdent :
    KuuNativeF45Tree.DepthRotationRoute.PresentedCell
      (.pentagon .north)
      fivefoldGK5AKNorthFirstUnit fivefoldGK5AKNorthFirstUnit :=
  .ident fivefoldGK5AKNorthFirstUnit

private def fivefoldGK5AKNorthSecondIdent :
    KuuNativeF45Tree.DepthRotationRoute.PresentedCell
      (.pentagon .north)
      fivefoldGK5AKNorthSecondUnit fivefoldGK5AKNorthSecondUnit :=
  .ident fivefoldGK5AKNorthSecondUnit

/- The two TRUE original F55 three-proofs that P89's
interchange compares, using the native F54 derived horizontal
pasting and no invented generator. -/
private def fivefoldGK5AKNorthInterchangeBefore :=
  (KuuNativeF45Tree.DepthRotationRoute.PresentedCell.trans
    fivefoldGK5AKNorthFirstIdent fivefoldGK5AKNorthFirstIdent).horizontal
    (KuuNativeF45Tree.DepthRotationRoute.PresentedCell.trans
      fivefoldGK5AKNorthSecondIdent fivefoldGK5AKNorthSecondIdent)

private def fivefoldGK5AKNorthInterchangeAfter :=
  KuuNativeF45Tree.DepthRotationRoute.PresentedCell.trans
    (fivefoldGK5AKNorthFirstIdent.horizontal
      fivefoldGK5AKNorthSecondIdent)
    (fivefoldGK5AKNorthFirstIdent.horizontal
      fivefoldGK5AKNorthSecondIdent)

/-- The ACTUAL source P89 Type-valued horizontal INTERCHANGE
4-cell for the native independent north C60 first two sectors. -/
def fivefoldGK5AKNorthOriginalInterchange :
    NativeF55P89InterchangeFourCell
      fivefoldGK5AKNorthInterchangeBefore
      fivefoldGK5AKNorthInterchangeAfter :=
  .interchange
    fivefoldGK5AKNorthFirstIdent fivefoldGK5AKNorthFirstIdent
    fivefoldGK5AKNorthSecondIdent fivefoldGK5AKNorthSecondIdent

/-- Its unconditional, correctly TYPED selected P93 Type-valued
4-cell image via independent GK5AK's structural interchange
construction. No P87 compatibility is needed for this generator. -/
def fivefoldGK5AKNorthSelectedInterchange :
    NativeF55P93AssocFourCell
      (nativeGK5AIOriginalToP92Structural
        fivefoldGK5AKNorthInterchangeBefore)
      (nativeGK5AIOriginalToP92Structural
        fivefoldGK5AKNorthInterchangeAfter) :=
  nativeGK5AKInterchangeStructural (.pentagon .north)
    fivefoldGK5AKNorthFirstIdent fivefoldGK5AKNorthFirstIdent
    fivefoldGK5AKNorthSecondIdent fivefoldGK5AKNorthSecondIdent

private def fivefoldGK5AKNorthTwoStages :=
  KuuNativeF45Tree.node
    northNativeF45FirstStage northNativeF45SecondStage

/-- True selected P93 four-CELL QUOTIENT equality follows from the
actual proof-relevant interchange witness; this never asserts
equality of the two original free F55 three-proof trees. -/
theorem fivefoldGK5AKNorthSelectedInterchange_class_eq :
    nativeF55P93AssocFourClass
      fivefoldGK5AKNorthTwoStages fivefoldGK5AKNorthTwoStages
      (nativeGK5AIOriginalToP92Structural
        fivefoldGK5AKNorthInterchangeBefore) =
    nativeF55P93AssocFourClass
      fivefoldGK5AKNorthTwoStages fivefoldGK5AKNorthTwoStages
      (nativeGK5AIOriginalToP92Structural
        fivefoldGK5AKNorthInterchangeAfter) :=
  _root_.Quotient.sound ⟨fivefoldGK5AKNorthSelectedInterchange⟩

/-- REAL north C60 dual axis source Site, shared by two fully
distinct typed original F45 Blocks histories. -/
private abbrev fivefoldGK5AKNorthOrigin :=
  Site.vertex (cyclicBoundaryDart (.pentagon .north)
    (firstFourPolygonSector (.pentagon .north) 0).1.val)

private abbrev fivefoldGK5AKNorthTarget :=
  Site.face (.pentagon .north)

/-- Explicit remaining P87 structural four-cell compatibility
at the actual north C60 two-Category Site source. This data is
NOT declared inhabited. -/
abbrev FivefoldGK5AKNorthP87Boundary :=
  NativeGK5AKP87StructuralBoundary
    (a := fivefoldGK5AKNorthOrigin)
    (b := fivefoldGK5AKNorthTarget)
    (x := fivefoldGK5AKNorthOrigin)
    (y := fivefoldGK5AKNorthTarget)
    (.pentagon .north)

private def fivefoldGK5AKNorthFirst :=
  KuuNativeF45Tree.pentagon0 northNativeF45FirstStage
    northNativeF45SecondStage northNativeF45ThirdStage
    northNativeF45FourthStage

private def fivefoldGK5AKNorthLast :=
  KuuNativeF45Tree.pentagon3 northNativeF45FirstStage
    northNativeF45SecondStage northNativeF45ThirdStage
    northNativeF45FourthStage

/-- Original P89 four-cell classes over the ACTUAL north-C60
full four-sector 3-rotation/2-rotation source F54 boundaries. -/
abbrev FivefoldGK5AKNorthP89FourClasses :=
  NativeF55P89FourClasses fivefoldGK5AKNorthFirst
    fivefoldGK5AKNorthLast
    northNativeF45PentagonLong northNativeF45PentagonShort

abbrev FivefoldGK5AKNorthP93FourClasses :=
  NativeF55P93AssocFourClasses fivefoldGK5AKNorthFirst
    fivefoldGK5AKNorthLast
    northNativeF45PentagonLong northNativeF45PentagonShort

/-- The true physical C60 fifth around Edge/Dart endpoints
paired with the EXACT source P89→P93 structural 4-cell class
map, conditional only on the explicitly required P87 interface. -/
def fivefoldGK5AKNorthPhysicalFourClassMap
    (frame : NativeC60FivePhaseGauge) (i : FivefoldIndex)
    (base : FivefoldGK5AKNorthP87Boundary) :
    FivefoldGK5AKNorthP89FourClasses →
      (Dart × Dart) × FivefoldGK5AKNorthP93FourClasses :=
  fun q => (fivefoldGK5AGNorthPhysicalFifthDarts frame i,
    nativeGK5AKFourClassMap
      fivefoldGK5AKNorthFirst fivefoldGK5AKNorthLast
      northNativeF45PentagonLong northNativeF45PentagonShort
      base q)

/-- Exact conditional source-comparison REFLECTION gate after
adjoining the genuine physical C60 Dart pair. The physical
boundary adds no unproved authority to recover old P89 4-cells
from separately selected P93 4-cells. -/
theorem fivefoldGK5AKNorthPhysicalFourClass_injective_iff_reflect
    (frame : NativeC60FivePhaseGauge) (i : FivefoldIndex)
    (base : FivefoldGK5AKNorthP87Boundary) :
    Function.Injective
      (fivefoldGK5AKNorthPhysicalFourClassMap frame i base) ↔
    (∀ f g : NativeGK5AINorthPentagonCells,
      Nonempty (NativeF55P93AssocFourCell
        (nativeGK5AIOriginalToP92Structural f)
        (nativeGK5AIOriginalToP92Structural g)) →
      Nonempty (NativeF55P89InterchangeFourCell f g)) := by
  have hp :
      Function.Injective
        (fivefoldGK5AKNorthPhysicalFourClassMap frame i base) ↔
      Function.Injective
        (nativeGK5AKFourClassMap
          fivefoldGK5AKNorthFirst fivefoldGK5AKNorthLast
          northNativeF45PentagonLong northNativeF45PentagonShort base) := by
    constructor
    · intro hinj x y hxy
      apply hinj
      apply Prod.ext
      · rfl
      · exact hxy
    · intro hinj x y hxy
      exact hinj (congrArg Prod.snd hxy)
  exact hp.trans (nativeGK5AKFourClassInjective_iff_reflect
    fivefoldGK5AKNorthFirst fivefoldGK5AKNorthLast
    northNativeF45PentagonLong northNativeF45PentagonShort base)

/-- The whole signed pentagon/square/odd exchange shadow is
unchanged when we add genuine physical fifth-around Edge Darts
to the conditional original P89→P93 quotient comparison. -/
theorem fivefoldGK5AKNorthPhysicalFourShadow_commutes
    (frame : NativeC60FivePhaseGauge) (i : FivefoldIndex)
    (base : FivefoldGK5AKNorthP87Boundary)
    (q : FivefoldGK5AKNorthP89FourClasses) :
    nativeF55P93AssocFourToShadow
      fivefoldGK5AKNorthFirst fivefoldGK5AKNorthLast
      northNativeF45PentagonLong northNativeF45PentagonShort
      (fivefoldGK5AKNorthPhysicalFourClassMap frame i base q).2 =
    nativeF55P89FourToShadow
      fivefoldGK5AKNorthFirst fivefoldGK5AKNorthLast
      northNativeF45PentagonLong northNativeF45PentagonShort q :=
  nativeGK5AKFourClassShadow_commutes
    fivefoldGK5AKNorthFirst fivefoldGK5AKNorthLast
    northNativeF45PentagonLong northNativeF45PentagonShort base q

/-- Real north C60 fifth Edge/Dart closure and both physically
REVERSED categorical 04/43 directions coexist with genuine
original P89 and selected P93 interchange four-cell witnesses
on the actual north F45 first/second independent stages. -/
theorem fivefoldGK5AKNorthPhysicalInterchangeAndOrientation
    (frame : NativeC60FivePhaseGauge) (i : FivefoldIndex) :
    (fivefoldGK5AGNorthPhysicalFifthDarts frame i =
      (nativeC60GaugeDart frame .north (i + 4),
       nativeC60GaugeDart frame .north i)) ∧
    Nonempty (NativeF55P89InterchangeFourCell
      fivefoldGK5AKNorthInterchangeBefore
      fivefoldGK5AKNorthInterchangeAfter) ∧
    Nonempty (NativeF55P93AssocFourCell
      (nativeGK5AIOriginalToP92Structural
        fivefoldGK5AKNorthInterchangeBefore)
      (nativeGK5AIOriginalToP92Structural
        fivefoldGK5AKNorthInterchangeAfter)) ∧
    (¬ edgeEndpoints (fivefoldPhysicalEdge frame .north .e04) =
      (nativeC60GaugeDart frame .north (fivefoldFrom .e04),
       nativeC60GaugeDart frame .north (fivefoldTo .e04))) ∧
    (¬ edgeEndpoints (fivefoldPhysicalEdge frame .north .e43) =
      (nativeC60GaugeDart frame .north (fivefoldFrom .e43),
       nativeC60GaugeDart frame .north (fivefoldTo .e43))) := by
  exact ⟨fivefoldPhaseLastPhysicalSide_closed_kernel frame .north i,
    ⟨fivefoldGK5AKNorthOriginalInterchange⟩,
    ⟨fivefoldGK5AKNorthSelectedInterchange⟩,
    (fivefoldGK5AFBothReverseObstructions frame .north).1,
    (fivefoldGK5AFBothReverseObstructions frame .north).2⟩

#print axioms fivefoldGK5AKNorthOriginalInterchange
#print axioms fivefoldGK5AKNorthSelectedInterchange
#print axioms fivefoldGK5AKNorthSelectedInterchange_class_eq
#print axioms fivefoldGK5AKNorthPhysicalFourClassMap
#print axioms fivefoldGK5AKNorthPhysicalFourClass_injective_iff_reflect
#print axioms fivefoldGK5AKNorthPhysicalFourShadow_commutes
#print axioms fivefoldGK5AKNorthPhysicalInterchangeAndOrientation

end
