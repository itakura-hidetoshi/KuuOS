/-- Bottom leg from the coproduct of standard-A simplex targets into `A_j`. -/
def standardTypeABoundaryPrismRankASimplexSigmaToAPhase
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ) :
    standardTypeABoundaryPrismRankASimplexSigma g j ⟶
      standardTypeABoundaryPrismRankAPhase g j :=
  generatedPushoutInr
    (standardTypeABoundaryPrismRankStageScaling g j)
    (standardTypeABoundaryPrismRankASimplexSigmaScaling g j)
    (standardTypeABoundaryPrismRankStageHom g (Nat.le_succ j)).map
