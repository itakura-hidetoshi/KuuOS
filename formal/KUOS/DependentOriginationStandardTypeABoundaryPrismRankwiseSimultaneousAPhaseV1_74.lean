/-!
# Simultaneous type-(A) rank phase for the boundary prism v1.74

Version v1.73 proved that the ordinary Mathlib rank square is already an exact
pushout in `ScaledSSet` when the coproduct of attached simplices carries its
*exact ambient* scaling.  That square is not yet one raw standard cellular
step: an exceptional exact cell is locally `A ; B`, so its exact simplex
scaling is stronger than the standard type-(A) target scaling.

The correct global factorization is therefore

```text
R_j  -- simultaneous standard A attachments -->  A_j
     -- simultaneous exceptional B completions --> R_(j+1).
```

This file constructs the first arrow without serializing cells.

For every rank cell `c`, take the literal standard type-(A) horn generator at
`c.index`.  On Mathlib's existing coproduct carriers `sigmaHorn j` and
`sigmaStdSimplex j`, put the least scalings generated by the images of those
standard A source and target scalings.  We prove directly that these are
categorical coproducts in `ScaledSSet`; consequently Mathlib's ordinary
coproduct horn map `m j` is literally a coproduct of standard A generators.

We then push that one coproduct map along the ordinary attaching map `t j`.
The underlying ordinary pushout is exactly the existing rank square, so the
intermediate A-phase carrier is already the ordinary successor filtration.
Only its scaling is weaker: it is generated by the current rank stage and all
standard-A target images.  The generic generated-pushout theorem of v1.73
upgrades the square to a genuine scaled pushout.

The main output is

```text
R_j -> A_j ∈ pushouts (coproducts E_std),
```

i.e. one raw standard A/B/C cellular step, using only type-(A) generators.
Finally we prove `A_j -> R_(j+1)` is the identity on the underlying simplicial
set and is scaled.  This is the exact interface needed for the simultaneous
exceptional-B phase in the next unit.
-/

/-! ## Rankwise coproduct scalings generated by literal standard A cells -/

/-- Least scaling on Mathlib's coproduct of rank-`j` horns generated by the
literal standard type-(A) horn scaling of every cell. -/
def standardTypeABoundaryPrismRankAHornSigmaScaling
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ) :
    ScaledSimplicialSet
      ((standardTypeABoundaryPrismRankFunction g).sigmaHorn j) where
  thin := fun t =>
    (minimalScaling
      ((standardTypeABoundaryPrismRankFunction g).sigmaHorn j)).thin t ∨
      ∃ (c : (standardTypeABoundaryPrismRankFunction g).Cell j)
        (x : (c.horn : SSet.{u}).obj (op ⦋2⦌)),
        (standardTypeAHornScaling c.index).thin x ∧
          c.ιSigmaHorn.app (op ⦋2⦌) x = t
  thin_sigma_zero := by
    intro x
    exact Or.inl
      ((minimalScaling
        ((standardTypeABoundaryPrismRankFunction g).sigmaHorn j)).thin_sigma_zero x)
  thin_sigma_one := by
    intro x
    exact Or.inl
      ((minimalScaling
        ((standardTypeABoundaryPrismRankFunction g).sigmaHorn j)).thin_sigma_one x)

/-- Least scaling on Mathlib's coproduct of rank-`j` simplices generated by the
literal standard type-(A) simplex scaling of every cell. -/
def standardTypeABoundaryPrismRankASimplexSigmaScaling
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ) :
    ScaledSimplicialSet
      ((standardTypeABoundaryPrismRankFunction g).sigmaStdSimplex j) where
  thin := fun t =>
    (minimalScaling
      ((standardTypeABoundaryPrismRankFunction g).sigmaStdSimplex j)).thin t ∨
      ∃ (c : (standardTypeABoundaryPrismRankFunction g).Cell j)
        (x : (Δ[c.dim + 1] : SSet.{u}).obj (op ⦋2⦌)),
        (standardTypeASimplexScaling c.index).thin x ∧
          c.ιSigmaStdSimplex.app (op ⦋2⦌) x = t
  thin_sigma_zero := by
    intro x
    exact Or.inl
      ((minimalScaling
        ((standardTypeABoundaryPrismRankFunction g).sigmaStdSimplex j)).thin_sigma_zero x)
  thin_sigma_one := by
    intro x
    exact Or.inl
      ((minimalScaling
        ((standardTypeABoundaryPrismRankFunction g).sigmaStdSimplex j)).thin_sigma_one x)

/-- Rankwise standard-A coproduct horn object on the exact ordinary Mathlib
carrier. -/
def standardTypeABoundaryPrismRankAHornSigma
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ) : ScaledSSet.{u} :=
  ScaledSSet.of
    ((standardTypeABoundaryPrismRankFunction g).sigmaHorn j)
    (standardTypeABoundaryPrismRankAHornSigmaScaling g j)

/-- Rankwise standard-A coproduct simplex object on the exact ordinary Mathlib
carrier. -/
def standardTypeABoundaryPrismRankASimplexSigma
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ) : ScaledSSet.{u} :=
  ScaledSSet.of
    ((standardTypeABoundaryPrismRankFunction g).sigmaStdSimplex j)
    (standardTypeABoundaryPrismRankASimplexSigmaScaling g j)

/-- The literal standard-A horn object associated to one rank cell. -/
abbrev standardTypeABoundaryPrismRankAHornCell
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ)
    (c : (standardTypeABoundaryPrismRankFunction g).Cell j) : ScaledSSet.{u} :=
  standardTypeAScaledHorn
    (standardTypeABoundaryPrismCellHornIndex g j c)

/-- The literal standard-A simplex object associated to one rank cell. -/
abbrev standardTypeABoundaryPrismRankASimplexCell
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ)
    (c : (standardTypeABoundaryPrismRankFunction g).Cell j) : ScaledSSet.{u} :=
  standardTypeAScaledSimplex
    (standardTypeABoundaryPrismCellHornIndex g j c)

/-- Inclusion of one literal standard-A horn into the rankwise A-source
coproduct. -/
def standardTypeABoundaryPrismRankAHornSigmaInclusion
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ)
    (c : (standardTypeABoundaryPrismRankFunction g).Cell j) :
    standardTypeABoundaryPrismRankAHornCell g j c ⟶
      standardTypeABoundaryPrismRankAHornSigma g j where
  map := c.ιSigmaHorn
  scaled := by
    intro t ht
    exact Or.inr ⟨c, t, ht, rfl⟩

/-- Inclusion of one literal standard-A simplex into the rankwise A-target
coproduct. -/
def standardTypeABoundaryPrismRankASimplexSigmaInclusion
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ)
    (c : (standardTypeABoundaryPrismRankFunction g).Cell j) :
    standardTypeABoundaryPrismRankASimplexCell g j c ⟶
      standardTypeABoundaryPrismRankASimplexSigma g j where
  map := c.ιSigmaStdSimplex
  scaled := by
    intro t ht
    exact Or.inr ⟨c, t, ht, rfl⟩

/-! ## These exact ordinary carriers are categorical coproducts in ScaledSSet -/

/-- Cofan of all literal standard-A horn sources. -/
noncomputable def standardTypeABoundaryPrismRankAHornCofan
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ) :
    Cofan
      (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
        standardTypeABoundaryPrismRankAHornCell g j c) :=
  Cofan.mk (standardTypeABoundaryPrismRankAHornSigma g j)
    (fun c => standardTypeABoundaryPrismRankAHornSigmaInclusion g j c)

/-- The preceding horn cofan is colimiting in `ScaledSSet`. -/
noncomputable def standardTypeABoundaryPrismRankAHornCofanIsColimit
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ) :
    IsColimit (standardTypeABoundaryPrismRankAHornCofan g j) where
  desc s :=
    { map := Sigma.desc
        (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
          (s.ι.app ⟨c⟩).map)
      scaled := by
        intro t ht
        rcases ht with hmin | ⟨c, x, hx, rfl⟩
        · exact
            (minimalScaling_map s.pt.scaling
              (Sigma.desc
                (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
                  (s.ι.app ⟨c⟩).map))) t hmin
        · have hs := (s.ι.app ⟨c⟩).scaled x hx
          change
            s.pt.scaling.thin
              (((c.ιSigmaHorn ≫
                Sigma.desc
                  (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
                    (s.ι.app ⟨c⟩).map)).app (op ⦋2⦌)) x)
          have hdesc :
              c.ιSigmaHorn ≫
                  Sigma.desc
                    (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
                      (s.ι.app ⟨c⟩).map) =
                (s.ι.app ⟨c⟩).map := by
            exact Sigma.ι_desc _ c
          rw [hdesc]
          exact hs }
  fac s c := by
    rcases c with ⟨c⟩
    apply ScaledSSet.ScaledMap.ext
    change
      c.ιSigmaHorn ≫
          Sigma.desc
            (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
              (s.ι.app ⟨c⟩).map) =
        (s.ι.app ⟨c⟩).map
    exact Sigma.ι_desc _ c
  uniq s m hm := by
    apply ScaledSSet.ScaledMap.ext
    apply Sigma.hom_ext
    intro c
    have hc := congrArg ScaledSSet.ScaledMap.map (hm ⟨c⟩)
    change
      c.ιSigmaHorn ≫ m.map =
        c.ιSigmaHorn ≫
          Sigma.desc
            (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
              (s.ι.app ⟨c⟩).map)
    rw [hc]
    exact (Sigma.ι_desc _ c).symm

/-- Cofan of all literal standard-A simplex targets. -/
noncomputable def standardTypeABoundaryPrismRankASimplexCofan
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ) :
    Cofan
      (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
        standardTypeABoundaryPrismRankASimplexCell g j c) :=
  Cofan.mk (standardTypeABoundaryPrismRankASimplexSigma g j)
    (fun c => standardTypeABoundaryPrismRankASimplexSigmaInclusion g j c)

/-- The preceding simplex cofan is colimiting in `ScaledSSet`. -/
noncomputable def standardTypeABoundaryPrismRankASimplexCofanIsColimit
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ) :
    IsColimit (standardTypeABoundaryPrismRankASimplexCofan g j) where
  desc s :=
    { map := Sigma.desc
        (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
          (s.ι.app ⟨c⟩).map)
      scaled := by
        intro t ht
        rcases ht with hmin | ⟨c, x, hx, rfl⟩
        · exact
            (minimalScaling_map s.pt.scaling
              (Sigma.desc
                (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
                  (s.ι.app ⟨c⟩).map))) t hmin
        · have hs := (s.ι.app ⟨c⟩).scaled x hx
          change
            s.pt.scaling.thin
              (((c.ιSigmaStdSimplex ≫
                Sigma.desc
                  (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
                    (s.ι.app ⟨c⟩).map)).app (op ⦋2⦌)) x)
          have hdesc :
              c.ιSigmaStdSimplex ≫
                  Sigma.desc
                    (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
                      (s.ι.app ⟨c⟩).map) =
                (s.ι.app ⟨c⟩).map := by
            exact Sigma.ι_desc _ c
          rw [hdesc]
          exact hs }
  fac s c := by
    rcases c with ⟨c⟩
    apply ScaledSSet.ScaledMap.ext
    change
      c.ιSigmaStdSimplex ≫
          Sigma.desc
            (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
              (s.ι.app ⟨c⟩).map) =
        (s.ι.app ⟨c⟩).map
    exact Sigma.ι_desc _ c
  uniq s m hm := by
    apply ScaledSSet.ScaledMap.ext
    apply Sigma.hom_ext
    intro c
    have hc := congrArg ScaledSSet.ScaledMap.map (hm ⟨c⟩)
    change
      c.ιSigmaStdSimplex ≫ m.map =
        c.ιSigmaStdSimplex ≫
          Sigma.desc
            (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
              (s.ι.app ⟨c⟩).map)
    rw [hc]
    exact (Sigma.ι_desc _ c).symm

/-! ## The coproduct map is literally the coproduct of standard A generators -/

/-- Mathlib's ordinary coproduct horn map, now between the literal standard-A
coproduct scalings. -/
def standardTypeABoundaryPrismRankASigmaCellHom
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ) :
    standardTypeABoundaryPrismRankAHornSigma g j ⟶
      standardTypeABoundaryPrismRankASimplexSigma g j where
  map := (standardTypeABoundaryPrismRankFunction g).m j
  scaled := by
    intro t ht
    rcases ht with hmin | ⟨c, x, hx, rfl⟩
    · exact
        (minimalScaling_map
          (standardTypeABoundaryPrismRankASimplexSigmaScaling g j)
          ((standardTypeABoundaryPrismRankFunction g).m j)) t hmin
    · right
      refine ⟨c, c.horn.ι.app (op ⦋2⦌) x, ?_, ?_⟩
      · exact standardTypeAHornInclusion_scaled c.index x hx
      · have h := ConcreteCategory.congr_hom
          (congr_app c.ι_m (op ⦋2⦌)) x
        exact h.symm

/-- Naturality package of the rankwise family of literal standard-A
generators. -/
noncomputable def standardTypeABoundaryPrismRankAGeneratorNatTrans
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ) :
    Discrete.functor
        (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
          standardTypeABoundaryPrismRankAHornCell g j c) ⟶
      Discrete.functor
        (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
          standardTypeABoundaryPrismRankASimplexCell g j c) :=
  Discrete.natTrans
    (fun ⟨c⟩ =>
      standardTypeAScaledHornGeneratorHom
        (standardTypeABoundaryPrismCellHornIndex g j c))

/-- The exact rankwise A coproduct map belongs to `coproducts E_std`. -/
theorem standardTypeABoundaryPrismRankASigmaCellHom_mem_coproductsABC
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ) :
    (MorphismProperty.coproducts.{u}
      (standardScaledAnodyneGeneratorsABC :
        MorphismProperty (ScaledSSet.{u})))
      (standardTypeABoundaryPrismRankASigmaCellHom g j) := by
  rw [MorphismProperty.coproducts_iff]
  refine ⟨(standardTypeABoundaryPrismRankFunction g).Cell j, ?_⟩
  refine MorphismProperty.colimitsOfShape.mk'
    (W := (standardScaledAnodyneGeneratorsABC :
      MorphismProperty (ScaledSSet.{u})))
    (Discrete.functor
      (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
        standardTypeABoundaryPrismRankAHornCell g j c))
    (Discrete.functor
      (fun c : (standardTypeABoundaryPrismRankFunction g).Cell j =>
        standardTypeABoundaryPrismRankASimplexCell g j c))
    (standardTypeABoundaryPrismRankAHornCofan g j)
    (standardTypeABoundaryPrismRankASimplexCofan g j)
    (standardTypeABoundaryPrismRankAHornCofanIsColimit g j)
    (standardTypeABoundaryPrismRankASimplexCofanIsColimit g j)
    (standardTypeABoundaryPrismRankAGeneratorNatTrans g j) ?_
    (standardTypeABoundaryPrismRankASigmaCellHom g j) ?_
  · intro c
    rcases c with ⟨c⟩
    exact standardTypeAGenerator_mem_ABC
      (standardTypeABoundaryPrismCellHornIndex g j c)
  · intro c
    rcases c with ⟨c⟩
    apply ScaledSSet.ScaledMap.ext
    exact c.ι_m

/-! ## Attach the simultaneous A coproduct to the current rank stage -/

/-- The rankwise standard-A coproduct horn maps to the current exact rank
stage.  Standard A horn thinness enters the exact horn scaling by v1.66. -/
def standardTypeABoundaryPrismRankAHornSigmaToStage
    (g : StandardTypeAHornAttachmentGeneratorIndex)
    (j : ℕ) :
    standardTypeABoundaryPrismRankAHornSigma g j ⟶
      standardTypeABoundaryPrismRankStage g j where
  map := (standardTypeABoundaryPrismRankFunction g).t j
  scaled := by
    intro t ht
    rcases ht with hmin | ⟨c, x, hx, rfl⟩
    · exact
        (minimalScaling_map
          (standardTypeABoundaryPrismRankStageScaling g j)
          ((standardTypeABoundaryPrismRankFunction g).t j)) t hmin
    · have hx' :=
        standardTypeABoundaryPrismCellHorn_ACompatible
          g j c (standardTypeABoundaryPrismCellACompatible_all g j c) x hx
      have hs :=
        (standardTypeABoundaryPrismScaledCellSourceToRankStage g j c).scaled x hx'
      change
        (standardTypeABoundaryPrismRankStageScaling g j).thin
          (((c.ιSigmaHorn ≫
            (standardTypeABoundaryPrismRankFunction g).t j).app
              (op ⦋2⦌)) x)
      rw [c.ι_t]
      exact hs

/-- Scaling on the intermediate A-phase carrier.  Its underlying simplicial
set is already the ordinary successor rank stage. -/
