/-!
# v5.234 / F80: ACTUAL original Gray three-Hom quotient horizontal tensor

The categorical quotient constructed in F77 is not replaced by a
numerical target. Its actual objects are original GrayGrade wrappers
and its Hom types are Mathlib Quotients of native three-arrows by the
composition congruence generated by erasing independent exchange
phase. We build an ACTUAL binary horizontal tensor ON THESE HOM TYPES
using Lean's Quot.liftOn₂ and separately prove independence of BOTH
representatives by the exact F77 kernel theorem.

On this actual quotient we prove the original degree tensor,
associative and unital two-cell operations, a real Mathlib bifunctor
on 3-Homs, full middle-four interchange, and exact compatibility
with the two original integer generator charges. Finally, all
original F42/F43/F51 source arrows remain correctly typed and map
horizontally into this actual quotient, not merely into F75.

No source Gray odd exchange is silently made an identity: it is
nontrivial BEFORE applying the explicit F77 quotient projection.
The north C60 -5 signed integer curvature and independent F47
mixed comparison charge are not killed. The unquotiented global
original F54/F55 category remains a separate gluing obligation.
-/

/-- The genuine quotient 2-cell horizontal product, using the actual
underlying original GrayGrade representatives of QUOTIENT OBJECTS. -/
def c60F80QuotientTwoTensor
    (X Y : C60F77NativeQuotient) : C60F77NativeQuotient :=
  ⟨GrayGrade.tensor X.as Y.as⟩

/-- The unit 2-cell of the genuine F77 categorical quotient. -/
def c60F80QuotientTwoUnit : C60F77NativeQuotient :=
  ⟨GrayGrade.unit⟩

/-- ACTUAL horizontal tensor on Mathlib Quot Hom sets.
The two quotient representative-independence obligations are
proved separately from the F77 exact charge kernel, not assumed. -/
def c60F80QuotientThreeTensor
    {X X' Y Y' : C60F77NativeQuotient}
    (f : X ⟶ X') (g : Y ⟶ Y') :
    c60F80QuotientTwoTensor X Y ⟶
      c60F80QuotientTwoTensor X' Y' :=
  Quot.liftOn₂ f g
    (fun u v => c60F77Projection.map (GradedThreeCell.tensor u v))
    (by
      intro u v₁ v₂ h
      have hv : v₁.charge = v₂.charge :=
        (c60F77Projection_exactKernel v₁ v₂).mp (Quot.sound h)
      apply (c60F77Projection_exactKernel _ _).mpr
      change u.charge + v₁.charge = u.charge + v₂.charge
      rw [hv])
    (by
      intro u₁ u₂ v h
      have hu : u₁.charge = u₂.charge :=
        (c60F77Projection_exactKernel u₁ u₂).mp (Quot.sound h)
      apply (c60F77Projection_exactKernel _ _).mpr
      change u₁.charge + v.charge = u₂.charge + v.charge
      rw [hu])

/-- Actual native representatives produce the exact original
F59 horizontal tensor before applying the categorical quotient. -/
@[simp] theorem c60F80QuotientThreeTensor_representatives
    {X X' Y Y' : GrayGrade}
    (f : X ⟶ X') (g : Y ⟶ Y') :
    c60F80QuotientThreeTensor
      (c60F77Projection.map f) (c60F77Projection.map g) =
        c60F77Projection.map (GradedThreeCell.tensor f g) := rfl

/-- Equality of both native Int × Int charges is sufficient for
equality of ACTUAL quotient morphisms, by F79's Faithfulness. -/
theorem c60F80QuotientThree_ext
    {X Y : C60F77NativeQuotient} {f g : X ⟶ Y}
    (h :
      (c60F77QuotientToStrictCharge.map f).charge =
        (c60F77QuotientToStrictCharge.map g).charge) : f = g := by
  apply c60F77QuotientToStrictCharge.map_injective
  exact C60F75StrictChargeThree.ext h

/-- The genuine quotient tensor preserves precisely the sum of both
independent integer charges, ON ARBITRARY Quot Hom elements. -/
theorem c60F80QuotientThreeTensor_charge
    {X X' Y Y' : C60F77NativeQuotient}
    (f : X ⟶ X') (g : Y ⟶ Y') :
    (c60F77QuotientToStrictCharge.map
      (c60F80QuotientThreeTensor f g)).charge =
      (c60F77QuotientToStrictCharge.map f).charge +
        (c60F77QuotientToStrictCharge.map g).charge := by
  refine Quot.inductionOn f (fun u => ?_)
  refine Quot.inductionOn g (fun v => ?_)
  rfl

/-- Categorical quotient composition evaluates to the sum of the
original two integer charges, independently of the erased phase. -/
@[simp] theorem c60F80QuotientThree_comp_charge
    {X Y Z : C60F77NativeQuotient}
    (f : X ⟶ Y) (g : Y ⟶ Z) :
    (c60F77QuotientToStrictCharge.map (f ≫ g)).charge =
      (c60F77QuotientToStrictCharge.map f).charge +
        (c60F77QuotientToStrictCharge.map g).charge := by
  rw [Functor.map_comp]
  rfl

/-- Identity of an original quotient Hom retains precisely
zero charge, without an assumed collapse of every generator. -/
@[simp] theorem c60F80QuotientThree_id_charge
    (X : C60F77NativeQuotient) :
    (c60F77QuotientToStrictCharge.map (𝟙 X)).charge =
      (0 : Int × Int) := by
  rw [Functor.map_id]
  rfl

/-- Our REAL quotient horizontal tensor strictly preserves
the categorical 3-arrow identities on all genuine quotient objects. -/
theorem c60F80QuotientThreeTensor_id
    (X Y : C60F77NativeQuotient) :
    c60F80QuotientThreeTensor (𝟙 X) (𝟙 Y) =
      𝟙 (c60F80QuotientTwoTensor X Y) := by
  apply c60F80QuotientThree_ext
  rw [c60F80QuotientThreeTensor_charge]
  simp only [c60F80QuotientThree_id_charge]
  exact zero_add _

/-- ACTUAL middle-four interchange of all quotient 3-arrows,
not only charge-level interchange and not an equality of
original unquotiented source Gray phases. -/
theorem c60F80QuotientThreeTensor_middleFour
    {X X' X'' Y Y' Y'' : C60F77NativeQuotient}
    (f : X ⟶ X') (g : X' ⟶ X'')
    (h : Y ⟶ Y') (k : Y' ⟶ Y'') :
    c60F80QuotientThreeTensor (f ≫ g) (h ≫ k) =
      c60F80QuotientThreeTensor f h ≫
        c60F80QuotientThreeTensor g k := by
  apply c60F80QuotientThree_ext
  simp only [c60F80QuotientThreeTensor_charge,
    c60F80QuotientThree_comp_charge]
  abel

/-- The horizontal tensor ON ACTUAL F77 QUOTIENT HOM sets is a
genuine Mathlib FUNCTOR, including map_id and map_comp fields. -/
def c60F80QuotientHorizontalThreeFunctor :
    (C60F77NativeQuotient × C60F77NativeQuotient) ⥤
      C60F77NativeQuotient where
  obj Z := c60F80QuotientTwoTensor Z.1 Z.2
  map := fun {_ _} f => c60F80QuotientThreeTensor f.1 f.2
  map_id := by
    intro X
    exact c60F80QuotientThreeTensor_id X.1 X.2
  map_comp := by
    intro X Y Z f g
    exact c60F80QuotientThreeTensor_middleFour f.1 g.1 f.2 g.2

/-- Compatibility with the canonical equivalence F79 is a
literal equality of TYPED F75 3-arrows, not an equality
of their first charge coordinates only. -/
theorem c60F80QuotientTensor_chargeFunctor
    {X X' Y Y' : C60F77NativeQuotient}
    (f : X ⟶ X') (g : Y ⟶ Y') :
    c60F77QuotientToStrictCharge.map
        (c60F80QuotientThreeTensor f g) =
      c60F76StrictChargeThreeTensor
        (c60F77QuotientToStrictCharge.map f)
        (c60F77QuotientToStrictCharge.map g) := by
  apply C60F75StrictChargeThree.ext
  exact c60F80QuotientThreeTensor_charge f g

/-! Strict object-level associativity, units, and two-cell exchange -/

theorem c60F80QuotientTwoTensor_assoc
    (X Y Z : C60F77NativeQuotient) :
    c60F80QuotientTwoTensor (c60F80QuotientTwoTensor X Y) Z =
      c60F80QuotientTwoTensor X (c60F80QuotientTwoTensor Y Z) := by
  rcases X with ⟨⟨x⟩⟩
  rcases Y with ⟨⟨y⟩⟩
  rcases Z with ⟨⟨z⟩⟩
  change (⟨⟨(x + y) + z⟩⟩ : C60F77NativeQuotient) =
    ⟨⟨x + (y + z)⟩⟩
  rw [add_assoc]

theorem c60F80QuotientTwoTensor_leftUnit
    (X : C60F77NativeQuotient) :
    c60F80QuotientTwoTensor c60F80QuotientTwoUnit X = X := by
  rcases X with ⟨⟨x⟩⟩
  change (⟨⟨(0 : ZMod 2) + x⟩⟩ : C60F77NativeQuotient) =
    ⟨⟨x⟩⟩
  rw [zero_add]

theorem c60F80QuotientTwoTensor_rightUnit
    (X : C60F77NativeQuotient) :
    c60F80QuotientTwoTensor X c60F80QuotientTwoUnit = X := by
  rcases X with ⟨⟨x⟩⟩
  change (⟨⟨x + (0 : ZMod 2)⟩⟩ : C60F77NativeQuotient) =
    ⟨⟨x⟩⟩
  rw [add_zero]

/-- The type-level exchange law for two horizontal and vertical
quotient 2-cell tensor arrangements, with no additional phase. -/
theorem c60F80QuotientTwoTensor_middleFour
    (X X' Y Y' : C60F77NativeQuotient) :
    c60F80QuotientTwoTensor
      (c60F80QuotientTwoTensor X Y)
      (c60F80QuotientTwoTensor X' Y') =
    c60F80QuotientTwoTensor
      (c60F80QuotientTwoTensor X X')
      (c60F80QuotientTwoTensor Y Y') := by
  rcases X with ⟨⟨x⟩⟩
  rcases X' with ⟨⟨x'⟩⟩
  rcases Y with ⟨⟨y⟩⟩
  rcases Y' with ⟨⟨y'⟩⟩
  change (⟨⟨(x + y) + (x' + y')⟩⟩ : C60F77NativeQuotient) =
    ⟨⟨(x + x') + (y + y')⟩⟩
  congr 1
  abel

/-- Actual original F51 source horizontal 3-arrow composition lands
in the new native quotient tensor on each REAL original C60 path
boundary; its two charges are preserved. -/
theorem c60F80OriginalF51_horizontal_quotient
    {a b c : IcosahedralDart}
    {p q : Quiver.Path a b} {r s : Quiver.Path b c}
    {X X' : C60F51OriginalTwo p q}
    {Y Y' : C60F51OriginalTwo r s}
    (f : X ⟶ X') (g : Y ⟶ Y') :
    (c60F77OriginalSourceQuotient (p.comp r) (q.comp s)).map
        (c60F51HorizontalMap f g) =
      c60F80QuotientThreeTensor
        ((c60F77OriginalSourceQuotient p q).map f)
        ((c60F77OriginalSourceQuotient r s).map g) := by
  apply c60F80QuotientThree_ext
  rw [c60F80QuotientThreeTensor_charge]
  change (c60F51Eval (c60F51HorizontalMap f g)).charge =
    (c60F51Eval f).charge + (c60F51Eval g).charge
  rw [c60F51HorizontalMap_eval]
  exact grayNeutral_add_charge _ _

/-- Original F43 odd/odd interchanger remains nontrivial BEFORE
quotienting but is an identity AFTER the phase quotient. -/
theorem c60F80OriginalNorth_interchange_quotient_id :
