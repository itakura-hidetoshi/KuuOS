/-!
# v5.233 / F79 — actual Mathlib EQUIVALENCE of the phase-killing quotient

F77 built the genuine Mathlib CategoryTheory.Quotient of the original
native GrayGrade three-Hom by the smallest category congruence
generated by killing phase-one at each grade, and proved that the
quotient map to F75 is bijective on EVERY three-Hom and surjective
on ZMod2-grade objects. F78 built the actual original sixty-C60-path
strict globular completion with F75 two- and three-cell interpretation.

Now upgrade those exact Lean results to a genuine, fully bundled
Mathlib equivalence of CATEGORIES, with quasi-inverse, unit and
counit natural isomorphisms and the triangle laws supplied by
Mathlib's verified Equivalence construction.

The result establishes that F75/F78 has precisely the requested
universal categorical semantics, and not just the same integer
charge labels. Separately prove stability of the original charge
congruence under native HORIZONTAL tensor, preparing genuine
tensor descent directly on the quotient (a distinct next step).

The equivalence changes the three-Hom semantics by killing exchange
phase. It is NOT an equivalence with the full original GrayGrade
category; F76 proved the old projection is nonfaithful, and the
original raw F42/F54/F55 global strict 3-category remains unproved.
-/

/-- F77's explicit surjectivity certificate is an ACTUAL Mathlib
Full instance, not merely an unbundled assertion about charge
coordinates. It works for every pair of quotient objects. -/
instance c60F79QuotientChargeFull :
    c60F77QuotientToStrictCharge.Full where
  map_surjective := by
    intro X Y f
    exact c60F77ToStrictCharge_map_surjective X Y f

/-- F77's exact charge kernel is an ACTUAL Mathlib Faithful
instance on the NEW quotient, though the old Gray source
projection remains nonfaithful. -/
instance c60F79QuotientChargeFaithful :
    c60F77QuotientToStrictCharge.Faithful where
  map_injective := by
    intro X Y f g h
    exact c60F77ToStrictCharge_map_injective X Y f g h

/-- ALL two-cell degree objects of the new strict charge
category are in the essential image of the original quotient.
This is stronger than a generic unspecific essential-image claim:
our F77 map is literally surjective on the objects. -/
instance c60F79QuotientChargeEssSurj :
    c60F77QuotientToStrictCharge.EssSurj :=
  c60F77QuotientToStrictCharge.essSurj_of_surj
    c60F77ToStrictCharge_obj_surjective

/-- The fundamental Mathlib equivalence class instance:
the charge-quotient functor is full, faithful and essentially
surjective with every component proved on its actual Hom sets. -/
instance c60F79QuotientChargeIsEquivalence :
    c60F77QuotientToStrictCharge.IsEquivalence where
  faithful := inferInstance
  full := inferInstance
  essSurj := inferInstance

/-- A FULL Mathlib categorical equivalence (with its genuine
quasi-inverse and two natural isomorphisms): the original
phase-killing quotient and the F75 strict charge 3-Hom groupoid
are equivalent. This is no mere bijection of numerical labels. -/
def c60F79NativeChargeEquivalence :
    C60F77NativeQuotient ≌ C60F75StrictChargeGrade :=
  c60F77QuotientToStrictCharge.asEquivalence

theorem c60F79Equivalence_hasOriginalQuotientFunctor :
    c60F79NativeChargeEquivalence.functor =
      c60F77QuotientToStrictCharge := rfl

/-- Every quotient arrow is recovered after applying the
equivalence and its quasi-inverse, with the canonical actual
Mathlib equivalence UNIT iso at each quotient object. -/
theorem c60F79Quotient_unit_isIso
    (X : C60F77NativeQuotient) :
    X ≅
      (c60F79NativeChargeEquivalence.functor ⋙
        c60F79NativeChargeEquivalence.inverse).obj X :=
  c60F79NativeChargeEquivalence.unitIso.app X

/-- Every strict charge object is recovered after applying the
actual inverse and forward functors, with the canonical verified
COUNIt iso, rather than an invented equality of original Gray terms. -/
theorem c60F79StrictCharge_counit_isIso
    (X : C60F75StrictChargeGrade) :
    (c60F79NativeChargeEquivalence.inverse ⋙
      c60F79NativeChargeEquivalence.functor).obj X ≅ X :=
  c60F79NativeChargeEquivalence.counitIso.app X

/-! Additional congruence stability for the genuine native tensor -/

/-- The F77 phase-killing congruence is stable not merely under
ordinary categorical pre- and post-composition, but under
INDEPENDENT NATIVE HORIZONTAL THREE-ARROW TENSOR in both variables.
Crucially, the proof retains BOTH Int × Int components. -/
theorem c60F79ChargeKernel_horizontalTensorStable
    {X X' Y Y' : GrayGrade}
    (f f' : X ⟶ X') (g g' : Y ⟶ Y')
    (hf : c60F77ChargeKernel f f')
    (hg : c60F77ChargeKernel g g') :
    c60F77ChargeKernel
      (GradedThreeCell.tensor f g)
      (GradedThreeCell.tensor f' g') := by
  apply (c60F77ChargeKernel_iff _ _).mpr
  have hfc := (c60F77ChargeKernel_iff f f').mp hf
  have hgc := (c60F77ChargeKernel_iff g g').mp hg
  change f.charge + g.charge = f'.charge + g'.charge
  rw [hfc, hgc]

/-- The actual F77 quotient projection identifies both parallel
horizontal tensor composites whenever the four original native
input three-arrows are congruent. This is already a QUOTIENT
3-arrow equality, rather than a charge equality. -/
theorem c60F79Quotient_horizTensor_congr
    {X X' Y Y' : GrayGrade}
    (f f' : X ⟶ X') (g g' : Y ⟶ Y')
    (hf : c60F77ChargeKernel f f')
    (hg : c60F77ChargeKernel g g') :
    c60F77Projection.map (GradedThreeCell.tensor f g) =
      c60F77Projection.map (GradedThreeCell.tensor f' g') := by
  apply CategoryTheory.Quotient.sound c60F77ChargeKernel
  exact c60F79ChargeKernel_horizontalTensorStable f f' g g' hf hg

/-- Once interpreted in the F75 target, genuine original
native horizontal tensor agrees EXACTLY with strict F76
horizontal three-arrow composition, retaining both integer
charge components and typed source/target grades. -/
theorem c60F79OriginalGray_horizontalTensor_preserved
    {X X' Y Y' : GrayGrade}
    (f : X ⟶ X') (g : Y ⟶ Y') :
    c60F75ForgetGrayExchangePhase.map (GradedThreeCell.tensor f g) =
      c60F76StrictChargeThreeTensor
        (c60F75ForgetGrayExchangePhase.map f)
        (c60F75ForgetGrayExchangePhase.map g) := by
  apply C60F75StrictChargeThree.ext
  rfl

/-! Actual ORIGINAL C60 F42/F43/F51 source remains the authority -/

/-- The originally proof-relevant F42/F43 source enters the
mathematically equivalent quotient via its genuine original
F43 inclusion and F51 full native three-Hom functor. -/
def c60F79OriginalF43Quotient
    {a b : IcosahedralDart} (p q : Quiver.Path a b) :
    C60F42PresentedFaceCell p q ⥤ C60F77NativeQuotient :=
  c60F51OriginalInclusion p q ⋙ c60F77OriginalSourceQuotient p q

/-- The ORIGINAL F43 3-Hom interpretation factors along the
actual verified category equivalence into the precise F75
strictification, WITHOUT changing either original C60 path
boundary or equating raw original 2-cell evidence. -/
theorem c60F79OriginalF43_strictification_factor
    {a b : IcosahedralDart} (p q : Quiver.Path a b) :
    c60F79OriginalF43Quotient p q ⋙
      c60F79NativeChargeEquivalence.functor =
        c60F75OriginalF43Strictification p q := by
  simpa only [c60F79NativeChargeEquivalence,
    c60F79OriginalF43Quotient,
    c60F75OriginalF43Strictification, Functor.assoc,
    c60F77OriginalSource_factor]

/-- The F51 ORIGINAL SOURCE followed by the actual category
equivalence is definitionally the same strict F75 functor as
the original exact quotient factorization: this is a new
categorical interpretation, not a replacement of raw words. -/
theorem c60F79OriginalF51_equivalence_factor
    {a b : IcosahedralDart} (p q : Quiver.Path a b) :
    c60F77OriginalSourceQuotient p q ⋙
      c60F79NativeChargeEquivalence.functor =
        c60F75OriginalFaceStrictification p q :=
  c60F77OriginalSource_factor p q

