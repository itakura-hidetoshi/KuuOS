import Kuu.LivingEngi.ConditionedBhava

/-!
# Living Engi Cycle LEC-07: Bhava → birth candidate ≠ external action

LEC-06 provides an actual certified, source-retaining ConventionalBhava and
a history-dependent pure candidate-generation kernel. This module preserves
that original source and distinguishes four mathematically different stages:

1. birth: an exact candidate of the declared Bhava/kernel/input;
2. policy admission: an independently supplied Governance proposition;
3. external receipt: a separately supplied, typed, lineage-bound witness;
4. effect receipt: further evidence after a licensed request.

None of these types manufactures an external effect. In particular, a
generated birth candidate does NOT imply existence of a licensed request;
and an authorized request does NOT imply an effect receipt. Revisions are
distinguishable: a concrete history-sensitive "fresh-only" receipt type
cannot simply be reused after any revision.

No original F55/P77/GK5CG source equality, arbitrary higher descent, live
ActOS adapter, execution, institutional/clinical license or general
AI weight modification is asserted.
-/

namespace Kuu.LivingEngi

set_option autoImplicit false

universe uX uI uF uA uInput uCandidate uScope

section TypedBirthAndAuthority

variable {X : Type uX} {I : Type uI}
variable {F : I → Type uF} {A : Type uA}
variable {U : I → Set X} {e : Frames F A}
variable {Input : Type uInput} {Candidate : Type uCandidate}
variable {Scope : Type uScope}

/-- A birth packet retains the EXACT Bhava and input whose kernel generated
the candidate. It cannot by itself claim policy/external approval. -/
structure BirthPacket
    (b : ConventionalBhava U e Input Candidate)
    (input : Input) where
  candidate : Candidate
  matches : candidate = birthCandidate b input

/-- The canonical birth has a genuine source equality witness. -/
def birthPacket (b : ConventionalBhava U e Input Candidate)
    (input : Input) : BirthPacket b input where
  candidate := birthCandidate b input
  matches := rfl

/-- Any birth packet is necessarily the candidate of its SOURCE Bhava.
Source/history/certificate are retained by the dependent index b. -/
theorem birthPacket_exact
    (b : ConventionalBhava U e Input Candidate)
    (input : Input) (p : BirthPacket b input) :
    p.candidate = b.kernel b.current.readout b.history input :=
  p.matches

/-- Exactness of birth does not depend on a policy or receipt. -/
theorem birthPacket_exists
    (b : ConventionalBhava U e Input Candidate) (input : Input) :
    Nonempty (BirthPacket b input) :=
  ⟨birthPacket b input⟩

/-- A caller-supplied governance/receipt boundary.
Both families are indexed by the whole Bhava, original input, declared
scope, and the proposed candidate. This explicitly admits policies that
depend on the full retained source history, not merely on a digest. -/
structure ActionBoundary
    (U : I → Set X) (e : Frames F A)
    (Input : Type uInput) (Candidate : Type uCandidate)
    (Scope : Type uScope) where
  governance :
    ConventionalBhava U e Input Candidate → Input → Scope → Candidate → Prop
  externalReceipt :
    ConventionalBhava U e Input Candidate → Input → Scope → Candidate → Type

/-- A LICENSED request is not an executed action. It has two independent
proof obligations: governance and a caller-supplied external receipt.
Neither is generated by the birth packet constructor. -/
structure LicensedRequest
    (B : ActionBoundary U e Input Candidate Scope)
    (b : ConventionalBhava U e Input Candidate)
    (input : Input) (scope : Scope) where
  birth : BirthPacket b input
  governance : B.governance b input scope birth.candidate
  external : B.externalReceipt b input scope birth.candidate

/-- Construct a scoped request only after BOTH external obligations have
already been presented for the exact current generated candidate. -/
def licensedRequest
    (B : ActionBoundary U e Input Candidate Scope)
    (b : ConventionalBhava U e Input Candidate)
    (input : Input) (scope : Scope)
    (hgov : B.governance b input scope (birthCandidate b input))
    (receipt : B.externalReceipt b input scope (birthCandidate b input)) :
    LicensedRequest B b input scope where
  birth := birthPacket b input
  governance := hgov
  external := receipt

/-- A request carries an actual governance proof for its exact birth value. -/
theorem licensedRequest_governance
    (B : ActionBoundary U e Input Candidate Scope)
    (b : ConventionalBhava U e Input Candidate)
    (input : Input) (scope : Scope)
    (r : LicensedRequest B b input scope) :
    B.governance b input scope (birthCandidate b input) := by
  simpa only [r.birth.matches] using r.governance

/-- A request carries an actual external receipt for its exact birth value. -/
theorem licensedRequest_external
    (B : ActionBoundary U e Input Candidate Scope)
    (b : ConventionalBhava U e Input Candidate)
    (input : Input) (scope : Scope)
    (r : LicensedRequest B b input scope) :
    Nonempty (B.externalReceipt b input scope (birthCandidate b input)) := by
  exact ⟨by simpa only [r.birth.matches] using r.external⟩

/-- Exact and target-scoped characterization: a licensed request EXISTS
iff governance grants the actual candidate AND an external witness exists.
A bare birth candidate is deliberately insufficient. -/
theorem licensedRequest_exists_iff
    (B : ActionBoundary U e Input Candidate Scope)
    (b : ConventionalBhava U e Input Candidate)
    (input : Input) (scope : Scope) :
    Nonempty (LicensedRequest B b input scope) ↔
      B.governance b input scope (birthCandidate b input) ∧
      Nonempty (B.externalReceipt b input scope (birthCandidate b input)) := by
  constructor
  · rintro ⟨r⟩
    exact ⟨licensedRequest_governance B b input scope r,
      licensedRequest_external B b input scope r⟩
  · rintro ⟨hgov, ⟨receipt⟩⟩
    exact ⟨licensedRequest B b input scope hgov receipt⟩

/-- Proof of denied governance is an explicit no-request obstruction. -/
theorem no_request_of_governance_denied
    (B : ActionBoundary U e Input Candidate Scope)
    (b : ConventionalBhava U e Input Candidate)
    (input : Input) (scope : Scope)
    (hdeny : ¬ B.governance b input scope (birthCandidate b input)) :
    ¬ Nonempty (LicensedRequest B b input scope) := by
  intro h
  exact hdeny ((licensedRequest_exists_iff B b input scope).1 h).1

/-- A missing external receipt is represented here by a PROOF that the
required receipt type is empty. Merely not having observed a receipt is
NOT such a nonexistence proof. -/
theorem no_request_of_external_refutation
    (B : ActionBoundary U e Input Candidate Scope)
    (b : ConventionalBhava U e Input Candidate)
    (input : Input) (scope : Scope)
    (hdeny : ¬ Nonempty
      (B.externalReceipt b input scope (birthCandidate b input))) :
    ¬ Nonempty (LicensedRequest B b input scope) := by
  intro h
  exact hdeny ((licensedRequest_exists_iff B b input scope).1 h).2

/-- Actual confirmed source support is retained under a licensed request.
No model-output candidate can replace that proof with its own fluency. -/
theorem licensedRequest_preserves_source_support
    (B : ActionBoundary U e Input Candidate Scope)
    (b : ConventionalBhava U e Input Candidate)
    (input : Input) (scope : Scope)
    (_r : LicensedRequest B b input scope) :
    HasFramedGlobal U e b.current.sections :=
  b.current.hasFramedGlobal

/-- A concrete countermodel: a genuine birth exists, while a boundary with
no possible external receipts admits no licensed request whatsoever. -/
def impossibleExternalBoundary
    (U : I → Set X) (e : Frames F A)
    (Input : Type uInput) (Candidate : Type uCandidate)
    (Scope : Type uScope) :
    ActionBoundary U e Input Candidate Scope where
  governance := fun _ _ _ _ => True
  externalReceipt := fun _ _ _ _ => Empty

theorem birth_exists_but_unlicensed
    (b : ConventionalBhava U e Input Candidate)
    (input : Input) (scope : Scope) :
    Nonempty (BirthPacket b input) ∧
    ¬ Nonempty (LicensedRequest
      (impossibleExternalBoundary U e Input Candidate Scope)
      b input scope) := by
  constructor
  · exact birthPacket_exists b input
  · rintro ⟨r⟩
    exact r.external.elim

/-- A separate receipt is also required to conclude an effect EVEN after a
licensed request. An EffectRecord is evidence, not an effect executor. -/
structure EffectRecord
    (B : ActionBoundary U e Input Candidate Scope)
    (b : ConventionalBhava U e Input Candidate)
    (input : Input) (scope : Scope)
    (EffectReceipt : LicensedRequest B b input scope → Type) where
  request : LicensedRequest B b input scope
  effect : EffectReceipt request

/-- An executed-effect claim without a possible effect receipt is refuted,
even if the underlying Act request would have been licensed. -/
theorem no_effect_without_effect_receipt
    (B : ActionBoundary U e Input Candidate Scope)
    (b : ConventionalBhava U e Input Candidate)
    (input : Input) (scope : Scope) :
    ¬ Nonempty (EffectRecord B b input scope (fun _ => Empty)) := by
  rintro ⟨r⟩
  exact r.effect.elim

/-- A simple but genuine lineage-bound receipt family: this license applies
only to the ORIGINAL empty-history Bhava. It is a mathematical example of
revision-sensitive scope, not an actual institutional authorization. -/
def freshOnlyBoundary
    (U : I → Set X) (e : Frames F A)
    (Input : Type uInput) (Candidate : Type uCandidate)
    (Scope : Type uScope) :
    ActionBoundary U e Input Candidate Scope where
  governance := fun _ _ _ _ => True
  externalReceipt := fun b _ _ _ => { token : Unit // b.history = [] }

/-- A newly certified Bhava with literally empty history has a genuine
mathematical receipt for the illustrative fresh-only boundary. -/
theorem freshly_begun_bhava_has_fresh_license
    (U : I → Set X) (e : Frames F A)
    (s : FramedLocalSections U F)
    (ev : PromotionEvidence (HasFramedGlobal U e s))
    (hadmit : Admissible ev)
    (kernel : (X → A) → List (FramedSnapshot U e) → Input → Candidate)
    (input : Input) (scope : Scope) :
    Nonempty (LicensedRequest
      (freshOnlyBoundary U e Input Candidate Scope)
      (beginBhava U e s ev hadmit kernel) input scope) := by
  refine ⟨{
    birth := birthPacket _ input
    governance := True.intro
    external := ⟨(), rfl⟩
  }⟩

/-- A revision appends the complete old source snapshot, so its history is
never empty. Consequently the PRE-REVISION illustrative fresh-only receipt
cannot authorize the revised Bhava. This is a concrete counterexample to
automatic license carryover; it does not ban a newly granted other license. -/
theorem revision_invalidates_fresh_only_license
    (b : ConventionalBhava U e Input Candidate)
    (s : FramedLocalSections U F)
    (ev : PromotionEvidence (HasFramedGlobal U e s))
    (hadmit : Admissible ev)
    (nextKernel : (X → A) → List (FramedSnapshot U e) → Input → Candidate)
    (input : Input) (scope : Scope) :
    ¬ Nonempty (LicensedRequest
      (freshOnlyBoundary U e Input Candidate Scope)
      (reviseBhava b s ev hadmit nextKernel) input scope) := by
  rintro ⟨r⟩
  have h := r.external.property
  change b.history ++ [b.current] = [] at h
  simp at h

end TypedBirthAndAuthority

