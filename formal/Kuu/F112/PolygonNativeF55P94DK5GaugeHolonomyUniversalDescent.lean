/-!
# F112-P94D3AR — noncommutative gauge-holonomy universal descent

The original C60 source-dependent fourteen-cell fiber and its genuinely
independent indexed Type-valued fifteen-cell comparisons are unchanged.
Form the ordered noncommutative defect h(R)⁻¹ * h(S) in the original
free-group history. Its left 14D whiskering is invariant, while a right
14D whiskering transforms it by ACTUAL group conjugation.

The normal closure of all physical contextual 15D defects is PROVED to
equal the normal closure of the single base defect. This is a statement
about the NORMAL GROUP SHADOW, not an equivalence of AP and AQ's Type-valued
presentations or a construction of any geometric sixteen-cell.

The resulting gauge-group quotient supports a genuine ALL-RAW history
observer on the AQ 15D quotient, even though the original free history
cannot descend. This normal subgroup is necessary and sufficient among
normal subgroups for all indexed gauge-history identifications. It has
a universal lift to every group-valued observer preserving the actual
contextual exchanges. The original history projection is noninjective.
No new axioms, sorry, Gray structure, or global strict n-category.
-/

namespace Kuu.F112.Physical

open CategoryTheory
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
noncomputable section

universe uD vD uE vE uG
variable {D : Type uD} [Category.{vD} D]
variable {E : Type uE} [Category.{vE} E]

section OriginalFourteenFiber

variable {p : Polygon} {a b : D} {x y : E} {n n' m m' : Nat}
variable {ma mb : KuuNativeBlocks a b} {pa pb : KuuNativeBlocks x y}
variable {first : KuuNativeF45Tree p n m ma pa mb pb}
variable {last : KuuNativeF45Tree p n' m' ma pa mb pb}
variable {r s : KuuNativeF45Tree.DepthRotationRoute p first last}
variable {f g : NativeF55StructuralComparison p r s}
variable {alpha beta : NativeK5StructuralFourCell p f g}
variable {w z : NativeK5StructuralFiveCell p alpha beta}
variable {u v : NativeK5StructuralSixCell p w z}
variable {h k : NativeK5StructuralSevenCell p u v}
variable {e d : NativeK5StructuralEightCell p h k}
variable {q t : NativeK5StructuralNineCell p e d}
variable {P Q : NativeK5StructuralTenCell p q t}
variable {H K : NativeK5StructuralElevenCell p P Q}
variable {U V : NativeK5StructuralTwelveCell p H K}

/-- Ordered free-group holonomy defect for two genuine raw 14D proofs. -/
def nativeK5ARWordDefect
    (W : NativeK5StructuralThirteenCell p U V)
    (R S : NativeK5FifteenFourteenFiber W) :
    NativeK5FourteenHistoryWord :=
  R.historyWord⁻¹ * S.historyWord

theorem nativeK5ARWordDefect_refl
    (W : NativeK5StructuralThirteenCell p U V)
    (R : NativeK5FifteenFourteenFiber W) :
    nativeK5ARWordDefect W R R = 1 := by
  simp [nativeK5ARWordDefect]

/-- Genuine LEFT 14D whiskering preserves the ordered defect exactly. -/
theorem nativeK5ARWordDefect_left
    (W : NativeK5StructuralThirteenCell p U V)
    (R S : NativeK5FifteenFourteenFiber W) :
    nativeK5ARWordDefect W
      (nativeK5AQWhiskerLeft W R)
      (nativeK5AQWhiskerLeft W S) =
      nativeK5ARWordDefect W R S := by
  change (((nativeK5AQLeftFrame W).historyWord * R.historyWord)⁻¹ *
      ((nativeK5AQLeftFrame W).historyWord * S.historyWord)) =
    R.historyWord⁻¹ * S.historyWord
  group

/-- Genuine RIGHT 14D whiskering gives the COVARIANT conjugate,
not an abelian or order-insensitive count. -/
theorem nativeK5ARWordDefect_right
    (W : NativeK5StructuralThirteenCell p U V)
    (R S : NativeK5FifteenFourteenFiber W) :
    nativeK5ARWordDefect W
      (nativeK5AQWhiskerRight W R)
      (nativeK5AQWhiskerRight W S) =
      (nativeK5AQRightFrame W).historyWord⁻¹ *
        nativeK5ARWordDefect W R S *
          (nativeK5AQRightFrame W).historyWord := by
  change ((R.historyWord * (nativeK5AQRightFrame W).historyWord)⁻¹ *
      (S.historyWord * (nativeK5AQRightFrame W).historyWord)) =
    (nativeK5AQRightFrame W).historyWord⁻¹ *
      (R.historyWord⁻¹ * S.historyWord) *
        (nativeK5AQRightFrame W).historyWord
  group

/-- Relators arising from EVERY actual typed finite left/right
fourteen-cell context, not from fictitious graph-level edges. -/
def nativeK5ARContextRelators
    (W : NativeK5StructuralThirteenCell p U V) :
    Set NativeK5FourteenHistoryWord :=
  {z | ∃ steps : List Bool,
    z = nativeK5ARWordDefect W
      (nativeK5AQLeft W steps) (nativeK5AQRight W steps)}

/-- Nonabelian NORMAL subgroup generated by all contextual exchange
defects. It carries genuine free-group order information. -/
def nativeK5ARHistoryKernel
    (W : NativeK5StructuralThirteenCell p U V) :
    Subgroup NativeK5FourteenHistoryWord :=
  Subgroup.normalClosure (nativeK5ARContextRelators W)

instance nativeK5ARHistoryKernel_normal
    (W : NativeK5StructuralThirteenCell p U V) :
    (nativeK5ARHistoryKernel W).Normal := by
  unfold nativeK5ARHistoryKernel
  infer_instance

/-- Every ORIGINAL typed context supplies a generator in the normal
group kernel; its existence is backed by AQ's explicit source witnesses. -/
theorem nativeK5ARContextDefect_mem
    (W : NativeK5StructuralThirteenCell p U V)
    (steps : List Bool) :
    nativeK5ARWordDefect W
      (nativeK5AQLeft W steps) (nativeK5AQRight W steps) ∈
        nativeK5ARHistoryKernel W := by
  unfold nativeK5ARHistoryKernel
  apply Subgroup.subset_normalClosure
  exact ⟨steps, rfl⟩

/-- Base defect at the exact C60 dependent fourteen-cell fiber. -/
def nativeK5ARBaseRelators
    (W : NativeK5StructuralThirteenCell p U V) :
    Set NativeK5FourteenHistoryWord :=
  {nativeK5ARWordDefect W
    (nativeK5FifteenCriticalLeft W) (nativeK5FifteenCriticalRight W)}

def nativeK5ARBaseKernel
    (W : NativeK5StructuralThirteenCell p U V) :
    Subgroup NativeK5FourteenHistoryWord :=
  Subgroup.normalClosure (nativeK5ARBaseRelators W)

instance nativeK5ARBaseKernel_normal
    (W : NativeK5StructuralThirteenCell p U V) :
    (nativeK5ARBaseKernel W).Normal := by
  unfold nativeK5ARBaseKernel
  infer_instance

theorem nativeK5ARBaseDefect_mem
    (W : NativeK5StructuralThirteenCell p U V) :
    nativeK5ARWordDefect W
      (nativeK5FifteenCriticalLeft W)
      (nativeK5FifteenCriticalRight W) ∈ nativeK5ARBaseKernel W := by
  unfold nativeK5ARBaseKernel
  apply Subgroup.subset_normalClosure
  rfl

/-- Normality, rather than a false raw proof equality, exactly
explains ALL finite physical context defects. -/
theorem nativeK5ARContextDefect_mem_base
    (W : NativeK5StructuralThirteenCell p U V)
    (steps : List Bool) :
    nativeK5ARWordDefect W
      (nativeK5AQLeft W steps) (nativeK5AQRight W steps) ∈
        nativeK5ARBaseKernel W := by
  induction steps with
  | nil => exact nativeK5ARBaseDefect_mem W
  | cons side rest ih =>
      cases side with
      | false =>
          change nativeK5ARWordDefect W
              (nativeK5AQWhiskerRight W (nativeK5AQLeft W rest))
              (nativeK5AQWhiskerRight W (nativeK5AQRight W rest)) ∈
                nativeK5ARBaseKernel W
          rw [nativeK5ARWordDefect_right]
          have hc :=
            (inferInstance : (nativeK5ARBaseKernel W).Normal).conj_mem
              (nativeK5ARWordDefect W
                (nativeK5AQLeft W rest) (nativeK5AQRight W rest))
              ih ((nativeK5AQRightFrame W).historyWord)⁻¹
          simpa only [inv_inv] using hc
      | true =>
          change nativeK5ARWordDefect W
              (nativeK5AQWhiskerLeft W (nativeK5AQLeft W rest))
              (nativeK5AQWhiskerLeft W (nativeK5AQRight W rest)) ∈
                nativeK5ARBaseKernel W
          rwa [nativeK5ARWordDefect_left]

/-- A stronger, NORMAL-SHADOW result than AQ: all indexed physical
defects generate EXACTLY the same normal group kernel as the base
critical pair. This DOES NOT equate AP and AQ Type-valued classes. -/
theorem nativeK5ARHistoryKernel_eq_base
    (W : NativeK5StructuralThirteenCell p U V) :
    nativeK5ARHistoryKernel W = nativeK5ARBaseKernel W := by
  apply le_antisymm
  · unfold nativeK5ARHistoryKernel
    apply Subgroup.normalClosure_le_normal
    intro z hz
    rcases hz with ⟨steps, rfl⟩
    exact nativeK5ARContextDefect_mem_base W steps
  · unfold nativeK5ARBaseKernel
    apply Subgroup.normalClosure_le_normal
    intro z hz
    have heq : z =
        nativeK5ARWordDefect W
          (nativeK5FifteenCriticalLeft W)
          (nativeK5FifteenCriticalRight W) := by
      simpa [nativeK5ARBaseRelators] using hz
    rw [heq]
    exact nativeK5ARContextDefect_mem W []

/-- Smallest NORMAL noncommutative kernel supporting every
independent source-typed contextual exchange. -/
theorem nativeK5ARHistoryKernel_minimal
    (W : NativeK5StructuralThirteenCell p U V)
    (H : Subgroup NativeK5FourteenHistoryWord) [H.Normal]
    (h : ∀ steps : List Bool,
      nativeK5ARWordDefect W
        (nativeK5AQLeft W steps) (nativeK5AQRight W steps) ∈ H) :
    nativeK5ARHistoryKernel W ≤ H := by
  unfold nativeK5ARHistoryKernel
  apply Subgroup.normalClosure_le_normal
  intro z hz
  rcases hz with ⟨steps, rfl⟩
  exact h steps

/-- A noncommutative gauge-holonomy quotient. It remembers the
remaining ordered history AFTER killing exactly the required normal
group relations, without asserting that the residual group is nonabelian. -/
abbrev NativeK5ARHistoryQuotient
    (W : NativeK5StructuralThirteenCell p U V) :=
  NativeK5FourteenHistoryWord ⧸ nativeK5ARHistoryKernel W

def nativeK5ARWordClass
    (W : NativeK5StructuralThirteenCell p U V) :
    NativeK5FourteenHistoryWord →*
      NativeK5ARHistoryQuotient W :=
  QuotientGroup.mk' (nativeK5ARHistoryKernel W)

/-- EVERY contextual independent fifteen-cell exchange becomes equal
in the minimal quotient of the ORIGINAL free holonomy group. -/
theorem nativeK5ARExchange_word_eq
    (W : NativeK5StructuralThirteenCell p U V)
    (steps : List Bool) :
    nativeK5ARWordClass W (nativeK5AQLeft W steps).historyWord =
      nativeK5ARWordClass W (nativeK5AQRight W steps).historyWord := by
  change ((nativeK5AQLeft W steps).historyWord :
      NativeK5ARHistoryQuotient W) =
    ((nativeK5AQRight W steps).historyWord :
      NativeK5ARHistoryQuotient W)
  exact (QuotientGroup.eq).2 (nativeK5ARContextDefect_mem W steps)

/-- Transport arbitrary genuine Type-valued AQ fifteen-cell evidence
to equality of NORMALIZED holonomy, with no collapse of raw terms. -/
theorem nativeK5ARWordClass_cell_sound
    (W : NativeK5StructuralThirteenCell p U V)
    {R S : NativeK5FifteenFourteenFiber W}
    (h : NativeK5AQFifteenCell W R S) :
    nativeK5ARWordClass W R.historyWord =
      nativeK5ARWordClass W S.historyWord := by
  induction h with
  | conservative base =>
      exact congrArg (nativeK5ARWordClass W) base.history_sound
  | exchange steps => exact nativeK5ARExchange_word_eq W steps
  | symm _ ih => exact ih.symm
  | trans _ _ ih1 ih2 => exact ih1.trans ih2

/-- TRUE all-raw gauge-corrected HISTORY descent along the AQ
Type-valued fifteen-cell relation, not scalar square-count descent. -/
def nativeK5ARGaugeHistory
    (W : NativeK5StructuralThirteenCell p U V) :
    NativeK5AQClasses W → NativeK5ARHistoryQuotient W :=
  Quotient.lift
    (fun R => nativeK5ARWordClass W R.historyWord)
    (by
      intro R S h
      rcases h with ⟨cell⟩
      exact nativeK5ARWordClass_cell_sound W cell)

theorem nativeK5ARGaugeHistory_mk
    (W : NativeK5StructuralThirteenCell p U V)
    (R : NativeK5FifteenFourteenFiber W) :
    nativeK5ARGaugeHistory W (nativeK5AQClass W R) =
      nativeK5ARWordClass W R.historyWord := rfl

/-- Genuine LEFT 14D whiskering acts by left multiplication on the
descended, group-valued corrected holonomy for EVERY quotient class. -/
theorem nativeK5ARGaugeHistory_whiskerLeft
    (W : NativeK5StructuralThirteenCell p U V)
    (q : NativeK5AQClasses W) :
    nativeK5ARGaugeHistory W
        (nativeK5AQWhiskerClass W true q) =
      nativeK5ARWordClass W (nativeK5AQLeftFrame W).historyWord *
        nativeK5ARGaugeHistory W q := by
  refine Quotient.inductionOn q ?_
  intro R
  change nativeK5ARWordClass W
      ((nativeK5AQLeftFrame W).historyWord * R.historyWord) =
    nativeK5ARWordClass W (nativeK5AQLeftFrame W).historyWord *
      nativeK5ARWordClass W R.historyWord
  exact map_mul (nativeK5ARWordClass W) _ _

/-- Genuine RIGHT 14D whiskering acts by right multiplication.
The order is retained: no commutativity is imposed by this theorem. -/
theorem nativeK5ARGaugeHistory_whiskerRight
    (W : NativeK5StructuralThirteenCell p U V)
    (q : NativeK5AQClasses W) :
    nativeK5ARGaugeHistory W
        (nativeK5AQWhiskerClass W false q) =
      nativeK5ARGaugeHistory W q *
        nativeK5ARWordClass W (nativeK5AQRightFrame W).historyWord := by
  refine Quotient.inductionOn q ?_
  intro R
  change nativeK5ARWordClass W
      (R.historyWord * (nativeK5AQRightFrame W).historyWord) =
    nativeK5ARWordClass W R.historyWord *
      nativeK5ARWordClass W (nativeK5AQRightFrame W).historyWord
  exact map_mul (nativeK5ARWordClass W) _ _

/-- The raw free history is NOT injectively represented by the
corrected gauge group: its true physical source-typed critical
fourteen-cell histories are unequal yet have identical quotient image. -/
theorem nativeK5ARWordClass_not_injective
    (W : NativeK5StructuralThirteenCell p U V) :
    ¬ Function.Injective (nativeK5ARWordClass W) := by
  intro hinj
  exact (nativeK5FourteenSquareExchange_pastingWord_ne W)
    (hinj (nativeK5ARExchange_word_eq W []))

/-- Every group-valued history observer respecting the genuine indexed
exchanges factors through the SAME minimal group normal quotient. -/
theorem nativeK5ARHistoryKernel_le_ker
    (W : NativeK5StructuralThirteenCell p U V)
    {G : Type uG} [Group G]
    (f : NativeK5FourteenHistoryWord →* G)
    (h : ∀ steps : List Bool,
      f (nativeK5AQLeft W steps).historyWord =
        f (nativeK5AQRight W steps).historyWord) :
    nativeK5ARHistoryKernel W ≤ f.ker := by
  apply nativeK5ARHistoryKernel_minimal W f.ker
  intro steps
  change f (nativeK5ARWordDefect W
      (nativeK5AQLeft W steps) (nativeK5AQRight W steps)) = 1
  change f ((nativeK5AQLeft W steps).historyWord⁻¹ *
      (nativeK5AQRight W steps).historyWord) = 1
  rw [map_mul, map_inv, h steps, inv_mul_cancel]

/-- The universal NONCOMMUTATIVE holonomy lift, without any invented
higher-cell filler or claim about residual commutativity. -/
def nativeK5ARHistoryLift
    (W : NativeK5StructuralThirteenCell p U V)
    {G : Type uG} [Group G]
    (f : NativeK5FourteenHistoryWord →* G)
    (h : ∀ steps : List Bool,
      f (nativeK5AQLeft W steps).historyWord =
        f (nativeK5AQRight W steps).historyWord) :
    NativeK5ARHistoryQuotient W →* G :=
  QuotientGroup.lift (nativeK5ARHistoryKernel W) f
    (nativeK5ARHistoryKernel_le_ker W f h)

theorem nativeK5ARHistoryLift_mk
    (W : NativeK5StructuralThirteenCell p U V)
    {G : Type uG} [Group G]
    (f : NativeK5FourteenHistoryWord →* G)
    (h : ∀ steps : List Bool,
      f (nativeK5AQLeft W steps).historyWord =
        f (nativeK5AQRight W steps).historyWord)
    (w : NativeK5FourteenHistoryWord) :
    nativeK5ARHistoryLift W f h (nativeK5ARWordClass W w) = f w := by
  exact QuotientGroup.lift_mk'
    (nativeK5ARHistoryKernel W)
    (nativeK5ARHistoryKernel_le_ker W f h) w

/-- The corrected nonabelian gauge history and original signed charge
both factor through AQ's REAL original source-dependent raw 14D fiber. -/
def nativeK5ARCombinedObserver
    (W : NativeK5StructuralThirteenCell p U V) :
    NativeK5AQClasses W → NativeK5ARHistoryQuotient W × ℤ :=
  fun q => (nativeK5ARGaugeHistory W q, nativeK5AQCharge W q)

theorem nativeK5ARCombinedObserver_mk
    (W : NativeK5StructuralThirteenCell p U V)
    (R : NativeK5FifteenFourteenFiber W) :
    nativeK5ARCombinedObserver W (nativeK5AQClass W R) =
      (nativeK5ARWordClass W R.historyWord, R.squareCount) := rfl

