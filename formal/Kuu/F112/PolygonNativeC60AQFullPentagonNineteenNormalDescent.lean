import Kuu.F112.PolygonNativeC60AQFullPentagonFiniteSignedNormalDescent

/-!
# F112-P94D3EY — genuine C60 finite 19D path defects and DT descent

Specialize the general finite signed/ordered path theorem to the original
complete noncommutative DS 18D FreeGroup receiver. For ANY SUPPLIED
dependent Type-valued candidate 19D filler, its full endpoint ratio is
the ordered product of exactly its actual signed generator defects.
This NONIDENTITY ratio belongs to the minimal normal closure generated
by precisely the generators used by that candidate path.

Independently, the same true long⁻¹ * short ratio belongs to DT's
all-original-pentagon normal closure. These are TWO separately selected
relative kernels; NO inclusion or equivalence between their full
subgroups is claimed. The new relative quotient kills the selected
defect, but the complete original 18D group retains the nontrivial word
and cannot retract faithfully through that quotient.

There is no constructed original geometric 19D filler, no identification
of distinct raw Type-valued histories, no substitution of the quotient
for original 18D preservation, no abelianization, Gray, sorry, or axiom.
Append-only; strict Kuu primary and independent Kuu as a presentation,
all original 14D--18D evidence and DS no-go retained.
Copyright Hidetoshi Itakura / 板倉英俊. Apache-2.0.
-/

namespace Kuu.F112.Physical

open CategoryTheory
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
noncomputable section

universe u w

section OriginalC60NineteenFiniteDefect

variable {L : NativeC60AXLayer.{u}}
variable (S : NativeC60AXSignature L) (F : Bool → NativeC60BCFrame L)

/-- The original complete noncommutative 18D pentagon ratio is the
FINITE ORDERED PRODUCT of the actual signed original 19D generator
defects inside the GIVEN candidate filler, not a scalar receiver. -/
theorem nativeC60EYNineteen_ratio_eq_signed_product
    {a b c d e : (nativeC60DQSeventeenLayer S F).Total}
    (f : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) a b)
    (g : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) b c)
    (h : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) c d)
    (k : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) d e)
    (T : NativeC60AXSignature (nativeC60DSNineteenLayer S F))
    (filler : NativeC60AXStep T
      (nativeC60DSPackEighteen S F
        (nativeC60DRPentagonLong S F f g h k))
      (nativeC60DSPackEighteen S F
        (nativeC60DRPentagonShort S F f g h k))) :
    (nativeC60DSFreeWord S F
        (nativeC60DRPentagonLong S F f g h k))⁻¹ *
      nativeC60DSFreeWord S F
        (nativeC60DRPentagonShort S F f g h k) =
      ((nativeC60EYSignedAtoms T filler).map
        (nativeC60EYSignedDefect T
          (nativeC60DSNineteenHolonomy S F))).prod := by
  rw [← nativeC60EXPentagon_defect_eq_full_ratio S F f g h k T filler]
  exact (nativeC60EYOrderedDefect_eq_EX
    T (nativeC60DSNineteenHolonomy S F) filler).symm

/-- The full original ratio is in the normal kernel generated by
ONLY the original dependent typed generator atoms that actually
occur in the GIVEN candidate 19D filler. -/
theorem nativeC60EYNineteen_ratio_mem_path_normal
    {a b c d e : (nativeC60DQSeventeenLayer S F).Total}
    (f : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) a b)
    (g : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) b c)
    (h : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) c d)
    (k : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) d e)
    (T : NativeC60AXSignature (nativeC60DSNineteenLayer S F))
    (filler : NativeC60AXStep T
      (nativeC60DSPackEighteen S F
        (nativeC60DRPentagonLong S F f g h k))
      (nativeC60DSPackEighteen S F
        (nativeC60DRPentagonShort S F f g h k))) :
    (nativeC60DSFreeWord S F
        (nativeC60DRPentagonLong S F f g h k))⁻¹ *
      nativeC60DSFreeWord S F
        (nativeC60DRPentagonShort S F f g h k) ∈
      nativeC60DTNormalClosure
        (nativeC60EYSelectedPairs T
          (nativeC60DSNineteenHolonomy S F)
          (nativeC60EYPathAtoms T filler)) := by
  rw [← nativeC60EXPentagon_defect_eq_full_ratio S F f g h k T filler]
  exact nativeC60EYPath_defect_mem_exact_atoms
    T (nativeC60DSNineteenHolonomy S F) filler

/-- The exact selected PATH-kernel quotient kills the full
noncommutative ratio, with NO claim of original 18D equality. -/
theorem nativeC60EYNineteen_ratio_path_quotient_one
    {a b c d e : (nativeC60DQSeventeenLayer S F).Total}
    (f : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) a b)
    (g : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) b c)
    (h : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) c d)
    (k : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) d e)
    (T : NativeC60AXSignature (nativeC60DSNineteenLayer S F))
    (filler : NativeC60AXStep T
      (nativeC60DSPackEighteen S F
        (nativeC60DRPentagonLong S F f g h k))
      (nativeC60DSPackEighteen S F
        (nativeC60DRPentagonShort S F f g h k))) :
    (QuotientGroup.mk' (nativeC60DTNormalClosure
      (nativeC60EYSelectedPairs T
        (nativeC60DSNineteenHolonomy S F)
        (nativeC60EYPathAtoms T filler))))
      ((nativeC60DSFreeWord S F
          (nativeC60DRPentagonLong S F f g h k))⁻¹ *
        nativeC60DSFreeWord S F
          (nativeC60DRPentagonShort S F f g h k)) = 1 := by
  apply MonoidHom.mem_ker.mp
  rw [nativeC60DTQuotient_kernel
    (nativeC60EYSelectedPairs T
      (nativeC60DSNineteenHolonomy S F)
      (nativeC60EYPathAtoms T filler))]
  exact nativeC60EYNineteen_ratio_mem_path_normal S F f g h k T filler

/-- Separately, this same oriented endpoint ratio lies in DT's
GLOBAL ALL-PENTAGON minimal kernel, by the exact original pair
identification and the normal subgroup kernel theorem. This does
NOT prove the two selected normal closures are mutually included. -/
theorem nativeC60EYNineteen_ratio_mem_DT
    {a b c d e : (nativeC60DQSeventeenLayer S F).Total}
    (f : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) a b)
    (g : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) b c)
    (h : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) c d)
    (k : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) d e) :
    (nativeC60DSFreeWord S F
        (nativeC60DRPentagonLong S F f g h k))⁻¹ *
      nativeC60DSFreeWord S F
        (nativeC60DRPentagonShort S F f g h k) ∈
      nativeC60DTPentagonNormalClosure S F := by
  have hq :
      (QuotientGroup.mk' (nativeC60DTPentagonNormalClosure S F))
        ((nativeC60DSFreeWord S F
          (nativeC60DRPentagonLong S F f g h k))⁻¹ *
          nativeC60DSFreeWord S F
            (nativeC60DRPentagonShort S F f g h k)) = 1 := by
    rw [map_mul, map_inv]
    rw [nativeC60DTPentagon_quotient_equal S F f g h k]
    simp
  have hm : (nativeC60DSFreeWord S F
      (nativeC60DRPentagonLong S F f g h k))⁻¹ *
      nativeC60DSFreeWord S F
        (nativeC60DRPentagonShort S F f g h k) ∈
      (QuotientGroup.mk' (nativeC60DTPentagonNormalClosure S F)).ker :=
    MonoidHom.mem_ker.mpr hq
  rw [nativeC60DTPentagon_kernel_exact] at hm
  exact hm

/-- Same genuine nonidentity word simultaneously belongs to the
candidate-path-selected normal kernel and the independent DT global
pentagon kernel. Neither inclusion of full kernels is inferred. -/
theorem nativeC60EYNineteen_ratio_two_kernels_and_nontrivial
    {a b c d e : (nativeC60DQSeventeenLayer S F).Total}
    (f : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) a b)
    (g : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) b c)
    (h : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) c d)
    (k : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) d e)
    (T : NativeC60AXSignature (nativeC60DSNineteenLayer S F))
    (filler : NativeC60AXStep T
      (nativeC60DSPackEighteen S F
        (nativeC60DRPentagonLong S F f g h k))
      (nativeC60DSPackEighteen S F
        (nativeC60DRPentagonShort S F f g h k))) :
    let defect := (nativeC60DSFreeWord S F
        (nativeC60DRPentagonLong S F f g h k))⁻¹ *
      nativeC60DSFreeWord S F
        (nativeC60DRPentagonShort S F f g h k)
    defect ∈ nativeC60DTNormalClosure
        (nativeC60EYSelectedPairs T
          (nativeC60DSNineteenHolonomy S F)
          (nativeC60EYPathAtoms T filler)) ∧
    defect ∈ nativeC60DTPentagonNormalClosure S F ∧
    defect ≠ 1 := by
  dsimp only
  exact ⟨nativeC60EYNineteen_ratio_mem_path_normal S F f g h k T filler,
    nativeC60EYNineteen_ratio_mem_DT S F f g h k,
    (by
      rw [← nativeC60EXPentagon_defect_eq_full_ratio S F f g h k T filler]
      exact nativeC60EXPentagon_defect_ne_one S F f g h k T filler)⟩

/-- A genuine original full-word receiver factors through the
candidate-path-selected relative quotient exactly if it kills each
actually appearing typed generator defect. -/
theorem nativeC60EYNineteen_path_receiver_factor_iff
    {a b c d e : (nativeC60DQSeventeenLayer S F).Total}
    (f : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) a b)
    (g : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) b c)
    (h : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) c d)
    (k : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) d e)
    (T : NativeC60AXSignature (nativeC60DSNineteenLayer S F))
    (filler : NativeC60AXStep T
      (nativeC60DSPackEighteen S F
        (nativeC60DRPentagonLong S F f g h k))
      (nativeC60DSPackEighteen S F
        (nativeC60DRPentagonShort S F f g h k)))
    {H : Type w} [Group H]
    (ρ : NativeC60DTFullFree S F →* H) :
    (∃ induced : NativeC60DTQuotient
        (nativeC60EYSelectedPairs T
          (nativeC60DSNineteenHolonomy S F)
          (nativeC60EYPathAtoms T filler)) →* H,
      induced.comp (QuotientGroup.mk'
        (nativeC60DTNormalClosure
          (nativeC60EYSelectedPairs T
            (nativeC60DSNineteenHolonomy S F)
            (nativeC60EYPathAtoms T filler)))) = ρ) ↔
      ∀ a : NativeC60EYPrimitive T,
        a ∈ nativeC60EYPathAtoms T filler →
        ρ (nativeC60EYPrimitiveDefect T
          (nativeC60DSNineteenHolonomy S F) a) = 1 :=
  nativeC60EYReceiver_factor_iff T
    (nativeC60DSNineteenHolonomy S F)
    (nativeC60EYPathAtoms T filler) ρ

/-- Despite the quotient one-value, the exact ORIGINAL complete 18D
ratio is nontrivial. Hence NO faithful group retraction recovers the
whole original free-group evidence through this selected relative
path quotient. DS's geometric 19D no-go remains unchanged. -/
theorem nativeC60EYNineteen_no_full_evidence_retraction
    {a b c d e : (nativeC60DQSeventeenLayer S F).Total}
    (f : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) a b)
    (g : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) b c)
    (h : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) c d)
    (k : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) d e)
    (T : NativeC60AXSignature (nativeC60DSNineteenLayer S F))
    (filler : NativeC60AXStep T
      (nativeC60DSPackEighteen S F
        (nativeC60DRPentagonLong S F f g h k))
      (nativeC60DSPackEighteen S F
        (nativeC60DRPentagonShort S F f g h k))) :
    ¬ ∃ retraction : NativeC60DTQuotient
        (nativeC60EYSelectedPairs T
          (nativeC60DSNineteenHolonomy S F)
          (nativeC60EYPathAtoms T filler)) →* NativeC60DTFullFree S F,
      retraction.comp (QuotientGroup.mk'
        (nativeC60DTNormalClosure
          (nativeC60EYSelectedPairs T
            (nativeC60DSNineteenHolonomy S F)
            (nativeC60EYPathAtoms T filler)))) =
        MonoidHom.id (NativeC60DTFullFree S F) := by
  let defect : NativeC60DTFullFree S F :=
    (nativeC60DSFreeWord S F
      (nativeC60DRPentagonLong S F f g h k))⁻¹ *
      nativeC60DSFreeWord S F
        (nativeC60DRPentagonShort S F f g h k)
  let N : Subgroup (NativeC60DTFullFree S F) :=
    nativeC60DTNormalClosure
      (nativeC60EYSelectedPairs T
        (nativeC60DSNineteenHolonomy S F)
        (nativeC60EYPathAtoms T filler))
  let q : NativeC60DTFullFree S F →* (NativeC60DTFullFree S F ⧸ N) :=
    QuotientGroup.mk' N
  have hq : q defect = 1 := by
    exact nativeC60EYNineteen_ratio_path_quotient_one
      S F f g h k T filler
  have hne : defect ≠ 1 := by
    dsimp only [defect]
    rw [← nativeC60EXPentagon_defect_eq_full_ratio S F f g h k T filler]
    exact nativeC60EXPentagon_defect_ne_one S F f g h k T filler
  rintro ⟨retraction, hcomp⟩
  have hfalse : defect = 1 := by
    calc
      defect = (retraction.comp q) defect :=
        (DFunLike.congr_fun hcomp defect).symm
      _ = retraction (q defect) := rfl
      _ = retraction 1 := by rw [hq]
      _ = 1 := map_one retraction
  exact hne hfalse

end OriginalC60NineteenFiniteDefect

