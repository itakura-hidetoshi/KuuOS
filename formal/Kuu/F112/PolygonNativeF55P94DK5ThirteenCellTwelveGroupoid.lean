import Kuu.F112.PolygonNativeF55P94DK5TypedThirteenCellSquareComparison
import Mathlib.Tactic

/-!
# F112-P94D3AK — strict LOCAL 12-cell groupoid and 13-cell quotient

Original 12D witnesses are identified ONLY by genuine source-dependent
13D evidence, never by definitional/raw proof equality. Construct the
fiberwise quotient, a strict LOCAL mathlib Groupoid over original 11D
objects, additive signed 12D count, an arbitrary observer's exact
iff descent criterion, and explicit obstruction to descending the
chosen noncommutative free history.

A local quotient groupoid does not entail a global strict 3/n
category or (∞,3)-hyperdescent.
-/

namespace Kuu.F112.Physical

open CategoryTheory
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
noncomputable section

universe uD vD uE vE
variable {D : Type uD} [Category.{vD} D]
variable {E : Type uE} [Category.{vE} E]

section LocalThirteenCellQuotient

variable {p : Polygon} {a b : D} {x y : E} {n n' m m' : Nat}
variable {ma mb : KuuNativeBlocks a b} {pa pb : KuuNativeBlocks x y}
variable {first : KuuNativeF45Tree p n m ma pa mb pb}
variable {last : KuuNativeF45Tree p n' m' ma pa mb pb}
variable {r s : KuuNativeF45Tree.DepthRotationRoute p first last}
variable {f g : NativeF55StructuralComparison p r s}
variable {alpha beta : NativeK5StructuralFourCell p f g}
variable {w z : NativeK5StructuralFiveCell p alpha beta}
variable {u v : NativeK5StructuralSixCell p w z}
variable {h k : NativeK5StructuralSevenCell p u v}
variable {e d : NativeK5StructuralEightCell p h k}
variable {q t : NativeK5StructuralNineCell p e d}
variable {P Q : NativeK5StructuralTenCell p q t}

/-- Equivalence generated by genuine ORIGINAL 13D evidence. -/
def NativeK5StructuralThirteenCell.setoid
    {H K : NativeK5StructuralElevenCell p P Q} :
    Setoid (NativeK5StructuralTwelveCell p H K) where
  r := fun U V => Nonempty (NativeK5StructuralThirteenCell p U V)
  iseqv := ⟨
    (fun U => ⟨.core (.refl U)⟩),
    (fun R => R.elim (fun S => ⟨.symm S⟩)),
    (fun R S => R.elim (fun X => S.elim (fun Y => ⟨.trans X Y⟩)))⟩

abbrev NativeK5ThirteenCellTwelveClasses
    (H K : NativeK5StructuralElevenCell p P Q) :=
  Quotient (NativeK5StructuralThirteenCell.setoid (H := H) (K := K))

def nativeK5ThirteenCellTwelveClass
    {H K : NativeK5StructuralElevenCell p P Q}
    (U : NativeK5StructuralTwelveCell p H K) :
    NativeK5ThirteenCellTwelveClasses H K :=
  Quotient.mk _ U

/-- An arbitrary observer factors through this exact dependent
13D quotient iff it respects all genuine 13D comparison witnesses. -/
theorem nativeK5ThirteenObserver_factors_iff
    {H K : NativeK5StructuralElevenCell p P Q}
    {A : Type*}
    (obs : NativeK5StructuralTwelveCell p H K → A) :
    (∃ F : NativeK5ThirteenCellTwelveClasses H K → A,
      ∀ U, F (nativeK5ThirteenCellTwelveClass U) = obs U) ↔
    (∀ U V : NativeK5StructuralTwelveCell p H K,
      Nonempty (NativeK5StructuralThirteenCell p U V) → obs U = obs V) := by
  constructor
  · rintro ⟨F, hF⟩ U V related
    calc
      obs U = F (nativeK5ThirteenCellTwelveClass U) := (hF U).symm
      _ = F (nativeK5ThirteenCellTwelveClass V) :=
        congrArg F (Quot.sound related)
      _ = obs V := hF V
  · intro compatible
    refine ⟨Quotient.lift obs (by
      intro U V related
      exact compatible U V related), ?_⟩
    intro U
    rfl

/-- Signed original 12D exchange count survives actual 13D quotienting. -/
def nativeK5ThirteenCellTwelveSquareCount
    {H K : NativeK5StructuralElevenCell p P Q} :
    NativeK5ThirteenCellTwelveClasses H K → ℤ :=
  Quotient.lift
    (fun U : NativeK5StructuralTwelveCell p H K => U.squareCount)
    (by
      intro U V ⟨thirteen⟩
      exact thirteen.squareCount_sound)

/-- Composition is independent of both representatives. -/
def nativeK5ThirteenCellTwelveVerticalComp
    {H K L : NativeK5StructuralElevenCell p P Q}
    (U : NativeK5ThirteenCellTwelveClasses H K)
    (V : NativeK5ThirteenCellTwelveClasses K L) :
    NativeK5ThirteenCellTwelveClasses H L :=
  Quot.liftOn₂ U V
    (fun X Y => nativeK5ThirteenCellTwelveClass (.trans X Y))
    (by
      intro X Y Y' related
      rcases related with ⟨thirteen⟩
      exact Quot.sound ⟨NativeK5StructuralThirteenCell.twelveVerticalRight X thirteen⟩)
    (by
      intro X X' Y related
      rcases related with ⟨thirteen⟩
      exact Quot.sound ⟨NativeK5StructuralThirteenCell.twelveVerticalLeft thirteen Y⟩)

def nativeK5ThirteenCellTwelveInverse
    {H K : NativeK5StructuralElevenCell p P Q}
    (U : NativeK5ThirteenCellTwelveClasses H K) :
    NativeK5ThirteenCellTwelveClasses K H :=
  Quot.liftOn U
    (fun raw => nativeK5ThirteenCellTwelveClass (.symm raw))
    (by
      intro X Y related
      rcases related with ⟨thirteen⟩
      exact Quot.sound ⟨NativeK5StructuralThirteenCell.twelveSymmRespect thirteen⟩)

/-- Strict LOCAL groupoid with original 11D witness objects and
quotiented original 12D morphisms, not global higher strictness. -/
@[reducible] def nativeK5ThirteenCellTwelveVerticalGroupoid
    (w0 z0 : NativeK5StructuralFiveCell p alpha beta)
    (u0 v0 : NativeK5StructuralSixCell p w0 z0)
    (h0 k0 : NativeK5StructuralSevenCell p u0 v0)
    (e0 d0 : NativeK5StructuralEightCell p h0 k0)
    (q0 t0 : NativeK5StructuralNineCell p e0 d0)
    (P0 Q0 : NativeK5StructuralTenCell p q0 t0) :
    Groupoid (NativeK5StructuralElevenCell p P0 Q0) where
  Hom := fun H K => NativeK5ThirteenCellTwelveClasses H K
  id H := nativeK5ThirteenCellTwelveClass (.core (.refl H))
  comp U V := nativeK5ThirteenCellTwelveVerticalComp U V
  id_comp := by
    intro X Y U
    refine Quot.inductionOn U (fun raw => ?_)
    change nativeK5ThirteenCellTwelveClass (.trans (.core (.refl X)) raw) =
      nativeK5ThirteenCellTwelveClass raw
    exact Quot.sound ⟨NativeK5StructuralThirteenCell.core
      (NativeK5CoreThirteenCell.twelveLeftUnit raw)⟩
  comp_id := by
    intro X Y U
    refine Quot.inductionOn U (fun raw => ?_)
    change nativeK5ThirteenCellTwelveClass (.trans raw (.core (.refl Y))) =
      nativeK5ThirteenCellTwelveClass raw
    exact Quot.sound ⟨NativeK5StructuralThirteenCell.core
      (NativeK5CoreThirteenCell.twelveRightUnit raw)⟩
  assoc := by
    intro W X Y Z U V T
    refine Quot.inductionOn U (fun x => ?_)
    refine Quot.inductionOn V (fun y => ?_)
    refine Quot.inductionOn T (fun z => ?_)
    change nativeK5ThirteenCellTwelveClass (.trans (.trans x y) z) =
      nativeK5ThirteenCellTwelveClass (.trans x (.trans y z))
    exact Quot.sound ⟨NativeK5StructuralThirteenCell.core
      (NativeK5CoreThirteenCell.twelveAssoc x y z)⟩
  inv := fun {X Y} U => nativeK5ThirteenCellTwelveInverse U
  inv_comp := by
    intro X Y U
    refine Quot.inductionOn U (fun raw => ?_)
    change nativeK5ThirteenCellTwelveClass (.trans (.symm raw) raw) =
      nativeK5ThirteenCellTwelveClass (.core (.refl Y))
    exact Quot.sound ⟨NativeK5StructuralThirteenCell.core
      (NativeK5CoreThirteenCell.twelveInverseRight raw)⟩
  comp_inv := by
    intro X Y U
    refine Quot.inductionOn U (fun raw => ?_)
    change nativeK5ThirteenCellTwelveClass (.trans raw (.symm raw)) =
      nativeK5ThirteenCellTwelveClass (.core (.refl X))
    exact Quot.sound ⟨NativeK5StructuralThirteenCell.core
      (NativeK5CoreThirteenCell.twelveInverseLeft raw)⟩

theorem nativeK5ThirteenCellTwelveSquareCount_comp
    {H K L : NativeK5StructuralElevenCell p P Q}
    (U : NativeK5ThirteenCellTwelveClasses H K)
    (V : NativeK5ThirteenCellTwelveClasses K L) :
    nativeK5ThirteenCellTwelveSquareCount
      (nativeK5ThirteenCellTwelveVerticalComp U V) =
      nativeK5ThirteenCellTwelveSquareCount U +
        nativeK5ThirteenCellTwelveSquareCount V := by
  refine Quot.inductionOn U (fun X => ?_)
  refine Quot.inductionOn V (fun Y => ?_)
  rfl

/-- New equality of the two ORIGINAL 12D inverse-square pastings
holds AFTER quotienting by actual 13D witnesses. -/
theorem nativeK5TwelvePasting_thirteenQuotient_eq
    {H K : NativeK5StructuralElevenCell p P Q}
    (W : NativeK5StructuralTwelveCell p H K) :
    nativeK5ThirteenCellTwelveClass (nativeK5TwelvePastingLeftThenRight W) =
      nativeK5ThirteenCellTwelveClass (nativeK5TwelvePastingRightThenLeft W) :=
  Quot.sound ⟨NativeK5StructuralThirteenCell.squareExchange W⟩

/-- The chosen original free-group 12D history does NOT factor through
the new quotient when the two genuine 12D histories differ. -/
theorem nativeK5TwelveHistoryWord_noThirteenDescent
    {H K : NativeK5StructuralElevenCell p P Q}
    (W : NativeK5StructuralTwelveCell p H K)
    (hneq : (nativeK5TwelvePastingLeftThenRight W).historyWord ≠
      (nativeK5TwelvePastingRightThenLeft W).historyWord) :
    ¬ ∃ (F : NativeK5ThirteenCellTwelveClasses
      (.trans H (.symm H)) (.trans K (.symm K)) →
        NativeK5TwelveHistoryWord),
      ∀ U : NativeK5StructuralTwelveCell p
        (.trans H (.symm H)) (.trans K (.symm K)),
        F (nativeK5ThirteenCellTwelveClass U) = U.historyWord := by
  rintro ⟨F, hF⟩
  have heq := nativeK5TwelvePasting_thirteenQuotient_eq W
  have hword :
      (nativeK5TwelvePastingLeftThenRight W).historyWord =
        (nativeK5TwelvePastingRightThenLeft W).historyWord := by
    calc
      (nativeK5TwelvePastingLeftThenRight W).historyWord =
          F (nativeK5ThirteenCellTwelveClass
            (nativeK5TwelvePastingLeftThenRight W)) := (hF _).symm
      _ = F (nativeK5ThirteenCellTwelveClass
          (nativeK5TwelvePastingRightThenLeft W)) := congrArg F heq
      _ = (nativeK5TwelvePastingRightThenLeft W).historyWord := hF _
  exact hneq hword

end LocalThirteenCellQuotient

#print axioms NativeK5StructuralThirteenCell.setoid
#print axioms NativeK5ThirteenCellTwelveClasses
#print axioms nativeK5ThirteenCellTwelveClass
#print axioms nativeK5ThirteenObserver_factors_iff
#print axioms nativeK5ThirteenCellTwelveSquareCount
#print axioms nativeK5ThirteenCellTwelveVerticalComp
#print axioms nativeK5ThirteenCellTwelveInverse
#print axioms nativeK5ThirteenCellTwelveVerticalGroupoid
#print axioms nativeK5ThirteenCellTwelveSquareCount_comp
#print axioms nativeK5TwelvePasting_thirteenQuotient_eq
#print axioms nativeK5TwelveHistoryWord_noThirteenDescent

end
end Kuu.F112.Physical
