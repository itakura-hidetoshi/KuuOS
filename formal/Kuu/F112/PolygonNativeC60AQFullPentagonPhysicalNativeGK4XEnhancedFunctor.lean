universe uD vD uE vE

/-- A DIFFERENT explicit observation target category, not another
Category instance on the original GK4I source F45 stage Type. -/
inductive NativeGK4XValuePoint : Type where
  | star

/-- A TRUE Mathlib category with fully proved Bool.and + Int.add
value operation. It does not claim that every ambient value arises
from an actual original F54 route at every boundary. -/
instance nativeGK4XValueCategory : Category NativeGK4XValuePoint where
  Hom _ _ := Bool × Int
  id _ := (true, 0)
  comp u v := nativeGK4XCombine u v
  id_comp := by
    intro X Y f
    exact nativeGK4XCombine_leftUnit f
  comp_id := by
    intro X Y f
    exact nativeGK4XCombine_rightUnit f
  assoc := by
    intro W X Y Z f g h
    exact nativeGK4XCombine_assoc f g h

/-- ACTUAL structural F45 Category -> value Category functor.
Map respects genuine GK4H S composition and structural identities,
never the nonexistent original P92B category laws. -/
def nativeGK4XValueFunctor
    {D : Type uD} [Category.{vD} D]
    {E : Type uE} [Category.{vE} E]
    {a b : D} {x y : E}
    (p : Polygon)
    (ma mb : KuuNativeBlocks a b)
    (pa pb : KuuNativeBlocks x y) :
    NativeGK4IStage p ma mb pa pb ⥤ NativeGK4XValuePoint where
  obj _ := .star
  map := fun {X Y} f => nativeGK4XEnhancedStructural X.2.2 Y.2.2 f
  map_id := by
    intro X
    exact nativeGK4XEnhancedStructural_unit X.2.2
  map_comp := by
    intro X Y Z f g
    exact nativeGK4XEnhancedStructural_compose X.2.2 Y.2.2 Z.2.2 f g

/-- Discard ONLY the new signed component via a genuine Bool functor.
This does not create a source P92B witness or a reverse equivalence. -/
def nativeGK4XForgetChargeFunctor :
    NativeGK4XValuePoint ⥤ NativeGK4IBoolPoint where
  obj _ := .star
  map := fun {X Y} f => f.1
  map_id := by
    intro X
    rfl
  map_comp := by
    intro X Y Z f g
    rfl

/-- EXACT object-level factorization of the old GK4I Boolean grading
through the new charge-enhanced genuine functor. -/
theorem nativeGK4XFunctor_factor_obj
    {D : Type uD} [Category.{vD} D]
    {E : Type uE} [Category.{vE} E]
    {a b : D} {x y : E}
    (p : Polygon)
    (ma mb : KuuNativeBlocks a b)
    (pa pb : KuuNativeBlocks x y)
    (X : NativeGK4IStage p ma mb pa pb) :
    nativeGK4XForgetChargeFunctor.obj
      ((nativeGK4XValueFunctor p ma mb pa pb).obj X) =
      (nativeGK4IGradingFunctor p ma mb pa pb).obj X := by
  rfl

/-- EXACT arrow-level factorization: old Boolean observation is the
first projection of new (Boolean,charge) observation, not a claim that
an older observed quotient magically reconstructs the new component. -/
theorem nativeGK4XFunctor_factor_map
    {D : Type uD} [Category.{vD} D]
    {E : Type uE} [Category.{vE} E]
    {a b : D} {x y : E}
    (p : Polygon)
    (ma mb : KuuNativeBlocks a b)
    (pa pb : KuuNativeBlocks x y)
    (X Y : NativeGK4IStage p ma mb pa pb)
    (f : X ⟶ Y) :
    nativeGK4XForgetChargeFunctor.map
        ((nativeGK4XValueFunctor p ma mb pa pb).map f) =
      (nativeGK4IGradingFunctor p ma mb pa pb).map f := by
  rfl

section ValueExactness
variable {p : Polygon}
variable {D : Type uD} [Category.{vD} D]
variable {E : Type uE} [Category.{vE} E]
variable {a b : D} {x y : E}
variable {ma mb : KuuNativeBlocks a b} {pa pb : KuuNativeBlocks x y}
variable {n n' m m' : Nat}
variable (first : KuuNativeF45Tree p n m ma pa mb pb)
variable (last : KuuNativeF45Tree p n' m' ma pa mb pb)

/-- Equality of enhanced structural observations is EXACTLY
equality of BOTH original invariants on the structural quotient. -/
theorem nativeGK4XEnhancedStructural_eq_iff
    (u v : NativeGK4EStructuralRouteClasses first last) :
    nativeGK4XEnhancedStructural first last u =
      nativeGK4XEnhancedStructural first last v ↔
      nativeGK4GStructuralGrade first last u =
        nativeGK4GStructuralGrade first last v ∧
      nativeGK4XChargeStructural first last u =
        nativeGK4XChargeStructural first last v := by
  constructor
  · intro h
    exact ⟨congrArg Prod.fst h, congrArg Prod.snd h⟩
  · rintro ⟨hgrade, hcharge⟩
    exact Prod.ext hgrade hcharge

/-- GK4X genuine P92B observer passes the exact GK4T original
14-seam criterion and therefore has a canonical S -> K_enhanced
comparison on EVERY genuine F45 typed boundary. -/
theorem nativeGK4XEnhancedComparisonExists :
    NativeGK4TComparisonExists
      (nativeGK4XEnhancedP92Family p D E) first last := by
  exact (nativeGK4TComparisonExists_iff_seam
    (nativeGK4XEnhancedP92Family p D E) first last).mpr
      (nativeGK4XEnhancedSeamInvariant first last)

/-- Actual GK4T S -> second P92B observation-kernel quotient.
The map is surjective but need NOT be an injection on every S Hom. -/
def nativeGK4XEnhancedComparison :
    NativeGK4EStructuralRouteClasses first last →
      NativeGK4SKernelClasses
        (nativeGK4XEnhancedP92Family p D E) first last :=
  nativeGK4TComparison (nativeGK4XEnhancedP92Family p D E)
    first last (nativeGK4XEnhancedSeamInvariant first last)

/-- The new actual enhanced-kernel quotient remembers the exact
pair value, transported through GK4S's TRUE attained-image equivalence. -/
theorem nativeGK4XEnhancedComparison_value
    (u : NativeGK4EStructuralRouteClasses first last) :
    (nativeGK4SKernelImageEquiv
        (nativeGK4XEnhancedP92Family p D E) first last
        (nativeGK4XEnhancedComparison first last u)).val =
      nativeGK4XEnhancedStructural first last u := by
  obtain ⟨q, rfl⟩ := nativeGK4EP92ToStructural_surjective first last u
  simpa only [nativeGK4XEnhancedComparison,
    nativeGK4TComparison_class, nativeGK4SKernelImageEquiv_class]
    using (nativeGK4XEnhanced_commutes first last q).symm

/-- Unlike an ambient-value similarity, this is an exact theorem
about the actual second quotient of ORIGINAL P92B proof classes.
Two structural classes have the same K_enhanced image iff their
real enhanced observations agree. -/
theorem nativeGK4XEnhancedComparison_eq_iff
    (u v : NativeGK4EStructuralRouteClasses first last) :
    nativeGK4XEnhancedComparison first last u =
      nativeGK4XEnhancedComparison first last v ↔
      nativeGK4XEnhancedStructural first last u =
        nativeGK4XEnhancedStructural first last v := by
  constructor
  · intro h
    have hval := congrArg
      (fun z : NativeGK4SKernelClasses
          (nativeGK4XEnhancedP92Family p D E) first last =>
        (nativeGK4SKernelImageEquiv
          (nativeGK4XEnhancedP92Family p D E) first last z).val) h
    simpa only [nativeGK4XEnhancedComparison_value] using hval
  · intro h
    apply (nativeGK4SKernelImageEquiv
      (nativeGK4XEnhancedP92Family p D E) first last).injective
    apply Subtype.ext
    simpa only [nativeGK4XEnhancedComparison_value] using h

/-- All actual K_enhanced quotient classes are reached from S,
because the source-to-structural and source-to-kernel quotient maps
are the true original canonical surjections. -/
theorem nativeGK4XEnhancedComparison_surjective :
    Function.Surjective (nativeGK4XEnhancedComparison first last) := by
  exact nativeGK4TComparison_surjective
    (nativeGK4XEnhancedP92Family p D E) first last
    (nativeGK4XEnhancedSeamInvariant first last)

/-- Local enhanced faithfulness classification at EACH genuine typed
original F45 Hom, still no global unconditional faithfulness. -/
theorem nativeGK4XEnhancedComparison_injective_iff :
    Function.Injective (nativeGK4XEnhancedComparison first last) ↔
      Function.Injective (nativeGK4XEnhancedStructural first last) := by
  constructor
  · intro hinj u v h
    exact hinj ((nativeGK4XEnhancedComparison_eq_iff first last u v).mpr h)
  · intro hinj u v h
    exact hinj ((nativeGK4XEnhancedComparison_eq_iff first last u v).mp h)

end ValueExactness

section RealCastTower
variable {p : Polygon}
variable {D : Type uD} [Category.{vD} D]
variable {E : Type uE} [Category.{vE} E]
variable {a b : D} {x y : E} {n m : Nat}
variable {ma mb : KuuNativeBlocks a b} {pa pb : KuuNativeBlocks x y}
variable (tree : KuuNativeF45Tree p n m ma pa mb pb)

/-- Every truly original F54 cast tower is observed as (true,k).
All objects, Blocks and BOTH Nat depth indices remain original. -/
theorem nativeGK4XEnhancedStructural_castTower (k : Nat) :
    nativeGK4XEnhancedStructural tree tree
        (nativeGK4EStructuralRouteClass tree tree
          (nativeGK4WCastTower tree k)) =
      (true, (k : Int)) := by
  apply Prod.ext
  · exact nativeGK4WCastTower_grade tree k
  · exact nativeGK4WCastTower_charge tree k

/-- The entire original cast tower remains pairwise DISTINCT
under the real enriched observation, even though all its old
Boolean-only observations were the same value true. -/
theorem nativeGK4XEnhancedStructural_castTower_injective :
    Function.Injective
      (fun k : Nat => nativeGK4XEnhancedStructural tree tree
        (nativeGK4EStructuralRouteClass tree tree
          (nativeGK4WCastTower tree k))) := by
  intro i j hij
  rw [nativeGK4XEnhancedStructural_castTower,
    nativeGK4XEnhancedStructural_castTower] at hij
  have hcast := congrArg Prod.snd hij
  exact_mod_cast hcast

/-- The *actual K_enhanced* second quotient of original P92B classes
separates ALL genuine signed cast towers, not only ambient Bool×Int. -/
theorem nativeGK4XEnhancedComparison_castTower_injective :
    Function.Injective
      (fun k : Nat =>
        nativeGK4XEnhancedComparison tree tree
          (nativeGK4EStructuralRouteClass tree tree
            (nativeGK4WCastTower tree k))) := by
  intro i j hij
  have hpair :=
    (nativeGK4XEnhancedComparison_eq_iff tree tree _ _).mp hij
  exact nativeGK4XEnhancedStructural_castTower_injective tree hpair

/-- OLD Boolean observation collapses these two actual structural
classes, while the new enriched observation separates them. This
is a strict refinement on the TRUE source classes themselves. -/
theorem nativeGK4X_cast_vs_unit_refinement :
    nativeGK4GStructuralGrade tree tree
        (nativeGK4EStructuralRouteClass tree tree
          (nativeGK4WCastRoute tree)) =
      nativeGK4GStructuralGrade tree tree
        (nativeGK4H_structuralUnit tree) ∧
      nativeGK4XEnhancedStructural tree tree
        (nativeGK4EStructuralRouteClass tree tree
          (nativeGK4WCastRoute tree)) ≠
      nativeGK4XEnhancedStructural tree tree
        (nativeGK4H_structuralUnit tree) := by
  constructor
  · exact nativeGK4WCastClass_and_unit_same_grade tree
  · intro h
    have hc := congrArg Prod.snd h
    change (1 : Int) = 0 at hc
    omega

/-- The same strict refinement occurs in the ACTUAL second
P92B observation-kernel quotient, not merely an ambient value type. -/
theorem nativeGK4X_kernel_cast_vs_unit_ne :
    nativeGK4XEnhancedComparison tree tree
        (nativeGK4EStructuralRouteClass tree tree
          (nativeGK4WCastRoute tree)) ≠
      nativeGK4XEnhancedComparison tree tree
        (nativeGK4H_structuralUnit tree) := by
  intro h
  have hp := (nativeGK4XEnhancedComparison_eq_iff tree tree _ _).mp h
  exact (nativeGK4X_cast_vs_unit_refinement tree).2 hp

end RealCastTower

