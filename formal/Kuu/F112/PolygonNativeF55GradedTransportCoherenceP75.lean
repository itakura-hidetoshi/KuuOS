import Kuu.F112.PolygonNativeF55LinearChargeDescentP74
import Mathlib.Tactic.Abel

/-!
# F112-P75 — Type-valued graded lifts of genuine F55 representative transport

P71 gives the LEAST Prop-valued reflexive/symmetric/transitive relation
generated by genuine P70 representative changes. P72 proves correction
identities for selected witnesses. P73-P74 identify the signed pentagon
coordinate that descends to the ungraded transport quotient and classify
the possible integer-linear descending charges.

Here we retain MORE, not less, of the actual F55 source evidence:
we construct a Type-valued transport-history witness, INDEXED by the
full selected F55 shadow increment. Its generators are precisely
identity, inverse, vertical concatenation, and genuine P70
representative change with actual source F55 square-only witnesses.

The additive grade is sound for EVERY such typed proof history.
For fixed genuine higher-arrow endpoints it is UNIQUE, independent
of the typed transport path. In particular, any closed loop has
total grade zero. Forgetting the grade gives the actual P71 relation;
conversely any P71 relation merely proves Nonempty of a typed graded
lift, without extracting a preferred witness from Prop. This is an
exact kernel equivalence rather than an identification of raw histories.

The north C60 physical disjoint square has a genuinely witnessed
graded lift with signed square increment +1 and nonzero odd parity.
These nontrivial increments are compatible with zero-grade loops,
but they cannot be treated as bare quotient-invariant observables.

NO source proof histories are equated here. This is not a proof
of raw associativity, full 3-dimensional interchange, strict 3/n,
or (infinity,3)-hyperdescent. No Gray, new axioms, sorry, or admit.
-/ 

namespace Kuu.F112.Physical

open CategoryTheory
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
noncomputable section

universe uD vD uE vE
variable {D : Type uD} [Category.{vD} D]
variable {E : Type uE} [Category.{vE} E]

/-- Typed transport paths, carrying their ACTUAL comparison cells,
graded by the resulting ORIGINAL signed F55 shadow change. Neither
raw proof-term equality nor an observer-only quotient is imposed. -/
inductive NativeF55GradedTransport
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb)
    (source target : NativeF55ContextSquareRouteClasses first last) :
    (f g : NativeF55HigherArrowOverClasses first last source target) →
    KuuNativeF55Shadow → Type (max (max uD uE) (max vD vE)) where
  | refl
      (arrow : NativeF55HigherArrowOverClasses first last source target) :
      NativeF55GradedTransport first last source target arrow arrow 0
  | symm
      {f g : NativeF55HigherArrowOverClasses first last source target}
      {charge : KuuNativeF55Shadow}
      (w : NativeF55GradedTransport first last source target f g charge) :
      NativeF55GradedTransport first last source target g f (-charge)
  | trans
      {f g h : NativeF55HigherArrowOverClasses first last source target}
      {c d : KuuNativeF55Shadow}
      (w₁ : NativeF55GradedTransport first last source target f g c)
      (w₂ : NativeF55GradedTransport first last source target g h d) :
      NativeF55GradedTransport first last source target f h (c + d)
  | change
      (arrow : NativeF55HigherArrowOverClasses first last source target)
      {u v : KuuNativeF45Tree.DepthRotationRoute p first last}
      (left : NativeF55SquareOnlyCell
        (p := p) (u := u) (v := arrow.before))
      (right : NativeF55SquareOnlyCell
        (p := p) (u := arrow.after) (v := v)) :
      NativeF55GradedTransport first last source target arrow
        (arrow.changeRepresentatives left right)
        (left.1.nativeShadow + right.1.nativeShadow)

variable {p : Polygon} {a b : D} {x y : E}
variable {n n' m m' : Nat}
variable {ma mb : KuuNativeBlocks a b}
variable {pa pb : KuuNativeBlocks x y}
variable {first : KuuNativeF45Tree p n m ma pa mb pb}
variable {last : KuuNativeF45Tree p n' m' ma pa mb pb}
variable {source target : NativeF55ContextSquareRouteClasses first last}

/-- The grade of EVERY actual typed transport history is its exact
original F55 shadow increment, including BOTH integer coordinates
and independent ZMod 2 exchange parity. -/
theorem NativeF55GradedTransport.shadow_eq
    {f g : NativeF55HigherArrowOverClasses first last source target}
    {charge : KuuNativeF55Shadow}
    (w : NativeF55GradedTransport first last source target f g charge) :
    g.raw.nativeShadow = f.raw.nativeShadow + charge := by
  induction w with
  | refl arrow => simp
  | symm w ih =>
      rw [ih]
      abel
  | trans w₁ w₂ ih₁ ih₂ =>
      rw [ih₂, ih₁]
      abel
  | change arrow left right =>
      rw [NativeF55HigherArrowOverClasses.changeRepresentatives_shadow]
      abel

/-- Even when there are DIFFERENT genuine Type-valued transport
histories, their full charge is identical for fixed raw endpoints.
This does not identify the underlying histories themselves. -/
theorem NativeF55GradedTransport.grade_unique
    {f g : NativeF55HigherArrowOverClasses first last source target}
    {c d : KuuNativeF55Shadow}
    (w : NativeF55GradedTransport first last source target f g c)
    (v : NativeF55GradedTransport first last source target f g d) :
    c = d := by
  exact add_left_cancel (w.shadow_eq.symm.trans v.shadow_eq)

/-- Every genuine closed graded path has grade zero; this is a
closed-loop coherence theorem at the selected F55 shadow level,
NOT a raw proof-history contraction. -/
theorem NativeF55GradedTransport.loop_grade_zero
    (arrow : NativeF55HigherArrowOverClasses first last source target)
    {c : KuuNativeF55Shadow}
    (w : NativeF55GradedTransport first last source target arrow arrow c) :
    c = 0 :=
  w.grade_unique (.refl arrow)

/-- Forget only the full charge and the Type-level path history to
obtain the ORIGINAL P71 transport relation. -/
theorem NativeF55GradedTransport.forget
    {f g : NativeF55HigherArrowOverClasses first last source target}
    {charge : KuuNativeF55Shadow}
    (w : NativeF55GradedTransport first last source target f g charge) :
    NativeF55HigherTransportRel first last source target f g := by
  induction w with
  | refl arrow => exact .refl arrow
  | symm w ih => exact .symm ih
  | trans w₁ w₂ ih₁ ih₂ => exact .trans ih₁ ih₂
  | change arrow left right => exact .change arrow left right

/-- Every P71 transport relation has SOME actual graded Type-valued
history. Its Prop proof does not choose a canonical witness. -/
theorem NativeF55HigherTransportRel.hasGradedLift
    {f g : NativeF55HigherArrowOverClasses first last source target}
    (h : NativeF55HigherTransportRel first last source target f g) :
    ∃ charge : KuuNativeF55Shadow,
      Nonempty (NativeF55GradedTransport first last source target f g charge) := by
  induction h with
  | refl arrow =>
      exact ⟨0, ⟨NativeF55GradedTransport.refl arrow⟩⟩
  | symm h ih =>
      rcases ih with ⟨c, ⟨w⟩⟩
      exact ⟨-c, ⟨NativeF55GradedTransport.symm w⟩⟩
  | trans h₁ h₂ ih₁ ih₂ =>
      rcases ih₁ with ⟨c, ⟨w₁⟩⟩
      rcases ih₂ with ⟨d, ⟨w₂⟩⟩
      exact ⟨c + d, ⟨NativeF55GradedTransport.trans w₁ w₂⟩⟩
  | change arrow left right =>
      exact ⟨left.1.nativeShadow + right.1.nativeShadow,
        ⟨NativeF55GradedTransport.change arrow left right⟩⟩

/-- THE precise grade of any P71 relation is the difference of
the two genuinely chosen source shadows. A witness can be lifted
into Nonempty at that uniquely forced charge; Prop-to-Type choice
is neither postulated nor silently used. -/
theorem NativeF55HigherTransportRel.hasGradedLift_at_difference
    {f g : NativeF55HigherArrowOverClasses first last source target}
    (h : NativeF55HigherTransportRel first last source target f g) :
    Nonempty (NativeF55GradedTransport first last source target
      f g (g.raw.nativeShadow - f.raw.nativeShadow)) := by
  rcases h.hasGradedLift with ⟨c, ⟨w⟩⟩
  have hc : c = g.raw.nativeShadow - f.raw.nativeShadow := by
    rw [w.shadow_eq]
    abel
  rw [← hc]
  exact ⟨w⟩

/-- Exact Prop-level P71 kernel iff existence of a genuine Type-valued
graded transport, with the original F55 histories still present
inside any explicitly selected graded witness. -/
theorem nativeF55HigherTransport_iff_gradedLift
    (f g : NativeF55HigherArrowOverClasses first last source target) :
    NativeF55HigherTransportRel first last source target f g ↔
      ∃ charge : KuuNativeF55Shadow,
        Nonempty (NativeF55GradedTransport
          first last source target f g charge) := by
  constructor
  · intro h
    exact h.hasGradedLift
  · rintro ⟨charge, ⟨w⟩⟩
    exact w.forget

/-- A concrete PHYSICAL C60 witness: transported identity and original
identity have a genuine graded lift. Its signed square increment is
exactly +1 and odd parity is nonzero. This is not a quotient scalar
phase readout (forbidden by P71). -/
theorem northHexagonNativeIdentityTransport_graded_nonzero :
    ∃ charge : KuuNativeF55Shadow,
      Nonempty (NativeF55GradedTransport _ _ _ _
        northHexagonNativeIdentityHigherArrowOverClasses
        northHexagonNativeIdentityTransportedHigherArrow charge) ∧
      charge.1.2 = (1 : Int) ∧ charge.2 ≠ (0 : ZMod 2) := by
  let f := northHexagonNativeIdentityHigherArrowOverClasses
  let g := northHexagonNativeIdentityTransportedHigherArrow
  refine ⟨g.raw.nativeShadow - f.raw.nativeShadow,
    northHexagonNativeIdentityTransport_related.hasGradedLift_at_difference,
    ?_, ?_⟩
  · change g.raw.nativeShadow.1.2 -
        f.raw.nativeShadow.1.2 = (1 : Int)
    rw [northHexagonNativeIdentityTransportedHigherArrow_squareCharge_one,
      northHexagonNativeIdentityHigherArrow_squareCharge_zero]
    norm_num
  · change g.raw.nativeShadow.2 -
        f.raw.nativeShadow.2 ≠ (0 : ZMod 2)
    rw [northHexagonNativeIdentityHigherArrow_phase_zero]
    simpa using
      northHexagonNativeIdentityTransportedHigherArrow_phase_nonzero

#print axioms NativeF55GradedTransport
#print axioms NativeF55GradedTransport.shadow_eq
#print axioms NativeF55GradedTransport.grade_unique
#print axioms NativeF55GradedTransport.loop_grade_zero
#print axioms NativeF55GradedTransport.forget
#print axioms NativeF55HigherTransportRel.hasGradedLift
#print axioms NativeF55HigherTransportRel.hasGradedLift_at_difference
#print axioms nativeF55HigherTransport_iff_gradedLift
#print axioms northHexagonNativeIdentityTransport_graded_nonzero

end
end Kuu.F112.Physical
