import Kuu.F112.PolygonNativeC60AQFullPentagonPartitionLocalizeGlobal

/-!
# F112-P94D3EU — explicit local finite-rank critical pairs and history boundary

The ET local generators admit several genuinely different sequences
with identical endpoints. EU exhibits three concrete pairs:
* split three consecutive integer blocks via left or right bracketing;
* split two disjoint consecutive integer blocks in either order;
* create a leading rank-zero block by splitting 0+n or inserting zero.

Their C60 AQ group-equivariant actions are proved equal from the
genuine ES/ET coherence theorems. More decisively, the explicit
zero-insertion/deletion LOOP is PROVED DIFFERENT, as a Type-valued
raw path, from the reflexivity path, even though its evaluated action
is the identity on the real finite receiver and residual subgroup.

Thus no evidence-erasing proof irrelevance is assumed on original
Type-valued histories, nor is any unproved higher-dimensional filler
added. This is finite local algebraic coherence, not geometric 19D
coherence or Gray reconstruction. Preserve strict Kuu, independent Kuu,
DS no-go, 14D--18D evidence, 107 public roots, pinned Lean/mathlib,
append-only/same-root. No new axiom, sorry or admit.
Copyright Hidetoshi Itakura / 板倉英俊. Apache-2.0.
-/

namespace Kuu.F112.Physical

open CategoryTheory
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
noncomputable section

universe u

/-- First local three-block refinement: ((a+b)+c) → (a+b,c)
→ (a,b,c). The intermediate Type-valued local history is retained. -/
def nativeC60EUTripleSplitLeft (a b c : ℕ) :
    NativeC60ETLocalPath [a + b + c] [a,b,c] :=
  .step (.split [] [] (a+b) c)
    (.step (.split [] [c] a b) (.refl [a,b,c]))

/-- Second three-block refinement: (a+(b+c)) → (a,b+c)
→ (a,b,c), transporting only the proved natural-number
associativity at the rank-index level. -/
def nativeC60EUTripleSplitRight (a b c : ℕ) :
    NativeC60ETLocalPath [a + b + c] [a,b,c] := by
  have h : NativeC60ETLocalPath [a + (b+c)] [a,b,c] :=
    .step (.split [] [] a (b+c))
      (.step (.split [a] [] b c) (.refl [a,b,c]))
  simpa only [Nat.add_assoc] using h

/-- Disjoint refinements, first splitting a+b then c+d. -/
def nativeC60EUDisjointSplitLeft (a b c d : ℕ) :
    NativeC60ETLocalPath [a+b,c+d] [a,b,c,d] :=
  .step (.split [] [c+d] a b)
    (.step (.split [a,b] [] c d) (.refl [a,b,c,d]))

/-- Disjoint refinements in the opposite order. -/
def nativeC60EUDisjointSplitRight (a b c d : ℕ) :
    NativeC60ETLocalPath [a+b,c+d] [a,b,c,d] :=
  .step (.split [a+b] [] c d)
    (.step (.split [] [c,d] a b) (.refl [a,b,c,d]))

/-- A leading zero block can be generated by splitting the whole
rank n as 0+n. This is a different LOCAL raw generator from zero
insertion, but has the same ordered finite-rank endpoints. -/
def nativeC60EUZeroViaSplit (n : ℕ) :
    NativeC60ETLocalPath [n] [0,n] := by
  have h : NativeC60ETLocalPath [0+n] [0,n] :=
    .step (.split [] [] 0 n) (.refl [0,n])
  simpa only [zero_add] using h

/-- The same zero-block endpoint is obtained by the INDEPENDENT
explicit zero-insertion generator. -/
def nativeC60EUZeroViaInsert (n : ℕ) :
    NativeC60ETLocalPath [n] [0,n] :=
  .step (.insertZero [] [n]) (.refl [0,n])

/-- Nontrivial RAW history at the [] ↔ [0] boundary. It takes
two local moves, unlike the zero-step reflexivity witness. -/
def nativeC60EUZeroHistoryLoop : NativeC60ETLocalPath [] [] :=
  nativeC60ETLocalPath_trans nativeC60ETEmptyToZero
    (nativeC60ETLocalPath_reverse nativeC60ETEmptyToZero)

/-- EVIDENCE PRESERVATION: this genuine two-move Type-valued loop
is not the reflexive raw path. No use of quotienting, proof
irrelevance on paths, or equality of independent histories. -/
theorem nativeC60EUZeroHistoryLoop_ne_refl :
    nativeC60EUZeroHistoryLoop ≠
      (NativeC60ETLocalPath.refl []) := by
  intro h
  cases h

section GenuineC60AQLocalCriticalPairs

variable {L : NativeC60AXLayer.{u}}
variable (S : NativeC60AXSignature L) (F : Bool → NativeC60BCFrame L)

/-- Three-block local associativity diamond, proved as EQUALITY
OF GENUINE AQ ACTIONS, not equality of independent raw paths. -/
theorem nativeC60EUTripleSplit_action_coherent (word : List Bool)
    {x y : (nativeC60DQSeventeenLayer S F).Total}
    (r : (nativeC60DQTriangleSeventeenSignature S F).Gen x y)
    (start a b c : ℕ) :
    nativeC60ETLocalPathEquiv S F word start
        (nativeC60EUTripleSplitLeft a b c) =
      nativeC60ETLocalPathEquiv S F word start
        (nativeC60EUTripleSplitRight a b c) :=
  nativeC60ETLocalPathEquiv_independent S F word r start
    (nativeC60EUTripleSplitLeft a b c)
    (nativeC60EUTripleSplitRight a b c)

/-- Two disjoint local splits commute on the actual C60 AQ receiver
and residual kernel even though the Type-valued step order differs. -/
theorem nativeC60EUDisjointSplit_action_coherent (word : List Bool)
    {x y : (nativeC60DQSeventeenLayer S F).Total}
    (r : (nativeC60DQTriangleSeventeenSignature S F).Gen x y)
    (start a b c d : ℕ) :
    nativeC60ETLocalPathEquiv S F word start
        (nativeC60EUDisjointSplitLeft a b c d) =
      nativeC60ETLocalPathEquiv S F word start
        (nativeC60EUDisjointSplitRight a b c d) :=
  nativeC60ETLocalPathEquiv_independent S F word r start
    (nativeC60EUDisjointSplitLeft a b c d)
    (nativeC60EUDisjointSplitRight a b c d)

/-- Rank-zero split and rank-zero insertion agree on the real
C60 AQ INTEGER and RESIDUAL actions, not on their raw generators. -/
theorem nativeC60EUZeroSplitInsert_action_coherent (word : List Bool)
    {x y : (nativeC60DQSeventeenLayer S F).Total}
    (r : (nativeC60DQTriangleSeventeenSignature S F).Gen x y)
    (start n : ℕ) :
    nativeC60ETLocalPathEquiv S F word start
        (nativeC60EUZeroViaSplit n) =
      nativeC60ETLocalPathEquiv S F word start
        (nativeC60EUZeroViaInsert n) :=
  nativeC60ETLocalPathEquiv_independent S F word r start
    (nativeC60EUZeroViaSplit n)
    (nativeC60EUZeroViaInsert n)

/-- The explicit and RAWLY NONTRIVIAL [] -> [0] -> [] loop acts
as the identity on all finite AQ receiver coordinates AND on the
genuine residual subgroup. This does not erase the raw history. -/
theorem nativeC60EUZeroHistoryLoop_action_id (word : List Bool)
    {x y : (nativeC60DQSeventeenLayer S F).Total}
    (r : (nativeC60DQTriangleSeventeenSignature S F).Gen x y)
    (start : ℕ) :
    nativeC60ETLocalPathEquiv S F word start
        nativeC60EUZeroHistoryLoop =
      MulEquiv.refl
        (nativeC60EQChargeTower [] ×
          (nativeC60EBAbelianReceiver S F word (start + ([] : List ℕ).sum)).ker) :=
  nativeC60ETLocalPathEquiv_loop_id S F word r start []
    nativeC60EUZeroHistoryLoop

/-- Explicitly preserve both statements at once: the closed zero
history is a distinct Type-valued witness AND its physical C60 AQ
evaluation is identity. There is no claimed equality of histories. -/
theorem nativeC60EUZeroLoop_distinctButTrivialAction (word : List Bool)
    {x y : (nativeC60DQSeventeenLayer S F).Total}
    (r : (nativeC60DQTriangleSeventeenSignature S F).Gen x y)
    (start : ℕ) :
    nativeC60EUZeroHistoryLoop ≠ NativeC60ETLocalPath.refl [] ∧
    nativeC60ETLocalPathEquiv S F word start nativeC60EUZeroHistoryLoop =
      MulEquiv.refl
        (nativeC60EQChargeTower [] ×
          (nativeC60EBAbelianReceiver S F word
            (start + ([] : List ℕ).sum)).ker) :=
  ⟨nativeC60EUZeroHistoryLoop_ne_refl,
    nativeC60EUZeroHistoryLoop_action_id S F word r start⟩

end GenuineC60AQLocalCriticalPairs

