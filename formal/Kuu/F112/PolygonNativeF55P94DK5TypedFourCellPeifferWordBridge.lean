import Kuu.F112.PolygonNativeF55P94DK5TypedFourCellModThreeCongruence
import Mathlib.Tactic

/-!
# F112-P94D3W — genuinely typed four-cells to noncommutative Peiffer words

P94D3V constructed a Type-valued 4-cell grammar retaining ALL old
P94C2 four-cell proof terms, the genuine independent nine-face
pentagonator generator, symmetry, vertical composition, and
left/right source-typed 3-cell whiskerings. Its Z/3 soundness
is proved for every constructor.

Here connect EVERY proof-relevant 4-cell to the EXACT noncommutative
normal relation kernel generated by ALL old P94A typed four-cell
relators and the true independent N=3 pentagonator word. The
corrected nine-face word is shown universally INDEPENDENT of the
chosen five physical stages (it is the ordered actual P/N free word);
no arbitrary equality of original F54 route witnesses is inferred.

For every newly defined source 4-cell F => G prove that the full,
NONABELIAN relator F.word - G.word belongs to the normal closure.
Then define its canonical Peiffer relation-module witness, show
that left vertical 3-cell whiskering corresponds EXACTLY to normal
conjugation while right whiskering preserves the relator, and lift
the complete ordered word to the actual Type-valued four-cell
quotient from P94D3V.

This proves an authentic boundary/Peiffer WORD bridge with typed
source evidence; it does NOT prove horizontal 4-cell interchange,
strict 3/n coherence, original P92B descent, or Kuu hyperdescent.
No Gray, sorry/admit, added logical axiom, or C60/root deletion.
-/

namespace Kuu.F112.Physical

open CategoryTheory
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
noncomputable section

universe uD vD uE vE
variable {D : Type uD} [Category.{vD} D]
variable {E : Type uE} [Category.{vE} E]

/-- The noncommutative free P/N word of the ACTUAL reoriented K5
nine-face cycle, independent of its five original F45 stage terms.
The double-negative square2 is kept syntactically explicit. -/
def nativeK5UniversalReorientedWord : NativeF55P94CWord :=
  (-nativeK5PNPentagon) + nativeK5PNNaturality +
  (-nativeK5PNPentagon) + (-nativeK5PNPentagon) +
  nativeK5PNNaturality + nativeK5PNPentagon +
  nativeK5PNPentagon + (-(-nativeK5PNNaturality)) +
  nativeK5PNPentagon

section FiveNativeStages

variable {p : Polygon} {a b : D} {x y : E}
variable {n₁ n₂ n₃ n₄ n₅ m₁ m₂ m₃ m₄ m₅ : Nat}
variable {p₀ p₁ p₂ p₃ p₄ p₅ : KuuNativeBlocks a b}
variable {q₀ q₁ q₂ q₃ q₄ q₅ : KuuNativeBlocks x y}
variable
  (t1 : KuuNativeF45Tree p n₁ m₁ p₀ q₀ p₁ q₁)
  (t2 : KuuNativeF45Tree p n₂ m₂ p₁ q₁ p₂ q₂)
  (t3 : KuuNativeF45Tree p n₃ m₃ p₂ q₂ p₃ q₃)
  (t4 : KuuNativeF45Tree p n₄ m₄ p₃ q₃ p₄ q₄)
  (t5 : KuuNativeF45Tree p n₅ m₅ p₄ q₄ p₅ q₅)

/-- The real typed nine-face source word is literally this same
universally ordered NONCOMMUTATIVE word at ALL original F45 depths. -/
theorem nativeK5NineReorientedWord_universal :
    nativeK5NineReorientedWord t1 t2 t3 t4 t5 =
      nativeK5UniversalReorientedWord := by
  rfl

end FiveNativeStages

/-- ONE global exact algebraic relation kernel for ALL stage-indexed
genuinely typed pentagonators plus every previous typed P94A relator.
No stage-dependent 4-cell relation is removed or commuted. -/
abbrev nativeK5UniversalPentagonatorKernel :
    AddSubgroup NativeF55P94CWord :=
  nativeK5PentagonatorWordNormalClosure D E
    nativeK5UniversalReorientedWord

instance nativeK5UniversalPentagonatorKernel_normal :
    (nativeK5UniversalPentagonatorKernel (D := D) (E := E)).Normal := by
  unfold nativeK5UniversalPentagonatorKernel
  infer_instance

/-- Its inclusion into the full noncommutative word group is the
faithful algebraic Peiffer boundary map. -/
def nativeK5UniversalPeifferBoundary :
    nativeK5UniversalPentagonatorKernel (D := D) (E := E) →+
      NativeF55P94CWord :=
  (nativeK5UniversalPentagonatorKernel (D := D) (E := E)).subtype

/-- The noncommutative Peiffer conjugation action of any original
3-cell word on the universal independent four-relator kernel. -/
def nativeK5UniversalPeifferAct
    (prior : NativeF55P94CWord)
    (r : nativeK5UniversalPentagonatorKernel (D := D) (E := E)) :
    nativeK5UniversalPentagonatorKernel (D := D) (E := E) :=
  ⟨prior + (r : NativeF55P94CWord) - prior, by
    have h : prior + (r : NativeF55P94CWord) + -prior ∈
        nativeK5UniversalPentagonatorKernel (D := D) (E := E) :=
      (inferInstance :
        (nativeK5UniversalPentagonatorKernel (D := D) (E := E)).Normal).conj_mem
        (r : NativeF55P94CWord) r.property prior
    simpa only [sub_eq_add_neg] using h⟩

/-- Exact universal Peiffer boundary equivariance. -/
theorem nativeK5UniversalPeifferBoundary_equivariant
    (prior : NativeF55P94CWord)
    (r : nativeK5UniversalPentagonatorKernel (D := D) (E := E)) :
    nativeK5UniversalPeifferBoundary
      (nativeK5UniversalPeifferAct prior r) =
      prior + nativeK5UniversalPeifferBoundary r - prior := rfl

/-- Exact UNIVERSAL noncommutative algebraic Peiffer identity,
without asserting new higher Type-valued interchange equations. -/
theorem nativeK5UniversalPeiffer_identity
    (r s : nativeK5UniversalPentagonatorKernel (D := D) (E := E)) :
    nativeK5UniversalPeifferAct
      (nativeK5UniversalPeifferBoundary r) s =
      r + s - r := by
  apply Subtype.ext
  rfl

/-- EVERY genuine Type-valued 4-cell witness from the distinct
completion of D3V has a true noncommutative Peiffer word-relator
in the exact universal kernel. Induction checks ALL constructors.
The left-whisker step uses NORMALITY (conjugation), not
commutativity of original source words. -/
theorem NativeK5StructuralFourCell.wordRelator_mem
    {p : Polygon} {a b : D} {x y : E} {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b} {pa pb : KuuNativeBlocks x y}
    {first : KuuNativeF45Tree p n m ma pa mb pb}
    {last : KuuNativeF45Tree p n' m' ma pa mb pb}
    {r s : KuuNativeF45Tree.DepthRotationRoute p first last}
    {f g : NativeF55StructuralComparison p r s}
    (w : NativeK5StructuralFourCell p f g) :
    f.p94cGroupWord - g.p94cGroupWord ∈
      nativeK5UniversalPentagonatorKernel (D := D) (E := E) := by
  induction w with
  | old witness =>
      exact nativeK5P94ATyped_le_pentagonatorKernel
        (D := D) (E := E) nativeK5UniversalReorientedWord
        witness.p94aTypedRelator_mem
  | pentagonator t1 t2 t3 t4 t5 witness =>
      cases witness
      change (nativeK5NineReorientedExtendedCycle t1 t2 t3 t4 t5).p94cGroupWord -
        (nativeK5ReorientedStructuralIdentity t1 t2 t3 t4 t5).p94cGroupWord ∈
          nativeK5UniversalPentagonatorKernel (D := D) (E := E)
      rw [nativeK5NineReorientedExtendedCycle_word,
        nativeK5NineReorientedWord_universal]
      change nativeK5UniversalReorientedWord - 0 ∈
        nativeK5UniversalPentagonatorKernel (D := D) (E := E)
      simpa using nativeK5PentagonatorWord_mem
        (D := D) (E := E) nativeK5UniversalReorientedWord
  | refl f =>
      change f.p94cGroupWord - f.p94cGroupWord ∈
        nativeK5UniversalPentagonatorKernel (D := D) (E := E)
      simp
  | symm witness ih =>
      have hn := (nativeK5UniversalPentagonatorKernel
        (D := D) (E := E)).neg_mem ih
      simpa [sub_eq_add_neg, neg_add_rev] using hn
  | trans left right ihLeft ihRight =>
      have ht := (nativeK5UniversalPentagonatorKernel
        (D := D) (E := E)).add_mem ihLeft ihRight
      simpa [sub_eq_add_neg, add_assoc] using ht
  | precompose prior witness ih =>
      have hc :
          prior.p94cGroupWord +
            (_ : NativeF55P94CWord) - prior.p94cGroupWord ∈
            nativeK5UniversalPentagonatorKernel (D := D) (E := E) := by
        exact (inferInstance :
          (nativeK5UniversalPentagonatorKernel (D := D) (E := E)).Normal).conj_mem
          _ ih prior.p94cGroupWord
      simpa [NativeF55StructuralComparison.p94cGroupWord,
        sub_eq_add_neg, neg_add_rev, add_assoc] using hc
  | postcompose witness suffix ih =>
      simpa [NativeF55StructuralComparison.p94cGroupWord,
        sub_eq_add_neg, neg_add_rev, add_assoc] using ih

/-- The genuine proof-relevant 4-cell itself supplies the exact
algebraic relation MODULE witness, with no arbitrary group lift. -/
def NativeK5StructuralFourCell.toUniversalPeifferRelator
    {p : Polygon} {a b : D} {x y : E} {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b} {pa pb : KuuNativeBlocks x y}
    {first : KuuNativeF45Tree p n m ma pa mb pb}
    {last : KuuNativeF45Tree p n' m' ma pa mb pb}
    {r s : KuuNativeF45Tree.DepthRotationRoute p first last}
    {f g : NativeF55StructuralComparison p r s}
    (w : NativeK5StructuralFourCell p f g) :
    nativeK5UniversalPentagonatorKernel (D := D) (E := E) :=
  ⟨f.p94cGroupWord - g.p94cGroupWord, w.wordRelator_mem⟩

theorem NativeK5StructuralFourCell.toUniversalPeifferRelator_boundary
    {p : Polygon} {a b : D} {x y : E} {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b} {pa pb : KuuNativeBlocks x y}
    {first : KuuNativeF45Tree p n m ma pa mb pb}
    {last : KuuNativeF45Tree p n' m' ma pa mb pb}
    {r s : KuuNativeF45Tree.DepthRotationRoute p first last}
    {f g : NativeF55StructuralComparison p r s}
    (w : NativeK5StructuralFourCell p f g) :
    nativeK5UniversalPeifferBoundary w.toUniversalPeifferRelator =
      f.p94cGroupWord - g.p94cGroupWord := rfl

/-- LEFT typed vertical 3-cell whiskering is EXACTLY the Peiffer
conjugation action of its full noncommutative P/N word. -/
theorem NativeK5StructuralFourCell.precompose_relator_transport
    {p : Polygon} {a b : D} {x y : E} {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b} {pa pb : KuuNativeBlocks x y}
    {first : KuuNativeF45Tree p n m ma pa mb pb}
    {last : KuuNativeF45Tree p n' m' ma pa mb pb}
    {r s t : KuuNativeF45Tree.DepthRotationRoute p first last}
    (prior : NativeF55StructuralComparison p r s)
    {f g : NativeF55StructuralComparison p s t}
    (w : NativeK5StructuralFourCell p f g) :
    (NativeK5StructuralFourCell.precompose prior w).toUniversalPeifferRelator =
      nativeK5UniversalPeifferAct prior.p94cGroupWord
        w.toUniversalPeifferRelator := by
  apply Subtype.ext
  change (prior.p94cGroupWord + f.p94cGroupWord) -
      (prior.p94cGroupWord + g.p94cGroupWord) =
    prior.p94cGroupWord + (f.p94cGroupWord - g.p94cGroupWord) -
      prior.p94cGroupWord
  simp [sub_eq_add_neg, neg_add_rev, add_assoc]

/-- RIGHT typed vertical 3-cell whiskering keeps the full
noncommutative word-relator, not merely its abelian N charge. -/
theorem NativeK5StructuralFourCell.postcompose_relator_transport
    {p : Polygon} {a b : D} {x y : E} {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b} {pa pb : KuuNativeBlocks x y}
    {first : KuuNativeF45Tree p n m ma pa mb pb}
    {last : KuuNativeF45Tree p n' m' ma pa mb pb}
    {r s t : KuuNativeF45Tree.DepthRotationRoute p first last}
    {f g : NativeF55StructuralComparison p r s}
    (w : NativeK5StructuralFourCell p f g)
    (suffix : NativeF55StructuralComparison p s t) :
    (NativeK5StructuralFourCell.postcompose w suffix).toUniversalPeifferRelator =
      w.toUniversalPeifferRelator := by
  apply Subtype.ext
  change (f.p94cGroupWord + suffix.p94cGroupWord) -
      (g.p94cGroupWord + suffix.p94cGroupWord) =
    f.p94cGroupWord - g.p94cGroupWord
  simp [sub_eq_add_neg, neg_add_rev, add_assoc]

/-- The complete exact ordered P/N group word descends through
the NEW genuine Type-valued four-cell setoid of P94D3V into the
universal full noncommutative Peiffer quotient. -/
abbrev NativeK5UniversalWordQuotient :=
  NativeF55P94CWord ⧸
    nativeK5UniversalPentagonatorKernel (D := D) (E := E)

def nativeK5UniversalWordClass :
    NativeF55P94CWord →+ NativeK5UniversalWordQuotient (D := D) (E := E) :=
  QuotientAddGroup.mk'
    (nativeK5UniversalPentagonatorKernel (D := D) (E := E))

def nativeK5StructuralFourCellWordDescend
    {p : Polygon} {a b : D} {x y : E} {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b} {pa pb : KuuNativeBlocks x y}
    {first : KuuNativeF45Tree p n m ma pa mb pb}
    {last : KuuNativeF45Tree p n' m' ma pa mb pb}
    {r s : KuuNativeF45Tree.DepthRotationRoute p first last} :
    Quotient (NativeK5StructuralFourCell.setoid (r := r) (s := s)) →
      NativeK5UniversalWordQuotient (D := D) (E := E) :=
  Quotient.lift
    (fun f : NativeF55StructuralComparison p r s =>
      nativeK5UniversalWordClass (D := D) (E := E) f.p94cGroupWord)
    (by
      intro f g h
      rcases h with ⟨w⟩
      exact (QuotientAddGroup.eq_iff_sub_mem).2 w.wordRelator_mem)

