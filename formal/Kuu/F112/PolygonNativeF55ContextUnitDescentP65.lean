import Kuu.F112.PolygonNativeF55StructuralUnitQuotientP64

/-!
# F112-P65 — exact typed descent of independent F55 context actions

P62's structural-unit path relation is generated by genuine proof-relevant
identity-only raw F55 syntax, not by equality in the selected numerical shadow.
P63 gives two raw-path functors formed from the original left and right F54
contexts, and P64 builds the minimal quotient category with an exact kernel.

This file verifies the previously open descent obligation:
  (1) every P59-normalized identity-only raw cell is a path word consisting
      only of actual identity-only raw generators;
  (2) every such typed word is a loop equivalent to nil under P62;
  (3) both P63 context functors preserve the word predicate;
  (4) hence both context functors preserve ALL FIVE constructors of P62
      relation (including a general structuralUnit generator);
  (5) Mathlib's quotient universal property provides the two descended
      functors and exact commutative factorization on original raw paths.

All proofs concern ORIGINAL typed F54 routes and ORIGINAL raw F55 cells, at
arbitrary two-axis Nat depths. No raw term is equated merely because the
chosen (Z x Z) x ZMod 2 observer agrees. Actual C60 pentagon and disjoint
square generators are never classified as identity-only.

This is vertical context descent, NOT a proof of horizontal pasting's
interchange, associativity or global strict 3/n-categories.
No Gray, new axiom, sorry or admit.
-/

namespace Kuu.F112.Physical

open CategoryTheory
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
noncomputable section

universe uD vD uE vE
variable {D : Type uD} [Category.{vD} D]
variable {E : Type uE} [Category.{vE} E]

/-- A purely proof-relevant word of original F55 edges, each carrying
an explicit witness of P62's identity-only syntactic criterion AND
an atomic-normalization certificate (P59 leaves this generator as one
edge). This extra condition is ESSENTIAL: a raw ident constructor is
a singleton source generator but normalizes to nil, so P62 never erases
its original singleton raw path indiscriminately.
Neither shadow zero nor the numerical observer is used.
The path grammar is typed over the ORIGINAL double-Nat F54 route vertices. -/
inductive NativeF55UnitWord
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb) :
    ∀ {r s : NativeF55RawRouteVertex first last},
      Quiver.Path r s → Prop where
  | nil (r : NativeF55RawRouteVertex first last) :
      NativeF55UnitWord first last (Quiver.Path.nil : Quiver.Path r r)
  | generator
      {u v : KuuNativeF45Tree.DepthRotationRoute p first last}
      (cell : KuuNativeF45Tree.DepthRotationRoute.PresentedCell p u v)
      (h : cell.unitOnly = true)
      (hAtomic : cell.toNativeStrictPath = cell.toNativeRawEdge.toPath) :
      NativeF55UnitWord first last cell.toNativeRawEdge.toPath
  | comp
      {r s t : NativeF55RawRouteVertex first last}
      {f : Quiver.Path r s} {g : Quiver.Path s t}
      (hf : NativeF55UnitWord first last f)
      (hg : NativeF55UnitWord first last g) :
      NativeF55UnitWord first last (f.comp g)

/-- For ALL nine proof constructors, unit-only syntax has a
normal form in the certified, atomically normalized unit-generator
WORD grammar. Raw ident maps directly to nil and raw trans is
flattened; neither is falsely declared an erasable raw singleton.
The vertical trans node is replaced by actual path concatenation;
the seven other constructors remain their original typed generators. -/
theorem KuuNativeF45Tree.DepthRotationRoute.PresentedCell.unitOnly_normalized_word
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    {first : KuuNativeF45Tree p n m ma pa mb pb}
    {last : KuuNativeF45Tree p n' m' ma pa mb pb} :
    ∀ {u v : KuuNativeF45Tree.DepthRotationRoute p first last}
      (cell : KuuNativeF45Tree.DepthRotationRoute.PresentedCell p u v),
      cell.unitOnly = true →
      NativeF55UnitWord first last cell.toNativeStrictPath
  | _, _, .ident route, _ => .nil ⟨route⟩
  | _, _, .pentagon _ _ _ _, h => by cases h
  | _, _, .disjointSquare _ _, h => by cases h
  | _, _, .symm cell, h => .generator (.symm cell) h rfl
  | _, _, .trans left right, h =>
      .comp (left.unitOnly_normalized_word (Bool.and_elim_left h))
        (right.unitOnly_normalized_word (Bool.and_elim_right h))
  | _, _, .leftContext cell later, h =>
      .generator (.leftContext cell later) h rfl
  | _, _, .rightContext earlier cell, h =>
      .generator (.rightContext earlier cell) h rfl
  | _, _, .precompose prior cell, h =>
      .generator (.precompose prior cell) h rfl
  | _, _, .postcompose cell suffix, h =>
      .generator (.postcompose cell suffix) h rfl

/-- Every unit-generated word has identical endpoints AND is related
to the genuine categorical unit in P62's original path congruence.
The equality of endpoints follows recursively from ORIGINAL proof
syntax (P63), not from a vanishing numerical phase. -/
theorem NativeF55UnitWord.related_nil
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    {first : KuuNativeF45Tree p n m ma pa mb pb}
    {last : KuuNativeF45Tree p n' m' ma pa mb pb}
    {r s : NativeF55RawRouteVertex first last}
    {path : Quiver.Path r s}
    (h : NativeF55UnitWord first last path) :
    ∃ eqv : r = s,
      NativeF55UnitPathRel first last (eqv ▸ path)
        (Quiver.Path.nil : Quiver.Path s s) := by
  induction h with
  | nil r =>
      exact ⟨rfl, .refl _⟩
  | generator cell hc hAtomic =>
      have heq := cell.unitOnly_endpoints hc
      cases heq
      refine ⟨rfl, ?_⟩
      simpa only [hAtomic] using
        (NativeF55UnitPathRel.structuralUnit _ cell hc)
  | comp hf hg ihf ihg =>
      rcases ihf with ⟨heq₁, h₁⟩
      rcases ihg with ⟨heq₂, h₂⟩
      cases heq₁
      cases heq₂
      refine ⟨rfl, ?_⟩
      simpa only [Quiver.Path.nil_comp] using
        (NativeF55UnitPathRel.comp h₁ h₂)

/-- The exact left contextual raw free-path functor preserves the
whole unit-generator WORD presentation, not merely a raw identity. -/
theorem nativeF55LeftContextPathFunctor_unitWord
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' k l : Nat}
    {ma mb mc : KuuNativeBlocks a b}
    {pa pb pc : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb)
    (later : KuuNativeF45Tree p k l mb pb mc pc)
    {r s : NativeF55RawRouteVertex first last}
    {path : Quiver.Path r s}
    (h : NativeF55UnitWord first last path) :
    NativeF55UnitWord
      (KuuNativeF45Tree.node first later)
      (KuuNativeF45Tree.node last later)
      ((nativeF55LeftContextPathFunctor first last later).map path) := by
  induction h with
  | nil r =>
      simpa only [Functor.map_id] using
        (NativeF55UnitWord.nil
          ((nativeF55LeftContextPathFunctor first last later).obj r))
  | generator cell hc hAtomic =>
      rw [nativeF55LeftContextPathFunctor_map_raw]
      exact .generator (.leftContext cell later)
        (by simpa only [KuuNativeF45Tree.DepthRotationRoute.PresentedCell.unitOnly_leftContext]
              using hc) rfl
  | comp hf hg ihf ihg =>
      rw [nativeF55LeftContextPathFunctor_map_comp]
      exact .comp ihf ihg

/-- The other genuine source-axis context has the same property,
without exchanging the two original F54 categorical axes. -/
theorem nativeF55RightContextPathFunctor_unitWord
    {p : Polygon} {a b : D} {x y : E}
    {k l n n' m m' : Nat}
    {ma mb mc : KuuNativeBlocks a b}
    {pa pb pc : KuuNativeBlocks x y}
    (earlier : KuuNativeF45Tree p k l ma pa mb pb)
    (first : KuuNativeF45Tree p n m mb pb mc pc)
    (last : KuuNativeF45Tree p n' m' mb pb mc pc)
    {r s : NativeF55RawRouteVertex first last}
    {path : Quiver.Path r s}
    (h : NativeF55UnitWord first last path) :
    NativeF55UnitWord
      (KuuNativeF45Tree.node earlier first)
      (KuuNativeF45Tree.node earlier last)
      ((nativeF55RightContextPathFunctor earlier first last).map path) := by
  induction h with
  | nil r =>
      simpa only [Functor.map_id] using
        (NativeF55UnitWord.nil
          ((nativeF55RightContextPathFunctor earlier first last).obj r))
  | generator cell hc hAtomic =>
      rw [nativeF55RightContextPathFunctor_map_raw]
      exact .generator (.rightContext earlier cell)
        (by simpa only [KuuNativeF45Tree.DepthRotationRoute.PresentedCell.unitOnly_rightContext]
              using hc) rfl
  | comp hf hg ihf ihg =>
      rw [nativeF55RightContextPathFunctor_map_comp]
      exact .comp ihf ihg

/-- FULL five-constructor preservation of P62's precise typed
identity-generated congruence under arbitrary LEFT context. In
particular, the structuralUnit case uses the whole native F55
nine-constructor recursion and NOT equality of shadow evaluations. -/
theorem nativeF55LeftContextPathFunctor_preserves_unitRel
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' k l : Nat}
    {ma mb mc : KuuNativeBlocks a b}
    {pa pb pc : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb)
    (later : KuuNativeF45Tree p k l mb pb mc pc)
    {r s : NativeF55RawRouteVertex first last}
    {f g : Quiver.Path r s}
    (h : NativeF55UnitPathRel first last f g) :
    NativeF55UnitPathRel
      (KuuNativeF45Tree.node first later)
      (KuuNativeF45Tree.node last later)
      ((nativeF55LeftContextPathFunctor first last later).map f)
      ((nativeF55LeftContextPathFunctor first last later).map g) := by
  induction h with
  | refl path => exact .refl _
  | symm h ih => exact .symm ih
  | trans hfg hgh ihfg ihgh => exact .trans ihfg ihgh
  | comp hf hg ihf ihg =>
      rw [nativeF55LeftContextPathFunctor_map_comp,
          nativeF55LeftContextPathFunctor_map_comp]
      exact .comp ihf ihg
  | structuralUnit route cell hc =>
      have hw : NativeF55UnitWord first last cell.toNativeStrictPath :=
        cell.unitOnly_normalized_word hc
      have hm := nativeF55LeftContextPathFunctor_unitWord first last later hw
      rcases hm.related_nil with ⟨heq, hnil⟩
      cases heq
      simpa only [Functor.map_id] using hnil

/-- The same complete preservation for the RIGHT contextual action,
including arbitrary composites of original identity-only raw cells. -/
theorem nativeF55RightContextPathFunctor_preserves_unitRel
    {p : Polygon} {a b : D} {x y : E}
    {k l n n' m m' : Nat}
    {ma mb mc : KuuNativeBlocks a b}
    {pa pb pc : KuuNativeBlocks x y}
    (earlier : KuuNativeF45Tree p k l ma pa mb pb)
    (first : KuuNativeF45Tree p n m mb pb mc pc)
    (last : KuuNativeF45Tree p n' m' mb pb mc pc)
    {r s : NativeF55RawRouteVertex first last}
    {f g : Quiver.Path r s}
    (h : NativeF55UnitPathRel first last f g) :
    NativeF55UnitPathRel
      (KuuNativeF45Tree.node earlier first)
      (KuuNativeF45Tree.node earlier last)
      ((nativeF55RightContextPathFunctor earlier first last).map f)
      ((nativeF55RightContextPathFunctor earlier first last).map g) := by
  induction h with
  | refl path => exact .refl _
  | symm h ih => exact .symm ih
  | trans hfg hgh ihfg ihgh => exact .trans ihfg ihgh
  | comp hf hg ihf ihg =>
      rw [nativeF55RightContextPathFunctor_map_comp,
          nativeF55RightContextPathFunctor_map_comp]
      exact .comp ihf ihg
  | structuralUnit route cell hc =>
      have hw : NativeF55UnitWord first last cell.toNativeStrictPath :=
        cell.unitOnly_normalized_word hc
      have hm := nativeF55RightContextPathFunctor_unitWord earlier first last hw
      rcases hm.related_nil with ⟨heq, hnil⟩
      cases heq
      simpa only [Functor.map_id] using hnil

/-- Left contextual action DESCENDS to P64's actual minimal
proof-sensitive quotient category. No shadow-kernel quotient is used. -/
def nativeF55LeftContextStructuralUnitFunctor
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' k l : Nat}
    {ma mb mc : KuuNativeBlocks a b}
    {pa pb pc : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb)
    (later : KuuNativeF45Tree p k l mb pb mc pc) :
    NativeF55StructuralUnitCategory first last ⥤
      NativeF55StructuralUnitCategory
        (KuuNativeF45Tree.node first later)
        (KuuNativeF45Tree.node last later) :=
  CategoryTheory.Quotient.lift
    (nativeF55StructuralUnitHomRel first last)
    (nativeF55LeftContextPathFunctor first last later ⋙
      nativeF55StructuralUnitQuotientFunctor
        (KuuNativeF45Tree.node first later)
        (KuuNativeF45Tree.node last later))
    (by
      intro r s f g h
      apply (nativeF55StructuralUnitQuotient_map_eq_iff
        (KuuNativeF45Tree.node first later)
        (KuuNativeF45Tree.node last later) _ _).2
      exact nativeF55LeftContextPathFunctor_preserves_unitRel
        first last later h)

/-- The right context also genuinely DESCENDS, at arbitrary
dependent F54 depths, as a second independent ordinary functor. -/
def nativeF55RightContextStructuralUnitFunctor
    {p : Polygon} {a b : D} {x y : E}
    {k l n n' m m' : Nat}
    {ma mb mc : KuuNativeBlocks a b}
    {pa pb pc : KuuNativeBlocks x y}
    (earlier : KuuNativeF45Tree p k l ma pa mb pb)
    (first : KuuNativeF45Tree p n m mb pb mc pc)
    (last : KuuNativeF45Tree p n' m' mb pb mc pc) :
    NativeF55StructuralUnitCategory first last ⥤
      NativeF55StructuralUnitCategory
        (KuuNativeF45Tree.node earlier first)
        (KuuNativeF45Tree.node earlier last) :=
  CategoryTheory.Quotient.lift
    (nativeF55StructuralUnitHomRel first last)
    (nativeF55RightContextPathFunctor earlier first last ⋙
      nativeF55StructuralUnitQuotientFunctor
        (KuuNativeF45Tree.node earlier first)
        (KuuNativeF45Tree.node earlier last))
    (by
      intro r s f g h
      apply (nativeF55StructuralUnitQuotient_map_eq_iff
        (KuuNativeF45Tree.node earlier first)
        (KuuNativeF45Tree.node earlier last) _ _).2
      exact nativeF55RightContextPathFunctor_preserves_unitRel
        earlier first last h)

/-- Exact LEFT quotient compatibility: first take the true raw F54
context, then quotient; or first quotient by P62, then take the new
descended context. Both constructions are equal as Mathlib functors. -/
theorem nativeF55LeftContextStructuralUnitFunctor_factor
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' k l : Nat}
    {ma mb mc : KuuNativeBlocks a b}
    {pa pb pc : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb)
    (later : KuuNativeF45Tree p k l mb pb mc pc) :
    nativeF55StructuralUnitQuotientFunctor first last ⋙
      nativeF55LeftContextStructuralUnitFunctor first last later =
    nativeF55LeftContextPathFunctor first last later ⋙
      nativeF55StructuralUnitQuotientFunctor
        (KuuNativeF45Tree.node first later)
        (KuuNativeF45Tree.node last later) := by
  exact CategoryTheory.Quotient.lift_spec
    (nativeF55StructuralUnitHomRel first last)
    (nativeF55LeftContextPathFunctor first last later ⋙
      nativeF55StructuralUnitQuotientFunctor
        (KuuNativeF45Tree.node first later)
        (KuuNativeF45Tree.node last later))
    (by
      intro r s f g h
      apply (nativeF55StructuralUnitQuotient_map_eq_iff
        (KuuNativeF45Tree.node first later)
        (KuuNativeF45Tree.node last later) _ _).2
      exact nativeF55LeftContextPathFunctor_preserves_unitRel
        first last later h)

/-- The analogous exact RIGHT context factorization, without
identifying source histories via the numerical shadow observation. -/
theorem nativeF55RightContextStructuralUnitFunctor_factor
    {p : Polygon} {a b : D} {x y : E}
    {k l n n' m m' : Nat}
    {ma mb mc : KuuNativeBlocks a b}
    {pa pb pc : KuuNativeBlocks x y}
    (earlier : KuuNativeF45Tree p k l ma pa mb pb)
    (first : KuuNativeF45Tree p n m mb pb mc pc)
    (last : KuuNativeF45Tree p n' m' mb pb mc pc) :
    nativeF55StructuralUnitQuotientFunctor first last ⋙
      nativeF55RightContextStructuralUnitFunctor earlier first last =
    nativeF55RightContextPathFunctor earlier first last ⋙
      nativeF55StructuralUnitQuotientFunctor
        (KuuNativeF45Tree.node earlier first)
        (KuuNativeF45Tree.node earlier last) := by
  exact CategoryTheory.Quotient.lift_spec
    (nativeF55StructuralUnitHomRel first last)
    (nativeF55RightContextPathFunctor earlier first last ⋙
      nativeF55StructuralUnitQuotientFunctor
        (KuuNativeF45Tree.node earlier first)
        (KuuNativeF45Tree.node earlier last))
    (by
      intro r s f g h
      apply (nativeF55StructuralUnitQuotient_map_eq_iff
        (KuuNativeF45Tree.node earlier first)
        (KuuNativeF45Tree.node earlier last) _ _).2
      exact nativeF55RightContextPathFunctor_preserves_unitRel
        earlier first last h)

