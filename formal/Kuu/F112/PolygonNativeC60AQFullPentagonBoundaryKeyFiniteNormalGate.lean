import Kuu.F112.PolygonNativeC60AQFullPentagonRecursiveSpineKernelLocalization

/-!
# F112-P94D3FS — original dependent boundary-key localization
# and conditionally finite rooted normal generators

FR identified every genuine 18D full DV collision by its complete
ordered post/pre/.../assoc recursion spine, while retaining raw
dependent original 17D source/target witnesses. FS tightens the
localization by also recording the ACTUAL transported source and
target original 18D objects (which contain 17D raw paths) and
actual post/pre transported full INNER dependent 18D codes.

Key equality is a necessary collision condition: we do NOT
silently assert that equal partial observation keys imply identical
whole generator codes. Their unequal values give a real
noncommutative two-letter kernel obstruction. All collisions and
rooted normal relations can be grouped by this finer key in the
same ORIGINAL noncommutative full free group. Receiver descent
to the ACTUAL image is characterized by compatibility within
every true boundary-key fiber.

Separately, for arbitrary f : A → B, FO/FQ's exact kernel is
normally generated by the rooted two-letter relations. FS proves
that one can discard every identity relation a=root_f(a) and
still get EXACTLY the WHOLE kernel. A finite set of non-root
source letters SUFFICES for finite normal generation. In
particular a finite source alphabet suffices. No assertion of
finite generation for genuine full 18D physical code types is
made without proving their active support is finite, nor a
claim of irredundance, minimal normal rank or the one-FJ-defect
presentation. No geometric original 19D filler, new Gray,
global strict n-category or hyperdescent.

Preserve all original 14D–18D evidence and history, DS old
no-go, FJ nonfaithfulness / separate FK–FM faithfulness,
107 public roots, strict Kuu primary / independent Kuu
presentation, pinned Lean/mathlib and append-only operation.
No new axioms, sorry or admit.
Copyright Hidetoshi Itakura / 板倉英俊. Apache-2.0.
-/

namespace Kuu.F112.Physical

open CategoryTheory
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
noncomputable section

universe u v

section ActiveRootedRelations

/-- A complete original free-letter difference against the
actual chosen representative of its f-image fiber. -/
def nativeC60FSRootedRelator
    {A : Type u} {B : Type v} (f : A → B) (a : A) : FreeGroup A :=
  FreeGroup.of a * (FreeGroup.of (nativeC60FQLetterRoot f a))⁻¹

/-- Only source letters that are NOT their own selected fiber roots.
No finite-source or decidable equality requirement. -/
def nativeC60FSActiveLetters
    {A : Type u} {B : Type v} (f : A → B) : Set A :=
  {a | a ≠ nativeC60FQLetterRoot f a}

/-- Actual nontrivial rooted relators, not merely the original
generating pair family with redundant identity pairs. -/
def nativeC60FSActiveRelators
    {A : Type u} {B : Type v} (f : A → B) : Set (FreeGroup A) :=
  Set.image (nativeC60FSRootedRelator f)
    (nativeC60FSActiveLetters f)

/-- Every non-root letter gives its exact original ordered signed
two-letter relation in the active generating family. -/
theorem nativeC60FSActiveRelator_mem
    {A : Type u} {B : Type v} (f : A → B)
    (a : A) (ha : a ∈ nativeC60FSActiveLetters f) :
    nativeC60FSRootedRelator f a ∈ nativeC60FSActiveRelators f :=
  ⟨a, ha, rfl⟩

/-- Tighten the FQ presentation: all original per-letter rooted
relations corresponding to a=root(a) are identity and may be
deleted WITHOUT changing the least normal subgroup. -/
theorem nativeC60FSRootedNormalClosure_eq_active
    {A : Type u} {B : Type v} (f : A → B) :
    nativeC60FQRootedNormalClosure f =
      Subgroup.normalClosure (nativeC60FSActiveRelators f) := by
  classical
  apply le_antisymm
  · apply (nativeC60DTNormalClosure_le_iff
      (nativeC60FQRootedPairs f)
      (Subgroup.normalClosure (nativeC60FSActiveRelators f))).mpr
    rintro p ⟨a, rfl⟩
    by_cases ha : a = nativeC60FQLetterRoot f a
    · have hunit :
        FreeGroup.of a * (FreeGroup.of (nativeC60FQLetterRoot f a))⁻¹ =
          (1 : FreeGroup A) := by
            rw [← ha, mul_inv_cancel]
      rw [hunit]
      exact (Subgroup.normalClosure (nativeC60FSActiveRelators f)).one_mem
    · exact Subgroup.subset_normalClosure
        (nativeC60FSActiveRelator_mem f a ha)
  · apply Subgroup.normalClosure_le_normal
    rintro x ⟨a, ha, rfl⟩
    exact nativeC60FQRootedDefect_mem f a

/-- Generic FREE-GROUP kernel has an exact normal presentation on
only the genuinely non-root source-letter relators. No statement
that such a family is finite for an infinite alphabet. -/
theorem nativeC60FSFreeMap_kernel_eq_active
    {A : Type u} {B : Type v} (f : A → B) :
    (FreeGroup.map f).ker =
      Subgroup.normalClosure (nativeC60FSActiveRelators f) := by
  calc
    (FreeGroup.map f).ker = nativeC60FQRootedNormalClosure f :=
      nativeC60FQFreeMap_kernel_eq_rooted f
    _ = Subgroup.normalClosure (nativeC60FSActiveRelators f) :=
      nativeC60FSRootedNormalClosure_eq_active f

/-- A finite active subset of original source letters gives a
finite family of ACTUAL relators; choice of roots may be noncomputable. -/
theorem nativeC60FSActiveRelators_finite
    {A : Type u} {B : Type v} (f : A → B)
    (hfinite : (nativeC60FSActiveLetters f).Finite) :
    (nativeC60FSActiveRelators f).Finite :=
  hfinite.image (nativeC60FSRootedRelator f)

/-- CONSTRUCTIVE statement of the exact finiteness gate: if the
NONTRIVIAL original fiber-root support is finite, the complete
kernel is normally generated by a finite explicit Set of original
noncommutative source words. No finiteness of A is required. -/
theorem nativeC60FSKernel_finitely_normalGenerated_of_active_finite
    {A : Type u} {B : Type v} (f : A → B)
    (hfinite : (nativeC60FSActiveLetters f).Finite) :
    ∃ R : Set (FreeGroup A), R.Finite ∧
      (FreeGroup.map f).ker = Subgroup.normalClosure R := by
  exact ⟨nativeC60FSActiveRelators f,
    nativeC60FSActiveRelators_finite f hfinite,
    nativeC60FSFreeMap_kernel_eq_active f⟩

/-- A finite free-letter alphabet is a sufficient but not necessary
special case of the genuine finite-ACTIVE-support gate. -/
theorem nativeC60FSKernel_finitely_normalGenerated_of_finite_source
    {A : Type u} {B : Type v} [Finite A] (f : A → B) :
    ∃ R : Set (FreeGroup A), R.Finite ∧
      (FreeGroup.map f).ker = Subgroup.normalClosure R := by
  have htotal : (Set.range (fun a : A => a)).Finite :=
    Set.finite_range _
  have hactive : (nativeC60FSActiveLetters f).Finite :=
    htotal.subset (by
      intro a ha
      exact ⟨a, rfl⟩)
  exact nativeC60FSKernel_finitely_normalGenerated_of_active_finite
    f hactive

end ActiveRootedRelations

section ActualCompleteDependentBoundaryKey

variable {L : NativeC60AXLayer.{u}}
variable (S : NativeC60AXSignature L) (F : Bool → NativeC60BCFrame L)

/-- A partial but genuine Type-valued receiving boundary profile.
This retains the entire recursion spine, ORIGINAL 17D-path-bearing
transported source and target, and whole dependent post/pre inner
18D images. It is NOT asserted to classify the whole target code
injectively; that would require a separate reflection theorem. -/
structure NativeC60FSBoundaryKey where
  spine : List NativeC60FGConstructorTag
  source : (nativeC60DVClosedEighteenLayer S F).Total
  target : (nativeC60DVClosedEighteenLayer S F).Total
  postInner : Option (NativeC60DVCompleteEighteenCode S F)
  preInner : Option (NativeC60DVCompleteEighteenCode S F)

/-- Extract the actual dependent destination-boundary profile of
a complete receiving 18D generator, with no extra quotient. -/
def nativeC60FSObservedKey
    (code : NativeC60DVCompleteEighteenCode S F) :
    NativeC60FSBoundaryKey S F where
  spine := nativeC60FIClosedCodeSpine S F code
  source := code.1
  target := code.2.1
  postInner := nativeC60FHClosedPostInnerCode S F code
  preInner := nativeC60FHClosedPreInnerCode S F code

/-- The genuine DV full-code image, inspected through the original
non-scalar dependent boundary and recursive inner-code profile. -/
def nativeC60FSSourceKey
    (word : List Bool) (code : NativeC60DSCompleteEighteenCode S F) :
    NativeC60FSBoundaryKey S F :=
  nativeC60FSObservedKey S F
    (nativeC60DVTransportCompleteCode S F word code)

/-- The spine component is precisely the ORIGINAL complete
dependent 18D generator recursion history, by FI naturality. -/
theorem nativeC60FSSourceKey_spine
    (word : List Bool) (code : NativeC60DSCompleteEighteenCode S F) :
    (nativeC60FSSourceKey S F word code).spine =
      nativeC60FIOriginalCodeSpine S F code :=
  nativeC60FICompleteCodeSpine_transport S F word code

/-- A code collision forces equality of the whole observed
dependent 17D boundary and transported inner 18D code profile.
The reverse implication is NOT silently assumed. -/
theorem nativeC60FSSourceKey_eq_of_collision
    (word : List Bool)
    {a b : NativeC60DSCompleteEighteenCode S F}
    (hab : nativeC60DVTransportCompleteCode S F word a =
      nativeC60DVTransportCompleteCode S F word b) :
    nativeC60FSSourceKey S F word a =
      nativeC60FSSourceKey S F word b :=
  congrArg (nativeC60FSObservedKey S F) hab

/-- The fiber-root representative selected by FQ preserves all
components of the actual dependent boundary profile. -/
theorem nativeC60FSRoot_preserves_boundaryKey
    (word : List Bool) (a : NativeC60DSCompleteEighteenCode S F) :
    nativeC60FSSourceKey S F word
      (nativeC60FQLetterRoot
        (nativeC60DVTransportCompleteCode S F word) a) =
      nativeC60FSSourceKey S F word a := by
  exact nativeC60FSSourceKey_eq_of_collision S F word
    (nativeC60FQLetterRoot_image
      (nativeC60DVTransportCompleteCode S F word) a)

/-- All ACTUAL complete dependent 18D source-code collisions inside
one exact target-boundary profile. This records more than the full
recursive spine without identifying raw evidence with a quotient. -/
def nativeC60FSBoundaryPairs
    (word : List Bool) (key : NativeC60FSBoundaryKey S F) :
    Set (NativeC60DTFullFree S F × NativeC60DTFullFree S F) :=
  {pair | ∃ a b : NativeC60DSCompleteEighteenCode S F,
    nativeC60DVTransportCompleteCode S F word a =
      nativeC60DVTransportCompleteCode S F word b ∧
    nativeC60FSSourceKey S F word a = key ∧
    nativeC60FSSourceKey S F word b = key ∧
    pair = (FreeGroup.of a, FreeGroup.of b)}

/-- Union of all actually witnessed complete Type-valued boundary
profiles, not an assumed finite or computable list of keys. -/
def nativeC60FSAllBoundaryPairs (word : List Bool) :
    Set (NativeC60DTFullFree S F × NativeC60DTFullFree S F) :=
  ⋃ key : NativeC60FSBoundaryKey S F,
    nativeC60FSBoundaryPairs S F word key

/-- Exact localization of EVERY true original 18D code collision
within one observed full-dependent destination-boundary key. -/
theorem nativeC60FSFullPairs_eq_boundaryUnion
    (word : List Bool) :
    nativeC60FOFiberPairs (nativeC60DVTransportCompleteCode S F word) =
      nativeC60FSAllBoundaryPairs S F word := by
  ext pair
  constructor
  · rintro ⟨a, b, hab, rfl⟩
    apply Set.mem_iUnion.mpr
    refine ⟨nativeC60FSSourceKey S F word a, ?_⟩
    exact ⟨a, b, hab, rfl,
      (nativeC60FSSourceKey_eq_of_collision S F word hab).symm, rfl⟩
  · intro hp
    obtain ⟨key, hkey⟩ := Set.mem_iUnion.mp hp
    rcases hkey with ⟨a, b, hab, _, _, hpair⟩
    exact ⟨a, b, hab, hpair⟩

/-- WHOLE original signed noncommutative 18D DV kernel is normally
generated by collisions within the SAME actual Type-valued
destination-boundary profile. Nothing asserts that the key map
itself is injective on all full receiving generator codes. -/
theorem nativeC60FSFullKernel_eq_boundaryNormalClosure
    (word : List Bool) :
    (nativeC60DVFullWordTransport S F word).ker =
      nativeC60DTNormalClosure (nativeC60FSAllBoundaryPairs S F word) := by
  calc
    (nativeC60DVFullWordTransport S F word).ker =
      nativeC60FOFullKernelNormalClosure S F word :=
        nativeC60FOFullTransport_kernel_eq_normalClosure S F word
    _ = nativeC60DTNormalClosure
        (nativeC60FSAllBoundaryPairs S F word) := by
      change nativeC60DTNormalClosure
        (nativeC60FOFiberPairs (nativeC60DVTransportCompleteCode S F word)) =
          nativeC60DTNormalClosure (nativeC60FSAllBoundaryPairs S F word)
      rw [nativeC60FSFullPairs_eq_boundaryUnion S F word]

/-- Genuine boundary key differences obstruct complete-code
collisions and hence original ordered two-letter kernel relations.
This does not assume injectivity of any 17D C60 frame. -/
theorem nativeC60FSBoundaryKey_diff_defect_not_mem
    (word : List Bool)
    {a b : NativeC60DSCompleteEighteenCode S F}
    (hkey : nativeC60FSSourceKey S F word a ≠
      nativeC60FSSourceKey S F word b) :
    nativeC60FCCodeFiberDefect S F a b ∉
      (nativeC60DVFullWordTransport S F word).ker := by
  intro hz
  have hzero :
      (nativeC60DVFullWordTransport S F word)
        (nativeC60FCCodeFiberDefect S F a b) = 1 :=
    MonoidHom.mem_ker.mp hz
  have hprod :
      (FreeGroup.of (nativeC60DVTransportCompleteCode S F word a) :
        NativeC60DVClosedFullFree S F) *
        (FreeGroup.of (nativeC60DVTransportCompleteCode S F word b))⁻¹ = 1 := by
    simpa only [nativeC60FCCodeFiberDefect, map_mul, map_inv,
      nativeC60DVFullWordTransport_of] using hzero
  have hcodes := FreeGroup.of_injective (eq_of_mul_inv_eq_one hprod)
  exact hkey (nativeC60FSSourceKey_eq_of_collision S F word hcodes)

/-- Descent of an arbitrary group-valued original 18D receiver
onto the ACTUAL image is unique iff all same-dependent-boundary-key
original complete code collisions are compatible. -/
theorem nativeC60FSReceiver_boundaryKey_iff
    {G : Type v} [Group G]
    (word : List Bool) (receiver : NativeC60DTFullFree S F →* G) :
    (∃! induced : NativeC60FPFullImage S F word →* G,
      induced.comp (nativeC60DVFullWordTransport S F word).rangeRestrict =
        receiver) ↔
      ∀ key : NativeC60FSBoundaryKey S F,
        ∀ a b : NativeC60DSCompleteEighteenCode S F,
          nativeC60FSSourceKey S F word a = key →
          nativeC60FSSourceKey S F word b = key →
          nativeC60DVTransportCompleteCode S F word a =
            nativeC60DVTransportCompleteCode S F word b →
          receiver (FreeGroup.of a) = receiver (FreeGroup.of b) := by
  rw [nativeC60FPFullReceiver_image_unique_iff S F word receiver]
  constructor
  · intro all key a b _ _ hab
    exact all a b hab
  · intro hlocal a b hab
    exact hlocal (nativeC60FSSourceKey S F word a)
      a b rfl
      (nativeC60FSSourceKey_eq_of_collision S F word hab).symm hab

/-- The original true dependent 18D kernel is conditionally finitely
normally generated whenever the actual FQ nontrivial-root code
support is finite; this hypothesis is NOT established for physical FJ. -/
theorem nativeC60FSPhysical_finitely_normalGenerated_of_active_finite
    (word : List Bool)
    (hfinite :
      (nativeC60FSActiveLetters
        (nativeC60DVTransportCompleteCode S F word)).Finite) :
    ∃ R : Set (NativeC60DTFullFree S F), R.Finite ∧
      (nativeC60DVFullWordTransport S F word).ker =
        Subgroup.normalClosure R := by
  obtain ⟨R, hRfinite, hRker⟩ :=
    nativeC60FSKernel_finitely_normalGenerated_of_active_finite
      (nativeC60DVTransportCompleteCode S F word) hfinite
  refine ⟨R, hRfinite, ?_⟩
  rw [nativeC60FCTransport_eq_freeMap S F word]
  exact hRker

end ActualCompleteDependentBoundaryKey

-- Regression: Bool has a finite original alphabet; Empty has no
-- source letters; no surjectivity hypothesis is introduced.
example :
    ∃ R : Set (FreeGroup Bool), R.Finite ∧
      (FreeGroup.map (fun _ : Bool => ())).ker =
        Subgroup.normalClosure R :=
  nativeC60FSKernel_finitely_normalGenerated_of_finite_source _

example :
    ∃ R : Set (FreeGroup Empty), R.Finite ∧
      (FreeGroup.map (fun e : Empty => (Empty.elim e : Bool))).ker =
        Subgroup.normalClosure R :=
  nativeC60FSKernel_finitely_normalGenerated_of_finite_source _

