import Kuu.F112.PolygonNativeC60AQFullPentagonCompleteKernelImageFirstIsomorphism

/-!
# F112-P94D3FQ — rooted complete 18D fibers and three constructor sectors

FO: the kernel of FreeGroup.map is normally generated by ALL collisions
of original complete-code source letters. FP: the quotient by this exact
kernel is the actual image, and receiver descent is unique ON THE IMAGE.

FQ tightens the normal presentation without adding any collision axiom:
(1) choose one representative in the actual image fiber of every letter;
    differences against that chosen representative alone normally
    generate the whole kernel, including empty and non-surjective maps.
(2) classify genuine fully dependent 18D code collisions sectorwise
    using FG's already verified original assoc / post / pre tag transport:
    cross-sector pairs NEVER occur; the original FO normal closure is
    exactly the normal closure of the three sector-local pair families.
(3) the receiver-on-image universal property is equivalent to three
    sectorwise compatibility tests, with no other tests silently added.
(4) the rooted normal quotient is again the actual DV transport image;
    the chosen fiber-root generator never leaves its original sector.

A rooted generating set need not be finite, irredundant, or minimal.
The known single physical FJ relation is not asserted to generate the
whole kernel. No original geometric 19D filler, Gray reinsertion,
strict global n-category or hyperdescent. Original old FJ and alternative
FK/FL/FM are separate presentations. Retain all old no-go and 107
public roots. Additive-only; no sorry/admit/axioms.
Copyright Hidetoshi Itakura / 板倉英俊. Apache-2.0.
-/

namespace Kuu.F112.Physical

open CategoryTheory
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
noncomputable section

universe u v w

section RootedFreeFibers

/-- Choose one original source letter for each ACTUAL target letter in
the image. Crucially this is a function of an image value, not of
a separately selected witness for every occurrence of a source letter. -/
noncomputable def nativeC60FQImageRoot
    {A : Type u} {B : Type v} (f : A → B)
    (b : Set.range f) : A :=
  Classical.choose b.property

theorem nativeC60FQImageRoot_maps_to_image
    {A : Type u} {B : Type v} (f : A → B)
    (b : Set.range f) :
    f (nativeC60FQImageRoot f b) = b.1 :=
  Classical.choose_spec b.property

/-- Each source letter is assigned the SAME chosen root as all the
other source letters with exactly its target code. -/
noncomputable def nativeC60FQLetterRoot
    {A : Type u} {B : Type v} (f : A → B) (a : A) : A :=
  nativeC60FQImageRoot f ⟨f a, ⟨a, rfl⟩⟩

theorem nativeC60FQLetterRoot_image
    {A : Type u} {B : Type v} (f : A → B) (a : A) :
    f (nativeC60FQLetterRoot f a) = f a :=
  nativeC60FQImageRoot_maps_to_image f ⟨f a, ⟨a, rfl⟩⟩

theorem nativeC60FQLetterRoot_eq_of_image_eq
    {A : Type u} {B : Type v} (f : A → B)
    {a b : A} (hab : f a = f b) :
    nativeC60FQLetterRoot f a = nativeC60FQLetterRoot f b := by
  unfold nativeC60FQLetterRoot
  have h :
      (⟨f a, ⟨a, rfl⟩⟩ : Set.range f) =
        (⟨f b, ⟨b, rfl⟩⟩ : Set.range f) :=
    Subtype.ext hab
  exact congrArg (nativeC60FQImageRoot f) h

/-- One original ordered relation per source letter and its ACTUAL
code-fiber root. Original letters and the noncommutative order remain. -/
def nativeC60FQRootedPairs
    {A : Type u} {B : Type v} (f : A → B) :
    Set (FreeGroup A × FreeGroup A) :=
  {pair | ∃ a : A,
    pair = (FreeGroup.of a, FreeGroup.of (nativeC60FQLetterRoot f a))}

abbrev nativeC60FQRootedNormalClosure
    {A : Type u} {B : Type v} (f : A → B) :=
  nativeC60DTNormalClosure (nativeC60FQRootedPairs f)

/-- Every rooted relation is a genuine original two-letter
difference in the selected minimal normal subgroup. -/
theorem nativeC60FQRootedDefect_mem
    {A : Type u} {B : Type v} (f : A → B) (a : A) :
    FreeGroup.of a * (FreeGroup.of (nativeC60FQLetterRoot f a))⁻¹ ∈
      nativeC60FQRootedNormalClosure f :=
  nativeC60DTPairDefect_mem (nativeC60FQRootedPairs f)
    (FreeGroup.of a, FreeGroup.of (nativeC60FQLetterRoot f a))
    ⟨a, rfl⟩

/-- Exact rooted reduction of FO's ALL-pairs presentation. Every
two-letter collision difference is a product of TWO rooted relations
(one inverted) because the two original source letters share a root.
This is valid even for empty sources and non-surjective f. -/
theorem nativeC60FQRootedNormalClosure_eq_full
    {A : Type u} {B : Type v} (f : A → B) :
    nativeC60FQRootedNormalClosure f =
      nativeC60FOFiberNormalClosure f := by
  classical
  apply le_antisymm
  · apply (nativeC60DTNormalClosure_le_iff
      (nativeC60FQRootedPairs f)
      (nativeC60FOFiberNormalClosure f)).mpr
    rintro p ⟨a, rfl⟩
    apply nativeC60DTPairDefect_mem (nativeC60FOFiberPairs f)
      (FreeGroup.of a, FreeGroup.of (nativeC60FQLetterRoot f a))
    exact ⟨a, nativeC60FQLetterRoot f a,
      (nativeC60FQLetterRoot_image f a).symm, rfl⟩
  · apply (nativeC60DTNormalClosure_le_iff
      (nativeC60FOFiberPairs f)
      (nativeC60FQRootedNormalClosure f)).mpr
    rintro p ⟨a, b, hab, rfl⟩
    have hr : nativeC60FQLetterRoot f a =
        nativeC60FQLetterRoot f b :=
      nativeC60FQLetterRoot_eq_of_image_eq f hab
    have ha := nativeC60FQRootedDefect_mem f a
    have hb := nativeC60FQRootedDefect_mem f b
    rw [← hr] at hb
    have hmul : FreeGroup.of a * (FreeGroup.of b)⁻¹ =
        (FreeGroup.of a * (FreeGroup.of (nativeC60FQLetterRoot f a))⁻¹) *
        (FreeGroup.of b * (FreeGroup.of (nativeC60FQLetterRoot f a))⁻¹)⁻¹ := by
      group
    rw [hmul]
    exact (nativeC60FQRootedNormalClosure f).mul_mem ha
      ((nativeC60FQRootedNormalClosure f).inv_mem hb)

/-- The rooted family still normally generates the WHOLE kernel. -/
theorem nativeC60FQFreeMap_kernel_eq_rooted
    {A : Type u} {B : Type v} (f : A → B) :
    (FreeGroup.map f).ker = nativeC60FQRootedNormalClosure f := by
  calc
    (FreeGroup.map f).ker = nativeC60FOFiberNormalClosure f :=
      nativeC60FOFreeMap_ker_eq_normalClosure f
    _ = nativeC60FQRootedNormalClosure f :=
      (nativeC60FQRootedNormalClosure_eq_full f).symm

/-- Noether I still holds with the genuinely smaller rooted
presentation. The target is the actual subgroup range, not all B. -/
noncomputable def nativeC60FQRootedFirstIso
    {A : Type u} {B : Type v} (f : A → B) :
    (FreeGroup A ⧸ nativeC60FQRootedNormalClosure f) ≃*
      (FreeGroup.map f).range :=
  (QuotientGroup.quotientMulEquivOfEq
    (nativeC60FQFreeMap_kernel_eq_rooted f).symm).trans
      (QuotientGroup.quotientKerEquivRange (FreeGroup.map f))

end RootedFreeFibers

section FullDependentEighteenSectors

variable {L : NativeC60AXLayer.{u}}
variable (S : NativeC60AXSignature L) (F : Bool → NativeC60BCFrame L)

/-- ACTUAL original fully dependent complete 18D collision pairs
inside just one of the three genuine generator constructor sectors. -/
def nativeC60FQSectorPairs
    (word : List Bool) (tag : NativeC60FGConstructorTag) :
    Set (NativeC60DTFullFree S F × NativeC60DTFullFree S F) :=
  {pair | ∃ a b : NativeC60DSCompleteEighteenCode S F,
    nativeC60DVTransportCompleteCode S F word a =
      nativeC60DVTransportCompleteCode S F word b ∧
    nativeC60FGOriginalConstructorTag S F a = tag ∧
    nativeC60FGOriginalConstructorTag S F b = tag ∧
    pair = (FreeGroup.of a, FreeGroup.of b)}

/-- Entire collision family decomposed as a union of three ACTUAL
constructor sectors, not into independent scalar/abelian observers. -/
def nativeC60FQAllSectorPairs (word : List Bool) :
    Set (NativeC60DTFullFree S F × NativeC60DTFullFree S F) :=
  (nativeC60FQSectorPairs S F word .assoc ∪
    nativeC60FQSectorPairs S F word .post) ∪
      nativeC60FQSectorPairs S F word .pre

/-- Exact equality of the original FO ALL-code-fiber pairs and the
three sector-local families. No cross-constructor collision is ever
present, by the original true DV tag transport theorem FG. -/
theorem nativeC60FQFullPairs_eq_three_sectors
    (word : List Bool) :
    nativeC60FOFiberPairs (nativeC60DVTransportCompleteCode S F word) =
      nativeC60FQAllSectorPairs S F word := by
  ext pair
  constructor
  · rintro ⟨a, b, hab, rfl⟩
    have htags := nativeC60FGCollision_preserves_constructor S F word hab
    change ((FreeGroup.of a, FreeGroup.of b) ∈
        nativeC60FQSectorPairs S F word .assoc ∨
      (FreeGroup.of a, FreeGroup.of b) ∈
        nativeC60FQSectorPairs S F word .post) ∨
      (FreeGroup.of a, FreeGroup.of b) ∈
        nativeC60FQSectorPairs S F word .pre
    cases ha : nativeC60FGOriginalConstructorTag S F a with
    | assoc =>
        exact Or.inl (Or.inl
          ⟨a, b, hab, ha, htags.symm.trans ha, rfl⟩)
    | post =>
        exact Or.inl (Or.inr
          ⟨a, b, hab, ha, htags.symm.trans ha, rfl⟩)
    | pre =>
        exact Or.inr
          ⟨a, b, hab, ha, htags.symm.trans ha, rfl⟩
  · intro hp
    change (pair ∈ nativeC60FQSectorPairs S F word .assoc ∨
      pair ∈ nativeC60FQSectorPairs S F word .post) ∨
      pair ∈ nativeC60FQSectorPairs S F word .pre at hp
    rcases hp with ((h | h) | h)
    · rcases h with ⟨a, b, hab, _, _, rfl⟩
      exact ⟨a, b, hab, rfl⟩
    · rcases h with ⟨a, b, hab, _, _, rfl⟩
      exact ⟨a, b, hab, rfl⟩
    · rcases h with ⟨a, b, hab, _, _, rfl⟩
      exact ⟨a, b, hab, rfl⟩

/-- The exact WHOLE actual 18D DV transport kernel is normally
generated by the union of ONLY assoc, post and pre sector-internal
complete original-code collisions. This is not three assumed kernels:
the normal closure is taken inside ONE original noncommutative group. -/
theorem nativeC60FQFullKernel_eq_three_sector_normalClosure
    (word : List Bool) :
    (nativeC60DVFullWordTransport S F word).ker =
      nativeC60DTNormalClosure (nativeC60FQAllSectorPairs S F word) := by
  calc
    (nativeC60DVFullWordTransport S F word).ker =
        nativeC60FOFullKernelNormalClosure S F word :=
      nativeC60FOFullTransport_kernel_eq_normalClosure S F word
    _ = nativeC60DTNormalClosure
        (nativeC60FQAllSectorPairs S F word) := by
      change nativeC60DTNormalClosure
        (nativeC60FOFiberPairs (nativeC60DVTransportCompleteCode S F word)) =
          nativeC60DTNormalClosure (nativeC60FQAllSectorPairs S F word)
      rw [nativeC60FQFullPairs_eq_three_sectors S F word]

/-- The chosen full-code fiber representative ALWAYS has the same
actual original dependent assoc/post/pre constructor tag. -/
theorem nativeC60FQFullRoot_preserves_sector
    (word : List Bool)
    (a : NativeC60DSCompleteEighteenCode S F) :
    nativeC60FGOriginalConstructorTag S F
        (nativeC60FQLetterRoot
          (nativeC60DVTransportCompleteCode S F word) a) =
      nativeC60FGOriginalConstructorTag S F a :=
  nativeC60FGCollision_preserves_constructor S F word
    (nativeC60FQLetterRoot_image
      (nativeC60DVTransportCompleteCode S F word) a)

/-- The original dependent 18D full collision-kernel can be
generated by ONE rooted pair per source complete-code letter.
These are still all the ORIGINAL noncommutative source code letters. -/
theorem nativeC60FQFullKernel_eq_rooted
    (word : List Bool) :
    (nativeC60DVFullWordTransport S F word).ker =
      nativeC60FQRootedNormalClosure
        (nativeC60DVTransportCompleteCode S F word) := by
  rw [nativeC60FCTransport_eq_freeMap S F word]
  exact nativeC60FQFreeMap_kernel_eq_rooted _

/-- Canonical group isomorphism of the genuine dependent Type-valued
18D rooted normal quotient with its ACTUAL receiving image subgroup. -/
noncomputable def nativeC60FQFullRootedFirstIso
    (word : List Bool) :
    (NativeC60DTFullFree S F ⧸
      nativeC60FQRootedNormalClosure
        (nativeC60DVTransportCompleteCode S F word)) ≃*
      NativeC60FPFullImage S F word :=
  (QuotientGroup.quotientMulEquivOfEq
    (nativeC60FQFullKernel_eq_rooted S F word).symm).trans
      (QuotientGroup.quotientKerEquivRange
        (nativeC60DVFullWordTransport S F word))

/-- Image receiver descent is equivalently tested just within the
three true 18D constructor sectors. Exact algebraic descent and
actual Type-valued source/target are retained. -/
theorem nativeC60FQFullReceiver_three_sector_iff
    {G : Type v} [Group G]
    (word : List Bool) (receiver : NativeC60DTFullFree S F →* G) :
    (∃! induced : NativeC60FPFullImage S F word →* G,
      induced.comp (nativeC60DVFullWordTransport S F word).rangeRestrict =
        receiver) ↔
    (∀ a b : NativeC60DSCompleteEighteenCode S F,
      nativeC60FGOriginalConstructorTag S F a = .assoc →
      nativeC60FGOriginalConstructorTag S F b = .assoc →
      nativeC60DVTransportCompleteCode S F word a =
        nativeC60DVTransportCompleteCode S F word b →
      receiver (FreeGroup.of a) = receiver (FreeGroup.of b)) ∧
    (∀ a b : NativeC60DSCompleteEighteenCode S F,
      nativeC60FGOriginalConstructorTag S F a = .post →
      nativeC60FGOriginalConstructorTag S F b = .post →
      nativeC60DVTransportCompleteCode S F word a =
        nativeC60DVTransportCompleteCode S F word b →
      receiver (FreeGroup.of a) = receiver (FreeGroup.of b)) ∧
    (∀ a b : NativeC60DSCompleteEighteenCode S F,
      nativeC60FGOriginalConstructorTag S F a = .pre →
      nativeC60FGOriginalConstructorTag S F b = .pre →
      nativeC60DVTransportCompleteCode S F word a =
        nativeC60DVTransportCompleteCode S F word b →
      receiver (FreeGroup.of a) = receiver (FreeGroup.of b)) := by
  rw [nativeC60FPFullReceiver_image_unique_iff S F word receiver]
  constructor
  · intro hall
    exact ⟨(fun a b _ _ hab => hall a b hab),
      (fun a b _ _ hab => hall a b hab),
      (fun a b _ _ hab => hall a b hab)⟩
  · rintro ⟨hassoc, hpost, hpre⟩ a b hab
    have ht := nativeC60FGCollision_preserves_constructor S F word hab
    cases ha : nativeC60FGOriginalConstructorTag S F a with
    | assoc =>
        exact hassoc a b ha (ht.symm.trans ha) hab
    | post =>
        exact hpost a b ha (ht.symm.trans ha) hab
    | pre =>
        exact hpre a b ha (ht.symm.trans ha) hab

end FullDependentEighteenSectors

/-- Empty-source regression does not require any phantom source letter. -/
example :
    (FreeGroup.map (fun e : Empty => (Empty.elim e : Bool))).ker =
      nativeC60FQRootedNormalClosure
        (fun e : Empty => (Empty.elim e : Bool)) :=
  nativeC60FQFreeMap_kernel_eq_rooted _

/-- Constant-map regression keeps every original Bool letter and
normally identifies just their complete free-group fiber. -/
example :
    (FreeGroup.map (fun _ : Bool => ())).ker =
      nativeC60FQRootedNormalClosure (fun _ : Bool => ()) :=
  nativeC60FQFreeMap_kernel_eq_rooted _

/-- Nonsurjective map regression: no unused target letter is identified
with any original source letter by a fabricated surjectivity assumption. -/
example :
    (FreeGroup.map (fun n : Nat => n + 1)).ker =
      nativeC60FQRootedNormalClosure (fun n : Nat => n + 1) :=
  nativeC60FQFreeMap_kernel_eq_rooted _

