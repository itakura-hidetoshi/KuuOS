import Kuu.F112.PolygonNativeF55HorizontalStrictPathBoundaryP61

/-!
# F112-P62 — typed structural-unit congruence of independent F55 paths

P61 finds a genuine horizontal unit obstruction in P59's VERTICAL
free-path normal form: horizontal composition of two original raw
identity proofs produces two nonempty atomic paths. This file does not
change those source proof trees.

Instead, it distinguishes a purely syntactic sublanguage generated by
raw identities under the structural F55 operations. A typed congruence
on Mathlib paths is generated ONLY by erasing loops in that sublanguage,
then closed under symmetry, transitivity and VERTICAL path concatenation.
The concrete P61 horizontal identity is equivalent to the empty path
under this independently specified relation, not EQUAL as a raw path.

No pentagon or disjoint-square constructor belongs to the structural
unit sublanguage, even on the genuine C60 sources. A proof of soundness
under the previously selected shadow is a theorem ABOUT this congruence,
not its definition, and is not used to identify arbitrary equal-shadow
source histories.

This first unit-coherence boundary does not assert full horizontal
bifunctoriality, raw F54 route associativity, strict interchange,
a global strict 3-category, or (infinity,3)-hyperdescent.
No Gray, new axioms, sorry or admit.
-/

namespace Kuu.F112.Physical

open CategoryTheory
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
noncomputable section

universe uD vD uE vE
variable {D : Type uD} [Category.{vD} D]
variable {E : Type uE} [Category.{vE} E]

/-- The proof-relevant identity-generated raw sublanguage. This is
recursive inspection of the NINE genuine F55 constructors, not a test
for zero numerical shadow. The two physical primitives are EXCLUDED.
In particular, a nontrivial primitive followed by its formal inverse
is not silently reclassified as a structural identity. -/
def KuuNativeF45Tree.DepthRotationRoute.PresentedCell.unitOnly
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    {first : KuuNativeF45Tree p n m ma pa mb pb}
    {last : KuuNativeF45Tree p n' m' ma pa mb pb} :
    ∀ {r s : KuuNativeF45Tree.DepthRotationRoute p first last},
      KuuNativeF45Tree.DepthRotationRoute.PresentedCell p r s → Bool
  | _, _, .ident _ => true
  | _, _, .pentagon _ _ _ _ => false
  | _, _, .disjointSquare _ _ => false
  | _, _, .symm c => c.unitOnly
  | _, _, .trans c d => c.unitOnly && d.unitOnly
  | _, _, .leftContext c _ => c.unitOnly
  | _, _, .rightContext _ c => c.unitOnly
  | _, _, .precompose _ c => c.unitOnly
  | _, _, .postcompose c _ => c.unitOnly

/-- A SOURCE-syntactically unit-generated cell has zero selected
shadow. The converse is intentionally not used or asserted. -/
theorem KuuNativeF45Tree.DepthRotationRoute.PresentedCell.unitOnly_shadow_zero
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    {first : KuuNativeF45Tree p n m ma pa mb pb}
    {last : KuuNativeF45Tree p n' m' ma pa mb pb}
    {r s : KuuNativeF45Tree.DepthRotationRoute p first last}
    (cell : KuuNativeF45Tree.DepthRotationRoute.PresentedCell p r s)
    (h : cell.unitOnly = true) :
    cell.nativeShadow = 0 := by
  induction cell with
  | ident _ => rfl
  | pentagon _ _ _ _ => cases h
  | disjointSquare _ _ => cases h
  | symm c ih =>
      change -c.nativeShadow = 0
      rw [ih h]
      rfl
  | trans c d ihc ihd =>
      have hc : c.unitOnly = true := by
        exact Bool.and_elim_left h
      have hd : d.unitOnly = true := by
        exact Bool.and_elim_right h
      change c.nativeShadow + d.nativeShadow = 0
      rw [ihc hc, ihd hd]
      rfl
  | leftContext c later ih => exact ih h
  | rightContext earlier c ih => exact ih h
  | precompose prior c ih => exact ih h
  | postcompose c suffix ih => exact ih h

/-- LEAST inductively generated typed vertical path congruence for
structural units. Constructors relate paths at precisely the SAME
dependent F54 endpoints. Raw source cells are not equated or erased.

"structuralUnit" is restricted to a raw LOOP and a recursively
certified constructor language (not to arbitrary shadow-zero loops).
The other constructors give explicit equivalence and VERTICAL
congruence. Horizontal stability beyond the certified unit case
remains a separate task. -/
inductive NativeF55UnitPathRel
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb) :
    ∀ {r s : NativeF55RawRouteVertex first last},
      Quiver.Path r s → Quiver.Path r s → Prop where
  | refl {r s} (path : Quiver.Path r s) :
      NativeF55UnitPathRel first last path path
  | symm {r s} {f g : Quiver.Path r s}
      (h : NativeF55UnitPathRel first last f g) :
      NativeF55UnitPathRel first last g f
  | trans {r s} {f g h : Quiver.Path r s}
      (hfg : NativeF55UnitPathRel first last f g)
      (hgh : NativeF55UnitPathRel first last g h) :
      NativeF55UnitPathRel first last f h
  | comp {r s t} {f f' : Quiver.Path r s} {g g' : Quiver.Path s t}
      (hf : NativeF55UnitPathRel first last f f')
      (hg : NativeF55UnitPathRel first last g g') :
      NativeF55UnitPathRel first last (f.comp g) (f'.comp g')
  | structuralUnit
      (route : KuuNativeF45Tree.DepthRotationRoute p first last)
      (cell : KuuNativeF45Tree.DepthRotationRoute.PresentedCell p route route)
      (h : cell.unitOnly = true) :
      NativeF55UnitPathRel first last cell.toNativeStrictPath
        (Quiver.Path.nil :
          Quiver.Path (⟨route⟩ : NativeF55RawRouteVertex first last) ⟨route⟩)

/-- The generated relation really is reflexive, symmetric and
transitive on every TYPED pair of Mathlib path endpoints. -/
theorem nativeF55UnitPathRel_equivalence
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb)
    (r s : NativeF55RawRouteVertex first last) :
    Equivalence (NativeF55UnitPathRel first last
      (r := r) (s := s)) := by
  refine ⟨?_, ?_, ?_⟩
  · intro f
    exact .refl f
  · intro f g h
    exact .symm h
  · intro f g h hfg hgh
    exact .trans hfg hgh

/-- Congruence is stable when an arbitrary typed prefix is attached. -/
theorem NativeF55UnitPathRel.prepend
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    {first : KuuNativeF45Tree p n m ma pa mb pb}
    {last : KuuNativeF45Tree p n' m' ma pa mb pb}
    {r s t : NativeF55RawRouteVertex first last}
    (prefix : Quiver.Path r s) {f g : Quiver.Path s t}
    (h : NativeF55UnitPathRel first last f g) :
    NativeF55UnitPathRel first last
      (prefix.comp f) (prefix.comp g) :=
  .comp (.refl prefix) h

/-- Congruence is also stable under arbitrary typed suffixes. -/
theorem NativeF55UnitPathRel.append
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    {first : KuuNativeF45Tree p n m ma pa mb pb}
    {last : KuuNativeF45Tree p n' m' ma pa mb pb}
    {r s t : NativeF55RawRouteVertex first last}
    {f g : Quiver.Path r s} (suffix : Quiver.Path s t)
    (h : NativeF55UnitPathRel first last f g) :
    NativeF55UnitPathRel first last
      (f.comp suffix) (g.comp suffix) :=
  .comp h (.refl suffix)

/-- Soundness with respect to ONE chosen historical observer follows
from all five RELATION constructors. It is NOT how the relation was
defined: equivalence of arbitrary equal-shadow raw histories is not
a generating rule. -/
theorem NativeF55UnitPathRel.shadow_sound
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    {first : KuuNativeF45Tree p n m ma pa mb pb}
    {last : KuuNativeF45Tree p n' m' ma pa mb pb}
    {r s : NativeF55RawRouteVertex first last}
    {f g : Quiver.Path r s}
    (h : NativeF55UnitPathRel first last f g) :
    (nativeF55RawPathsToShadow first last).map f =
      (nativeF55RawPathsToShadow first last).map g := by
  induction h with
  | refl _ => rfl
  | symm h ih => exact ih.symm
  | trans hfg hgh ihfg ihgh => exact ihfg.trans ihgh
  | comp hf hg ihf ihg =>
      calc
        _ = nativeF55ThreeComp _ _ :=
          nativeF55RawPathsToShadow_mapTypedComp first last _ _
        _ = nativeF55ThreeComp _ _ := by rw [ihf, ihg]
        _ = _ :=
          (nativeF55RawPathsToShadow_mapTypedComp first last _ _).symm
  | structuralUnit route cell hc =>
      apply nativeF55ThreeEval_injective
      rw [cell.toNativeStrictPath_shadow_eval]
      change cell.nativeShadow = (0 : KuuNativeF55Shadow)
      exact cell.unitOnly_shadow_zero hc

/-- P62 main result: both explicit proof-relevant factors of P61's
HORIZONTAL identity composite are structural-unit loops on the
SAME dependent F54 route. The new typed, vertical-compatible relation
therefore identifies their TWO-EDGE NORMAL FORM with the empty
strict unit path. P61's raw PATH INEQUALITY remains true. -/
theorem KuuNativeF45Tree.DepthRotationRoute.PresentedCell.horizontal_identities_unit_related
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' k k' l l' : Nat}
    {p₀ p₁ p₂ : KuuNativeBlocks a b}
    {q₀ q₁ q₂ : KuuNativeBlocks x y}
    {leftBefore : KuuNativeF45Tree p n m p₀ q₀ p₁ q₁}
    {leftAfter : KuuNativeF45Tree p n' m' p₀ q₀ p₁ q₁}
    {rightBefore : KuuNativeF45Tree p k l p₁ q₁ p₂ q₂}
    {rightAfter : KuuNativeF45Tree p k' l' p₁ q₁ p₂ q₂}
    (u : KuuNativeF45Tree.DepthRotationRoute p leftBefore leftAfter)
    (v : KuuNativeF45Tree.DepthRotationRoute p rightBefore rightAfter) :
    NativeF55UnitPathRel
      (KuuNativeF45Tree.node leftBefore rightBefore)
      (KuuNativeF45Tree.node leftAfter rightAfter)
      ((KuuNativeF45Tree.DepthRotationRoute.PresentedCell.ident u).horizontal
        (KuuNativeF45Tree.DepthRotationRoute.PresentedCell.ident v)
      ).toNativeStrictPath
      (Quiver.Path.nil :
        Quiver.Path
          (⟨KuuNativeF45Tree.DepthRotationRoute.trans
            (.leftContext u rightBefore) (.rightContext leftAfter v)⟩ :
            NativeF55RawRouteVertex
              (KuuNativeF45Tree.node leftBefore rightBefore)
              (KuuNativeF45Tree.node leftAfter rightAfter))
          ⟨KuuNativeF45Tree.DepthRotationRoute.trans
            (.leftContext u rightBefore) (.rightContext leftAfter v)⟩) := by
  let source := KuuNativeF45Tree.node leftBefore rightBefore
  let target := KuuNativeF45Tree.node leftAfter rightAfter
  let route : KuuNativeF45Tree.DepthRotationRoute p source target :=
    .trans (.leftContext u rightBefore) (.rightContext leftAfter v)
  let cL : KuuNativeF45Tree.DepthRotationRoute.PresentedCell p route route :=
    .postcompose (.leftContext (.ident u) rightBefore)
      (.rightContext leftAfter v)
  let cR : KuuNativeF45Tree.DepthRotationRoute.PresentedCell p route route :=
    .precompose (.leftContext u rightBefore)
      (.rightContext leftAfter (.ident v))
  have hL : NativeF55UnitPathRel source target cL.toNativeStrictPath
      (Quiver.Path.nil :
        Quiver.Path (⟨route⟩ : NativeF55RawRouteVertex source target) ⟨route⟩) :=
    .structuralUnit route cL rfl
  have hR : NativeF55UnitPathRel source target cR.toNativeStrictPath
      (Quiver.Path.nil :
        Quiver.Path (⟨route⟩ : NativeF55RawRouteVertex source target) ⟨route⟩) :=
    .structuralUnit route cR rfl
  change NativeF55UnitPathRel source target
    (cL.toNativeStrictPath.comp cR.toNativeStrictPath)
    (Quiver.Path.nil :
      Quiver.Path (⟨route⟩ : NativeF55RawRouteVertex source target) ⟨route⟩)
  simpa only [Quiver.Path.nil_comp] using
    (NativeF55UnitPathRel.comp hL hR)

/-- The true C60 north pentagon is a PHYSICAL primitive and never
becomes a structural-unit generator by the source recursion. -/
theorem northNativeF55PentagonCell_not_unitOnly :
    northNativeF55PentagonCell.unitOnly = false := rfl

/-- The true C60 top hexagon exchange square is likewise protected. -/
theorem northHexagonNativeF55SquareCell_not_unitOnly :
    northHexagonNativeF55SquareCell.unitOnly = false := rfl

#print axioms KuuNativeF45Tree.DepthRotationRoute.PresentedCell.unitOnly
#print axioms KuuNativeF45Tree.DepthRotationRoute.PresentedCell.unitOnly_shadow_zero
#print axioms NativeF55UnitPathRel
#print axioms nativeF55UnitPathRel_equivalence
#print axioms NativeF55UnitPathRel.prepend
#print axioms NativeF55UnitPathRel.append
#print axioms NativeF55UnitPathRel.shadow_sound
#print axioms KuuNativeF45Tree.DepthRotationRoute.PresentedCell.horizontal_identities_unit_related
#print axioms northNativeF55PentagonCell_not_unitOnly
#print axioms northHexagonNativeF55SquareCell_not_unitOnly

end
end Kuu.F112.Physical
