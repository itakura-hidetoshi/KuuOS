/-!
# F112-P94D3FX — exact minimum normal-generator CARDINAL via rational
# finite-support module rank for original full noncommutative free-group kernels

FW proved that the true selected-root family of original signed
noncommutative free words is normally irredundant, that every
arbitrary normal generating family detects each active source-letter
coordinate, and that normal countable generation is equivalent
to countability of the active source-letter set.

FX strengthens this to an exact cardinal rank statement, including
arbitrary FINITE and INFINITE cardinalities without silently assuming
the original 18D source alphabet is countable.

For any f : A → B, let D_f be the set of a not equal to the selected
representative root_f(a) of its image fiber. The genuine full kernel
ker(FreeGroup.map f) is normally generated by one canonical original
rooted signed free-group word d_a per active a, and EVERY set R of
arbitrary original noncommutative free-group words that normally
generates this kernel has cardinal at least #D_f.

To prove the new LOWER bound, use the rational finite-support free
module D_f →₀ ℚ. There is an actual homomorphism from the entire
noncommutative FreeGroup A to its multiplicative presentation sending
the active original letter a to the corresponding rational basis
vector e_a and selected roots to zero. Hence each d_a maps to e_a.
If arbitrary R normally generates the original kernel, the images
of R span the entire rational free module: pass to the quotient by
their linear span, whose multiplicative group is abelian, and use
the normalClosure universal property. The dimension of the image
span is at most the cardinal of R, while the dimension of the free
module is exactly #D_f. FW's injectivity of canonical rooted relators
provides the matching UPPER bound #D_f.

The rational coordinates are only non-membership/cardinality
detectors; original free-group words remain noncommutative and
original dependent Type-valued 14D–18D evidence remains intact.
No original physical countability, geometric 19D filler, universal
single FJ relator, global strict higher coherence or hyperdescent
is inferred. Preserve 107 public roots, strict Kuu core/independent
Kuu presentation, no Gray, pinned Lean/mathlib, append-only.
No new axioms, sorry or admit.
Copyright Hidetoshi Itakura / 板倉英俊. Apache-2.0.
-/

namespace Kuu.F112.Physical

open CategoryTheory Cardinal
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
noncomputable section

universe u v

section ArbitraryNormalRankCardinal

/-- An honest group hom on the ORIGINAL noncommutative source
FreeGroup A, with rational coefficients indexed by the actual
nonroot source-letter subtype. Only the CODOMAIN is abelian. -/
def nativeC60FXRationalActiveCoordinate
    {A : Type u} {B : Type v} (f : A → B) :
    FreeGroup A →*
      Multiplicative ((nativeC60FSActiveLetters f) →₀ ℚ) := by
  classical
  exact FreeGroup.lift (fun a : A =>
    Multiplicative.ofAdd
      (if ha : a ∈ nativeC60FSActiveLetters f
        then Finsupp.single
          (⟨a, ha⟩ : nativeC60FSActiveLetters f) (1 : ℚ)
        else 0))

/-- Each genuinely selected root has zero rational coordinate. -/
theorem nativeC60FXRationalActiveCoordinate_root
    {A : Type u} {B : Type v} (f : A → B) (a : A) :
    (nativeC60FXRationalActiveCoordinate f)
      (FreeGroup.of (nativeC60FQLetterRoot f a)) = 1 := by
  classical
  have hr : nativeC60FQLetterRoot f a ∉
      nativeC60FSActiveLetters f :=
    nativeC60FWLetterRoot_not_active f a
  simp [nativeC60FXRationalActiveCoordinate, hr]

/-- Each active original generator maps to its own basis vector. -/
theorem nativeC60FXRationalActiveCoordinate_active
    {A : Type u} {B : Type v} (f : A → B)
    (a : A) (ha : a ∈ nativeC60FSActiveLetters f) :
    (nativeC60FXRationalActiveCoordinate f) (FreeGroup.of a) =
      Multiplicative.ofAdd
        (Finsupp.single
          (⟨a, ha⟩ : nativeC60FSActiveLetters f) (1 : ℚ)) := by
  classical
  simp [nativeC60FXRationalActiveCoordinate, ha]

/-- Each actual nontrivial rooted kernel relator maps to the
corresponding rational STANDARD BASIS vector, not just some
nonzero coordinate. -/
theorem nativeC60FXRationalActiveCoordinate_rooted
    {A : Type u} {B : Type v} (f : A → B)
    (a : A) (ha : a ∈ nativeC60FSActiveLetters f) :
    ((nativeC60FXRationalActiveCoordinate f)
      (nativeC60FSRootedRelator f a)).toAdd =
      Finsupp.single
        (⟨a, ha⟩ : nativeC60FSActiveLetters f) (1 : ℚ) := by
  classical
  simp only [nativeC60FSRootedRelator, map_mul, map_inv,
    nativeC60FXRationalActiveCoordinate_active f a ha,
    nativeC60FXRationalActiveCoordinate_root f a,
    inv_one, mul_one]
  rfl

/-- If an arbitrary family of ORIGINAL NONCOMMUTATIVE free words
normally generates the entire kernel, its rational active-letter
coordinate images LINEARLY SPAN the complete finite-support
rational free module. Unlike mere coordinate-by-coordinate
coverage, this also gives the sharp finite-rank lower bound. -/
theorem nativeC60FXRationalActiveSpan_top
    {A : Type u} {B : Type v} (f : A → B)
    (R : Set (FreeGroup A))
    (hR : (FreeGroup.map f).ker = Subgroup.normalClosure R) :
    Submodule.span ℚ
      ((fun z : FreeGroup A =>
        ((nativeC60FXRationalActiveCoordinate f) z).toAdd) '' R) =
      ⊤ := by
  classical
  let P : Submodule ℚ ((nativeC60FSActiveLetters f) →₀ ℚ) :=
    Submodule.span ℚ
      ((fun z : FreeGroup A =>
        ((nativeC60FXRationalActiveCoordinate f) z).toAdd) '' R)
  let q : FreeGroup A →*
      Multiplicative
        (((nativeC60FSActiveLetters f) →₀ ℚ) ⧸ P) :=
    (AddMonoidHom.toMultiplicative
      ((Submodule.mkQ P).toAddMonoidHom)).comp
        (nativeC60FXRationalActiveCoordinate f)
  have hRker : R ⊆ q.ker := by
    intro z hz
    apply MonoidHom.mem_ker.mpr
    have hzP :
        ((nativeC60FXRationalActiveCoordinate f) z).toAdd ∈ P :=
      Submodule.subset_span ⟨z, hz, rfl⟩
    change Multiplicative.ofAdd
      ((Submodule.mkQ P)
        (((nativeC60FXRationalActiveCoordinate f) z).toAdd)) = 1
    have hzZero :
        (Submodule.mkQ P)
          (((nativeC60FXRationalActiveCoordinate f) z).toAdd) = 0 := by
      exact (Submodule.Quotient.mk_eq_zero (p := P)
        (x := ((nativeC60FXRationalActiveCoordinate f) z).toAdd)).mpr hzP
    simp only [hzZero, map_zero]
    rfl
  have hnormal : Subgroup.normalClosure R ≤ q.ker :=
    Subgroup.normalClosure_le_normal hRker
  have hbasis :
      ∀ a : nativeC60FSActiveLetters f,
        Finsupp.single a (1 : ℚ) ∈ P := by
    intro a
    have hker :
        nativeC60FSRootedRelator f a.1 ∈
          (FreeGroup.map f).ker := by
      rw [nativeC60FSFreeMap_kernel_eq_active f]
      exact Subgroup.subset_normalClosure
        (nativeC60FSActiveRelator_mem f a.1 a.2)
    have hrel :
        nativeC60FSRootedRelator f a.1 ∈
          Subgroup.normalClosure R := by
      rw [← hR]
      exact hker
    have hq :
        q (nativeC60FSRootedRelator f a.1) = 1 :=
      MonoidHom.mem_ker.mp (hnormal hrel)
    change Multiplicative.ofAdd
      ((Submodule.mkQ P)
        (((nativeC60FXRationalActiveCoordinate f)
          (nativeC60FSRootedRelator f a.1)).toAdd)) = 1 at hq
    have hqZero :
        (Submodule.mkQ P)
          (((nativeC60FXRationalActiveCoordinate f)
            (nativeC60FSRootedRelator f a.1)).toAdd) = 0 :=
      congrArg Multiplicative.toAdd hq
    have hmem :
        ((nativeC60FXRationalActiveCoordinate f)
          (nativeC60FSRootedRelator f a.1)).toAdd ∈ P :=
      (Submodule.Quotient.mk_eq_zero (p := P)
        (x := ((nativeC60FXRationalActiveCoordinate f)
          (nativeC60FSRootedRelator f a.1)).toAdd)).mp hqZero
    simpa only [
      nativeC60FXRationalActiveCoordinate_rooted f a.1 a.2] using hmem
  change P = ⊤
  have hspanBasis :
      Submodule.span ℚ
        (Set.range
          (fun a : nativeC60FSActiveLetters f =>
            Finsupp.single a (1 : ℚ))) =
          ⊤ := by
    simpa only [Finsupp.coe_basisSingleOne] using
      (Finsupp.basisSingleOne
        (ι := nativeC60FSActiveLetters f) (R := ℚ)).span_eq
  apply top_unique
  rw [← hspanBasis]
  apply Submodule.span_le.mpr
  rintro x ⟨a, rfl⟩
  exact hbasis a

/-- SHARP cardinal lower bound: for EVERY possible collection R of
arbitrary noncommutative signed group words that normally generates
the FULL kernel, the exact cardinal #active is no greater than #R.
Works even when #active is finite; infinitely many active letters
alone would not have proved the finite case. -/
theorem nativeC60FXAnyNormalGenerators_cardinal_lower
    {A : Type u} {B : Type v} (f : A → B)
    (R : Set (FreeGroup A))
    (hR : (FreeGroup.map f).ker = Subgroup.normalClosure R) :
    #(nativeC60FSActiveLetters f) ≤ #R := by
  classical
  let S : Set ((nativeC60FSActiveLetters f) →₀ ℚ) :=
    (fun z : FreeGroup A =>
      ((nativeC60FXRationalActiveCoordinate f) z).toAdd) '' R
  have htop : Submodule.span ℚ S = ⊤ :=
    nativeC60FXRationalActiveSpan_top f R hR
  have hrank :
      Module.rank ℚ (Submodule.span ℚ S) ≤ #S :=
    Submodule.rank_span_le S
  rw [htop] at hrank
  calc
    #(nativeC60FSActiveLetters f) =
        Module.rank ℚ
          ((nativeC60FSActiveLetters f) →₀ ℚ) := by
        simpa using
          (Module.rank_finsupp_self
            (R := ℚ) (nativeC60FSActiveLetters f)).symm
    _ = Module.rank ℚ
          (⊤ : Submodule ℚ
            ((nativeC60FSActiveLetters f) →₀ ℚ)) := by
        symm
        exact rank_top ℚ _
    _ ≤ #S := hrank
    _ ≤ #R := Cardinal.mk_image_le

/-- Upper bound with cardinal EQUALITY: the actual family of
nontrivial rooted source relators is injectively indexed by D_f,
and its normal closure is precisely the entire original kernel. -/
theorem nativeC60FXCanonicalNormalGenerators_exact_cardinal
    {A : Type u} {B : Type v} (f : A → B) :
    ∃ R : Set (FreeGroup A),
      (FreeGroup.map f).ker = Subgroup.normalClosure R ∧
        #R = #(nativeC60FSActiveLetters f) := by
  classical
  refine ⟨nativeC60FSActiveRelators f,
    nativeC60FSFreeMap_kernel_eq_active f, ?_⟩
  exact Cardinal.mk_image_eq_of_injOn
    (nativeC60FSRootedRelator f)
    (nativeC60FSActiveLetters f)
    (nativeC60FWActiveRootedRelators_injectiveOn f)

/-- EXACT min-normal-generator-cardinality certificate for the
kernel of EVERY original noncommutative free-group map f.
Every arbitrary normally generating family has at least #D_f
elements, and an explicit rooted family has EXACTLY #D_f.
No cardinal hypothesis on A or B, finite or infinite. -/
theorem nativeC60FXFullFreeMap_kernel_exact_normalRank
    {A : Type u} {B : Type v} (f : A → B) :
    (∀ R : Set (FreeGroup A),
       (FreeGroup.map f).ker = Subgroup.normalClosure R →
       #(nativeC60FSActiveLetters f) ≤ #R) ∧
    (∃ R : Set (FreeGroup A),
       (FreeGroup.map f).ker = Subgroup.normalClosure R ∧
       #R = #(nativeC60FSActiveLetters f)) :=
  ⟨nativeC60FXAnyNormalGenerators_cardinal_lower f,
   nativeC60FXCanonicalNormalGenerators_exact_cardinal f⟩

end ArbitraryNormalRankCardinal

