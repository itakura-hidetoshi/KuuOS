section UniversalCrossPresentation

variable {G : Type u} [Group G] {H : Type v} [Group H]

/-- Pair images transport each ORIGINAL ordered relation through
one actual homomorphism. No arbitrary target equality is introduced. -/
def nativeC60DWPairImage (R : Set (G × G)) (τ : G →* H) :
    Set (H × H) :=
  Set.image (fun p : G × G => (τ p.1, τ p.2)) R

theorem nativeC60DWPairImage_mem
    (R : Set (G × G)) (τ : G →* H)
    (p : G × G) (hp : p ∈ R) :
    (τ p.1, τ p.2) ∈ nativeC60DWPairImage R τ :=
  ⟨p, hp, rfl⟩

/-- Construct the ACTUAL quotient morphism between the two separate
groups by DT's universal property, using ONLY transported pairs. -/
theorem nativeC60DWPairImageQuotient_factor
    (R : Set (G × G)) (τ : G →* H) :
    ∃ induced : NativeC60DTQuotient R →*
        NativeC60DTQuotient (nativeC60DWPairImage R τ),
      induced.comp (QuotientGroup.mk' (nativeC60DTNormalClosure R)) =
        (QuotientGroup.mk' (nativeC60DTNormalClosure
          (nativeC60DWPairImage R τ))).comp τ := by
  apply (nativeC60DTQuotient_factor_iff R
    ((QuotientGroup.mk' (nativeC60DTNormalClosure
      (nativeC60DWPairImage R τ))).comp τ)).mpr
  intro p hp
  exact nativeC60DTQuotient_pair_equal (nativeC60DWPairImage R τ)
    (τ p.1, τ p.2) (nativeC60DWPairImage_mem R τ p hp)

/-- TRUE functoriality of the MINIMAL normal kernel: every original
noncommutative defect and all its normal consequences are mapped into
the minimal normal closure of exactly the transported relations. -/
theorem nativeC60DWPairImageNormalClosure_mem
    (R : Set (G × G)) (τ : G →* H) {x : G}
    (hx : x ∈ nativeC60DTNormalClosure R) :
    τ x ∈ nativeC60DTNormalClosure (nativeC60DWPairImage R τ) := by
  obtain ⟨induced, hcomp⟩ := nativeC60DWPairImageQuotient_factor R τ
  have hsource :
      (QuotientGroup.mk' (nativeC60DTNormalClosure R)) x = 1 := by
    apply MonoidHom.mem_ker.mp
    rw [nativeC60DTQuotient_kernel R]
    exact hx
  have htarget :
      (QuotientGroup.mk' (nativeC60DTNormalClosure
        (nativeC60DWPairImage R τ))) (τ x) = 1 := by
    calc
      (QuotientGroup.mk' (nativeC60DTNormalClosure
          (nativeC60DWPairImage R τ))) (τ x) =
          induced ((QuotientGroup.mk'
            (nativeC60DTNormalClosure R)) x) :=
        (DFunLike.congr_fun hcomp x).symm
      _ = induced 1 := congrArg induced hsource
      _ = 1 := map_one induced
  have hk : τ x ∈
      (QuotientGroup.mk' (nativeC60DTNormalClosure
        (nativeC60DWPairImage R τ))).ker :=
    MonoidHom.mem_ker.mpr htarget
  rw [nativeC60DTQuotient_kernel (nativeC60DWPairImage R τ)] at hk
  exact hk

/-- EXACT necessary and sufficient gate for descent to an ARBITRARY
target normal kernel. The right-hand side tests genuine ordered
source-defect images; it is not weakened to scalar observations. -/
theorem nativeC60DWCrossKernelDescent_iff
    (R : Set (G × G)) (τ : G →* H)
    (K : Subgroup H) [K.Normal] :
    (∃ induced : NativeC60DTQuotient R →* (H ⧸ K),
      induced.comp (QuotientGroup.mk' (nativeC60DTNormalClosure R)) =
        (QuotientGroup.mk' K).comp τ) ↔
      ∀ p : G × G, p ∈ R → τ (p.1 * p.2⁻¹) ∈ K := by
  refine (nativeC60DTQuotient_factor_iff R
    ((QuotientGroup.mk' K).comp τ)).trans ?_
  constructor
  · intro hall p hp
    have hpair := hall p hp
    have hmem : τ p.1 / τ p.2 ∈ K :=
      (QuotientGroup.eq_iff_div_mem).mp hpair
    simpa only [div_eq_mul_inv, map_mul, map_inv] using hmem
  · intro hall p hp
    apply (QuotientGroup.eq_iff_div_mem).mpr
    simpa only [div_eq_mul_inv, map_mul, map_inv] using (hall p hp)

/-- A single explicit transported original defect outside the chosen
target normal kernel obstructs ANY proposed quotient descent. -/
theorem nativeC60DWCrossKernel_obstructed
    (R : Set (G × G)) (τ : G →* H)
    (K : Subgroup H) [K.Normal]
    (p : G × G) (hp : p ∈ R)
    (hbad : τ (p.1 * p.2⁻¹) ∉ K) :
    ¬ ∃ induced : NativeC60DTQuotient R →* (H ⧸ K),
      induced.comp (QuotientGroup.mk' (nativeC60DTNormalClosure R)) =
        (QuotientGroup.mk' K).comp τ := by
  intro hfactor
  exact hbad ((nativeC60DWCrossKernelDescent_iff R τ K).mp hfactor p hp)

end UniversalCrossPresentation

section TrueC60AQContextPentagons

variable {L : NativeC60AXLayer.{u}}
variable (S : NativeC60AXSignature L) (F : Bool → NativeC60BCFrame L)

/-- ALL and ONLY genuine ORIGINAL 17D four-path pentagons after
transport by DV's exact entire-dependent-code free group homomorphism.
This is a relative pair family in the distinct context-closed target. -/
def nativeC60DWContextPentagonPairs (word : List Bool) :
    Set (NativeC60DVClosedFullFree S F ×
      NativeC60DVClosedFullFree S F) :=
  nativeC60DWPairImage (nativeC60DTPentagonPairs S F)
    (nativeC60DVFullWordTransport S F word)

/-- Smallest NORMAL kernel forcing exactly the transported ORIGINAL
pentagons; it is not silently the full closed-grammar pentagon kernel. -/
def nativeC60DWContextPentagonNormalClosure (word : List Bool) :
    Subgroup (NativeC60DVClosedFullFree S F) :=
  nativeC60DTNormalClosure (nativeC60DWContextPentagonPairs S F word)

instance nativeC60DWContextPentagonNormalClosure_normal (word : List Bool) :
    (nativeC60DWContextPentagonNormalClosure S F word).Normal :=
  nativeC60DTNormalClosure_normal (nativeC60DWContextPentagonPairs S F word)

abbrev NativeC60DWContextPentagonQuotient (word : List Bool) :=
  NativeC60DVClosedFullFree S F ⧸
    nativeC60DWContextPentagonNormalClosure S F word

/-- Every ACTUAL four-step 17D witness contributes its transported
complete 18D long/short pair with the original dependent history. -/
theorem nativeC60DWActualPentagon_image_mem
    (word : List Bool)
    {a b c d e : (nativeC60DQSeventeenLayer S F).Total}
    (f : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) a b)
    (g : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) b c)
    (h : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) c d)
    (k : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) d e) :
    ((nativeC60DVFullWordTransport S F word)
        (nativeC60DSFreeWord S F (nativeC60DRPentagonLong S F f g h k)),
      (nativeC60DVFullWordTransport S F word)
        (nativeC60DSFreeWord S F (nativeC60DRPentagonShort S F f g h k))) ∈
      nativeC60DWContextPentagonPairs S F word :=
  nativeC60DWPairImage_mem (nativeC60DTPentagonPairs S F)
    (nativeC60DVFullWordTransport S F word) _
    (nativeC60DTPentagon_pair_mem S F f g h k)

/-- The minimal DT all-pentagon kernel maps into the ACTUAL minimal
normal closure of all transported original 18D pentagon defects. -/
theorem nativeC60DWContextPentagon_normalKernel_mem
    (word : List Bool)
    {x : NativeC60DTFullFree S F}
    (hx : x ∈ nativeC60DTPentagonNormalClosure S F) :
    (nativeC60DVFullWordTransport S F word) x ∈
      nativeC60DWContextPentagonNormalClosure S F word :=
  nativeC60DWPairImageNormalClosure_mem
    (nativeC60DTPentagonPairs S F)
    (nativeC60DVFullWordTransport S F word) hx

/-- No 19D filler is needed: the complete original 18D AQ transport
factors as a real group homomorphism between the two explicit,
possibly different ALL-ORIGINAL-PENTAGON quotient presentations. -/
theorem nativeC60DWContextPentagonQuotient_factor
    (word : List Bool) :
    ∃ induced : NativeC60DTPentagonQuotient S F →*
        NativeC60DWContextPentagonQuotient S F word,
      induced.comp (QuotientGroup.mk'
          (nativeC60DTPentagonNormalClosure S F)) =
        (QuotientGroup.mk'
          (nativeC60DWContextPentagonNormalClosure S F word)).comp
            (nativeC60DVFullWordTransport S F word) :=
  nativeC60DWPairImageQuotient_factor
    (nativeC60DTPentagonPairs S F)
    (nativeC60DVFullWordTransport S F word)

/-- These are ACTUAL transported raw18D long/short Type-valued paths.
They become equal AS GROUP WORDS only in the explicitly chosen target
pentagon quotient; no original geometric 19D comparison is inferred. -/
theorem nativeC60DWContextPentagon_typed_words_equal
    (word : List Bool)
    {a b c d e : (nativeC60DQSeventeenLayer S F).Total}
    (f : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) a b)
    (g : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) b c)
    (h : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) c d)
    (k : NativeC60AXStep (nativeC60DQTriangleSeventeenSignature S F) d e) :
    (QuotientGroup.mk'
      (nativeC60DWContextPentagonNormalClosure S F word))
      (nativeC60DVClosedFreeWord S F
        (nativeC60DVTransportEighteenStep S F word
          (nativeC60DRPentagonLong S F f g h k))) =
    (QuotientGroup.mk'
      (nativeC60DWContextPentagonNormalClosure S F word))
      (nativeC60DVClosedFreeWord S F
        (nativeC60DVTransportEighteenStep S F word
          (nativeC60DRPentagonShort S F f g h k))) := by
  rw [← nativeC60DVFullWordTransport_natural S F word
      (nativeC60DRPentagonLong S F f g h k),
    ← nativeC60DVFullWordTransport_natural S F word
      (nativeC60DRPentagonShort S F f g h k)]
  exact nativeC60DTQuotient_pair_equal
    (nativeC60DWContextPentagonPairs S F word) _
    (nativeC60DWActualPentagon_image_mem S F word f g h k)

/-- ALL genuine finite AQ trees yield the constructed quotient descent
with their true noncommutative chronological context words. -/
theorem nativeC60DWActualTreePentagonQuotient_factor
    (tree : NativeK5DOContextTree) :
    ∃ induced : NativeC60DTPentagonQuotient S F →*
        NativeC60DWContextPentagonQuotient S F
          (nativeK5DOTreeWord tree),
      induced.comp (QuotientGroup.mk'
          (nativeC60DTPentagonNormalClosure S F)) =
        (QuotientGroup.mk'
          (nativeC60DWContextPentagonNormalClosure S F
            (nativeK5DOTreeWord tree))).comp
            (nativeC60DVFullWordTransport S F
              (nativeK5DOTreeWord tree)) :=
  nativeC60DWContextPentagonQuotient_factor S F (nativeK5DOTreeWord tree)

/-- Re-parenthesizing the SAME original finite chronological AQ family
changes neither its mapped relation set nor its normal kernel. -/
theorem nativeC60DWActualTreePentagonPairs_refinement
    {left right : NativeK5DOContextTree}
    (h : nativeK5DOTreeSteps left = nativeK5DOTreeSteps right) :
    nativeC60DWContextPentagonPairs S F (nativeK5DOTreeWord left) =
      nativeC60DWContextPentagonPairs S F (nativeK5DOTreeWord right) :=
  congrArg (nativeC60DWContextPentagonPairs S F)
    (nativeK5DOTreeWord_eq_of_steps_eq h)

theorem nativeC60DWActualTreePentagonKernel_refinement
    {left right : NativeK5DOContextTree}
    (h : nativeK5DOTreeSteps left = nativeK5DOTreeSteps right) :
    nativeC60DWContextPentagonNormalClosure S F
      (nativeK5DOTreeWord left) =
    nativeC60DWContextPentagonNormalClosure S F
      (nativeK5DOTreeWord right) :=
  congrArg (nativeC60DWContextPentagonNormalClosure S F)
    (nativeK5DOTreeWord_eq_of_steps_eq h)

end TrueC60AQContextPentagons

section PhysicalC60AQ

variable {D : Type uD} [Category.{vD} D]
