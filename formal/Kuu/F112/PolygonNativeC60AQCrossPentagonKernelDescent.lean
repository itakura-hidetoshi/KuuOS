variable {e d : NativeK5StructuralEightCell p h k}
variable {q t : NativeK5StructuralNineCell p e d}
variable {P Q : NativeK5StructuralTenCell p q t}
variable {H K : NativeK5StructuralElevenCell p P Q}
variable {U V : NativeK5StructuralTwelveCell p H K}

/-- Instantiate the cross-presentation normal-kernel descent for the
GENUINE physical C60 AU 15D source, not an abstract nonphysical graph. -/
theorem nativeK5DWPhysicalAQ_cross_pentagon_descends
    (W : NativeK5StructuralThirteenCell p U V)
    (tree : NativeK5DOContextTree) :
    let S := nativeK5AXKuuSignature W
    let F := nativeK5BCFrame W
    ∃ induced : NativeC60DTPentagonQuotient S F →*
        NativeC60DWContextPentagonQuotient S F
          (nativeK5DOTreeWord tree),
      induced.comp (QuotientGroup.mk'
          (nativeC60DTPentagonNormalClosure S F)) =
        (QuotientGroup.mk'
          (nativeC60DWContextPentagonNormalClosure S F
            (nativeK5DOTreeWord tree))).comp
            (nativeC60DVFullWordTransport S F
              (nativeK5DOTreeWord tree)) := by
  dsimp only
  exact nativeC60DWActualTreePentagonQuotient_factor
    (nativeK5AXKuuSignature W) (nativeK5BCFrame W) tree

end PhysicalC60AQ

