import Kuu.F112.PolygonNativeF55ContextPathActionsP63
import Mathlib.CategoryTheory.Quotient

/-!
# F112-P64 — the genuine typed P62 structural-unit quotient CATEGORY

P62 constructs an explicit inductive equivalence / vertical congruence
on free raw F55 paths, generated by exactly the syntactic
identity-only loops. P63 establishes genuine left/right context
functors on the unquotiented proof-relevant path source.

We now construct the actual Mathlib category quotient by the
*precise P62 typed relation*, not by selected charges or phases.

The important exactness theorem says:
  quotient images of two parallel raw F55 paths agree
  IFF P62's identity-generated path relation relates them.

This is stronger than merely constructing a quotient: it asserts the
quotient introduces no extra source identifications beyond the typed
relation. P61's horizontal two-identity path becomes the categorical
unit in THIS specifically constructed quotient, while remaining a
distinct nonempty word in the original free-path presentation.

The independent previously selected shadow observer factors through
this structural quotient as a theorem of P62 shadow soundness.
No equality of arbitrary equal-shadow raw proofs is imposed.
We do not assert generic horizontal descent, strict interchange,
a global strict 3-category, Gray coherence or hyperdescent.
-/

namespace Kuu.F112.Physical

open CategoryTheory
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
noncomputable section

universe uD vD uE vE
variable {D : Type uD} [Category.{vD} D]
variable {E : Type uE} [Category.{vE} E]

/-- Reinterpret EXACTLY P62's explicit typed relation as a Mathlib
HomRel on the preexisting free native F55 path category. -/
def nativeF55StructuralUnitHomRel
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb) :
    CategoryTheory.HomRel (NativeF55RawPathCategory first last) :=
  fun {_r _s} f g => NativeF55UnitPathRel first last f g

/-- P62's independently defined five-constructor relation satisfies
Mathlib's exact categorical congruence interface: full equivalence
plus left/right compatibility for all vertical path composites.
No new quotient-generated relations or additional assumptions. -/
instance nativeF55StructuralUnitCongruence
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb) :
    CategoryTheory.Congruence (nativeF55StructuralUnitHomRel first last) where
  equivalence := by
    intro r s
    exact nativeF55UnitPathRel_equivalence first last r s
  comp_left := by
    intro r s t f g g' h
    exact NativeF55UnitPathRel.prepend f h
  comp_right := by
    intro r s t f f' g h
    exact NativeF55UnitPathRel.append g h

/-- One precise strict VERTICAL category presented by typed raw paths
and the minimal P62 identity-generated congruence. Distinct from the
raw Type-valued F55 proof syntax and from the shadow-kernel category. -/
abbrev NativeF55StructuralUnitCategory
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb) :=
  CategoryTheory.Quotient (nativeF55StructuralUnitHomRel first last)

/-- The canonical quotient functor maps every true source raw path
to its class without changing any F54 route objects. -/
def nativeF55StructuralUnitQuotientFunctor
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb) :
    NativeF55RawPathCategory first last ⥤
      NativeF55StructuralUnitCategory first last :=
  CategoryTheory.Quotient.functor (nativeF55StructuralUnitHomRel first last)

/-- EXACT kernel theorem: quotient equality is equivalent to the
source's particular P62 typed structural-unit congruence, rather
than to agreement in ONE arbitrary selected numerical shadow. -/
theorem nativeF55StructuralUnitQuotient_map_eq_iff
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb)
    {r s : NativeF55RawRouteVertex first last}
    (f g : Quiver.Path r s) :
    (nativeF55StructuralUnitQuotientFunctor first last).map f =
      (nativeF55StructuralUnitQuotientFunctor first last).map g ↔
      NativeF55UnitPathRel first last f g := by
  exact CategoryTheory.Quotient.functor_map_eq_iff
    (nativeF55StructuralUnitHomRel first last) f g

/-- A real source-level P61 obstruction becomes a unit EQUATION
in the minimal P62 quotient. Both 3-proof source terms remain
distinct in raw syntax, and this theorem does not impose further
horizontal functor or interchange laws. -/
theorem KuuNativeF45Tree.DepthRotationRoute.PresentedCell.horizontal_identities_unit_quotient_eq
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' k k' l l' : Nat}
    {p₀ p₁ p₂ : KuuNativeBlocks a b}
    {q₀ q₁ q₂ : KuuNativeBlocks x y}
    {leftBefore : KuuNativeF45Tree p n m p₀ q₀ p₁ q₁}
    {leftAfter : KuuNativeF45Tree p n' m' p₀ q₀ p₁ q₁}
    {rightBefore : KuuNativeF45Tree p k l p₁ q₁ p₂ q₂}
    {rightAfter : KuuNativeF45Tree p k' l' p₁ q₁ p₂ q₂}
    (u : KuuNativeF45Tree.DepthRotationRoute p leftBefore leftAfter)
    (v : KuuNativeF45Tree.DepthRotationRoute p rightBefore rightAfter) :
    (nativeF55StructuralUnitQuotientFunctor
        (KuuNativeF45Tree.node leftBefore rightBefore)
        (KuuNativeF45Tree.node leftAfter rightAfter)).map
      ((KuuNativeF45Tree.DepthRotationRoute.PresentedCell.ident u).horizontal
         (KuuNativeF45Tree.DepthRotationRoute.PresentedCell.ident v)
        ).toNativeStrictPath =
    (nativeF55StructuralUnitQuotientFunctor
        (KuuNativeF45Tree.node leftBefore rightBefore)
        (KuuNativeF45Tree.node leftAfter rightAfter)).map
      (Quiver.Path.nil :
        Quiver.Path
          (⟨KuuNativeF45Tree.DepthRotationRoute.trans
            (.leftContext u rightBefore) (.rightContext leftAfter v)⟩ :
            NativeF55RawRouteVertex
              (KuuNativeF45Tree.node leftBefore rightBefore)
              (KuuNativeF45Tree.node leftAfter rightAfter))
          ⟨KuuNativeF45Tree.DepthRotationRoute.trans
            (.leftContext u rightBefore) (.rightContext leftAfter v)⟩) := by
  apply (nativeF55StructuralUnitQuotient_map_eq_iff
    (KuuNativeF45Tree.node leftBefore rightBefore)
    (KuuNativeF45Tree.node leftAfter rightAfter) _ _).2
  exact KuuNativeF45Tree.DepthRotationRoute.PresentedCell.horizontal_identities_unit_related
    u v

/-- The prior selected (Z x Z) x ZMod 2 observer now factors
through the minimal structural-unit quotient, since the relation
was proved shadow-sound separately in P62. -/
def nativeF55StructuralUnitToShadow
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb) :
    NativeF55StructuralUnitCategory first last ⥤
      (KuuNativeF45Tree.DepthRotationRoute p first last) :=
  CategoryTheory.Quotient.lift
    (nativeF55StructuralUnitHomRel first last)
    (nativeF55RawPathsToShadow first last)
    (by
      intro r s f g h
      exact NativeF55UnitPathRel.shadow_sound h)

/-- Source raw paths -> structural-unit quotient -> chosen observer
IS the prior observer, with no new numerical identification rule. -/
theorem nativeF55StructuralUnit_shadow_factor
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb) :
    nativeF55StructuralUnitQuotientFunctor first last ⋙
      nativeF55StructuralUnitToShadow first last =
      nativeF55RawPathsToShadow first last := by
  exact CategoryTheory.Quotient.lift_spec
    (nativeF55StructuralUnitHomRel first last)
    (nativeF55RawPathsToShadow first last)
    (by
      intro r s f g h
      exact NativeF55UnitPathRel.shadow_sound h)

/-- Every genuine raw primitive retains its COMPLETE original
selected charge after passage through the strictly weaker typed
structural-unit quotient. This is a preservation theorem, NOT a
definition of the quotient by its charges or a converse statement. -/
theorem nativeF55StructuralUnit_preserves_raw_shadow
    {p : Polygon} {a b : D} {x y : E}
    {n n' m m' : Nat}
    {ma mb : KuuNativeBlocks a b}
    {pa pb : KuuNativeBlocks x y}
    (first : KuuNativeF45Tree p n m ma pa mb pb)
    (last : KuuNativeF45Tree p n' m' ma pa mb pb)
    {u v : KuuNativeF45Tree.DepthRotationRoute p first last}
    (raw : KuuNativeF45Tree.DepthRotationRoute.PresentedCell p u v) :
    nativeF55ThreeEval
      ((nativeF55StructuralUnitToShadow first last).map
        ((nativeF55StructuralUnitQuotientFunctor first last).map
          raw.toNativeRawEdge.toPath)) = raw.nativeShadow := by
  have h := nativeF55StructuralUnit_shadow_factor first last
  have hmap := congrArg
    (fun functor => functor.map raw.toNativeRawEdge.toPath) h
  simpa only [Functor.comp_map, nativeF55RawPathsToShadow_generator,
    nativeF55ThreeEval_of] using
    congrArg nativeF55ThreeEval hmap

#print axioms nativeF55StructuralUnitHomRel
#print axioms nativeF55StructuralUnitCongruence
#print axioms NativeF55StructuralUnitCategory
#print axioms nativeF55StructuralUnitQuotientFunctor
#print axioms nativeF55StructuralUnitQuotient_map_eq_iff
#print axioms KuuNativeF45Tree.DepthRotationRoute.PresentedCell.horizontal_identities_unit_quotient_eq
#print axioms nativeF55StructuralUnitToShadow
#print axioms nativeF55StructuralUnit_shadow_factor
#print axioms nativeF55StructuralUnit_preserves_raw_shadow

end
end Kuu.F112.Physical
