/-!
# F112-P94D3FA — original signed path atoms across actual evidence groups

EZ proved noncommutative inner gauge stability in one original complete
evidence group. DV independently defines an ACTUAL homomorphism between
the ORIGINAL full 18D FreeGroup and a DISTINCT context-closed 18D
FreeGroup, not an original-presentation endomorphism. DW proves exact
cross-presentation descent for chosen pair relations.

FA links these constructions without falsely manufacturing a same-source
endomorphism. Every original dependent Type-valued 19D candidate path
still carries its own signed finite list of original typed atoms (EY).
For ANY genuine group homomorphism, FA proves:
* the ordered whole-path defect maps to the exact signed target product;
* the ORIGINAL path-atom normal kernel maps to the minimal normal
  closure of the actual atom-pair images;
* target normal containment is equivalent to checking EVERY selected
  original dependent generator defect, NOT only their total product;
* a map between the explicit relative quotients exists iff precisely
  these generator-by-generator conditions hold;
* failure produces an ACTUAL selected original typed atom with a
  nontrivial image in the chosen target quotient.

These statements retain complete source Type-valued provenance;
they do not imply equality of raw Type-valued witnesses, make any
geometric 19D filler, or identify a distinct closed 18D target with the
original FreeGroup. No new axiom, sorry, admit, Gray, or abelianization.
Strict Kuu primary, independent Kuu a presentation; DS no-go,
original 14D--18D evidence, 107 roots and pinned Lean/mathlib retained.
Copyright Hidetoshi Itakura / 板倉英俊. Apache-2.0.
-/

namespace Kuu.F112.Physical

open CategoryTheory
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
noncomputable section

universe u v w

section CrossPresentationFiniteSignedAtoms

variable {L : NativeC60AXLayer.{u}}
variable (T : NativeC60AXSignature L)
variable {G : Type v} [Group G] (obs : L.Total → G)
variable {H : Type w} [Group H]

/-- One actually selected pair set, transported to a different group
without assuming that the target has the original 18D alphabet. -/
def nativeC60FASelectedImagePairs
    (A : Set (NativeC60EYPrimitive T)) (τ : G →* H) :
    Set (H × H) :=
  nativeC60DWPairImage (nativeC60EYSelectedPairs T obs A) τ

/-- Evaluation of ANY original signed dependent path commutes with
a real group homomorphism, including noncommuting inverses and
ordered composition, with no quotient of the original syntax. -/
theorem nativeC60FAPath_defect_transport
    (τ : G →* H) {x y : L.Total} (p : NativeC60AXStep T x y) :
    nativeC60EXFoldDefect T (fun a => τ (obs a)) p =
      τ (nativeC60EXFoldDefect T obs p) := by
  rw [nativeC60EXFoldDefect_eq_endpoints,
    nativeC60EXFoldDefect_eq_endpoints]
  simp only [map_mul, map_inv]

/-- Strong finite-list statement: the TRANSPORTED ordered signed
primitive defects are exactly the transported entire original group
defect. The source list retains all true dependent boundaries. -/
theorem nativeC60FAOrdered_signed_product_transport
    (τ : G →* H) {x y : L.Total} (p : NativeC60AXStep T x y) :
    ((nativeC60EYSignedAtoms T p).map
      (nativeC60EYSignedDefect T (fun a => τ (obs a)))).prod =
        τ (nativeC60EXFoldDefect T obs p) := by
  calc
    _ = nativeC60EXFoldDefect T (fun a => τ (obs a)) p :=
      nativeC60EYOrderedDefect_eq_EX T (fun a => τ (obs a)) p
    _ = τ (nativeC60EXFoldDefect T obs p) :=
      nativeC60FAPath_defect_transport T obs τ p

/-- The complete original path defect belongs, AFTER transport, to
the DT normal kernel generated by images of just its USED original
dependent atoms. This is cross-presentation rather than a hidden
same-alphabet or same-group identification. -/
theorem nativeC60FAPath_defect_mem_image_normal
    (τ : G →* H) {x y : L.Total} (p : NativeC60AXStep T x y) :
    τ (nativeC60EXFoldDefect T obs p) ∈
      nativeC60DTNormalClosure
        (nativeC60FASelectedImagePairs T obs
          (nativeC60EYPathAtoms T p) τ) :=
  nativeC60DWPairImageNormalClosure_mem
    (nativeC60EYSelectedPairs T obs (nativeC60EYPathAtoms T p)) τ
    (nativeC60EYPath_defect_mem_exact_atoms T obs p)

/-- EXACT atomic gate for the image-normal kernel to be contained in
an INDEPENDENTLY selected normal target kernel K. Testing only the
ordered total path product is in general insufficient. -/
theorem nativeC60FAImageNormal_le_iff_atoms
    (A : Set (NativeC60EYPrimitive T)) (τ : G →* H)
    (K : Subgroup H) [K.Normal] :
    nativeC60DTNormalClosure
        (nativeC60FASelectedImagePairs T obs A τ) ≤ K ↔
      ∀ a : NativeC60EYPrimitive T, a ∈ A →
        τ (nativeC60EYPrimitiveDefect T obs a) ∈ K := by
  refine (nativeC60DTNormalClosure_le_iff
    (nativeC60FASelectedImagePairs T obs A τ) K).trans ?_
  constructor
  · intro hall a ha
    have hpair :
        (τ (nativeC60EYPrimitiveDefect T obs a), (1 : H)) ∈
          nativeC60FASelectedImagePairs T obs A τ := by
      change (τ (nativeC60EYPrimitiveDefect T obs a), τ (1 : G)) ∈
        nativeC60DWPairImage (nativeC60EYSelectedPairs T obs A) τ
      exact nativeC60DWPairImage_mem
        (nativeC60EYSelectedPairs T obs A) τ
        (nativeC60EYPrimitiveDefect T obs a, (1 : G))
        ⟨a, ha, rfl⟩
    have hm := hall _ hpair
    simpa using hm
  · intro hall pair hp
    change pair ∈ nativeC60DWPairImage
      (nativeC60EYSelectedPairs T obs A) τ at hp
    rcases hp with ⟨source, hsource, rfl⟩
    rcases hsource with ⟨a, ha, rfl⟩
    simpa using hall a ha

/-- EXACT, genuinely cross-presentation relative descent gate.
The source is the minimal original typed-atom quotient; the target
is the INDEPENDENT specified quotient H/K. -/
theorem nativeC60FACrossSelected_factor_iff
    (A : Set (NativeC60EYPrimitive T)) (τ : G →* H)
    (K : Subgroup H) [K.Normal] :
    (∃ induced :
        NativeC60DTQuotient (nativeC60EYSelectedPairs T obs A) →*
          (H ⧸ K),
      induced.comp (QuotientGroup.mk'
        (nativeC60DTNormalClosure (nativeC60EYSelectedPairs T obs A))) =
          (QuotientGroup.mk' K).comp τ) ↔
      ∀ a : NativeC60EYPrimitive T, a ∈ A →
        τ (nativeC60EYPrimitiveDefect T obs a) ∈ K := by
  refine (nativeC60DWCrossKernelDescent_iff
    (nativeC60EYSelectedPairs T obs A) τ K).trans ?_
  constructor
  · intro hall a ha
    have hm := hall
      (nativeC60EYPrimitiveDefect T obs a, (1 : G))
      (show (nativeC60EYPrimitiveDefect T obs a, (1 : G)) ∈
        nativeC60EYSelectedPairs T obs A from ⟨a, ha, rfl⟩)
    simpa using hm
  · intro hall pair hp
    rcases hp with ⟨a, ha, rfl⟩
    simpa using hall a ha

/-- A PARTICULAR original typed primitive from A, whose transported
complete defect does not lie in K, prevents the chosen relative
quotient descent. This is an actual atom certificate, not an
unrelated abstract obstruction. -/
theorem nativeC60FACrossSelected_bad_atom_obstructs
    (A : Set (NativeC60EYPrimitive T)) (τ : G →* H)
    (K : Subgroup H) [K.Normal]
    (a : NativeC60EYPrimitive T)
    (ha : a ∈ A)
    (hbad : τ (nativeC60EYPrimitiveDefect T obs a) ∉ K) :
    ¬ ∃ induced :
        NativeC60DTQuotient (nativeC60EYSelectedPairs T obs A) →*
          (H ⧸ K),
      induced.comp (QuotientGroup.mk'
        (nativeC60DTNormalClosure (nativeC60EYSelectedPairs T obs A))) =
          (QuotientGroup.mk' K).comp τ := by
  intro hfactor
  have hgood := (nativeC60FACrossSelected_factor_iff
    T obs A τ K).mp hfactor
  exact hbad (hgood a ha)

/-- Failure of cross-presentation descent is EXACTLY a path-selected
atomic obstruction, for any explicitly chosen typed primitive family.
This equivalence is classical but adds no logical axiom. -/
theorem nativeC60FACrossSelected_failure_iff_bad_atom
    (A : Set (NativeC60EYPrimitive T)) (τ : G →* H)
    (K : Subgroup H) [K.Normal] :
    (¬ ∃ induced :
        NativeC60DTQuotient (nativeC60EYSelectedPairs T obs A) →*
          (H ⧸ K),
      induced.comp (QuotientGroup.mk'
        (nativeC60DTNormalClosure (nativeC60EYSelectedPairs T obs A))) =
          (QuotientGroup.mk' K).comp τ) ↔
      ∃ a : NativeC60EYPrimitive T,
        a ∈ A ∧ τ (nativeC60EYPrimitiveDefect T obs a) ∉ K := by
  classical
  constructor
  · intro hno
    by_contra hbad
    have hall : ∀ a : NativeC60EYPrimitive T, a ∈ A →
        τ (nativeC60EYPrimitiveDefect T obs a) ∈ K := by
      intro a ha
      by_contra hnot
      exact hbad ⟨a, ha, hnot⟩
    exact hno ((nativeC60FACrossSelected_factor_iff
      T obs A τ K).mpr hall)
  · rintro ⟨a, ha, hbad⟩
    exact nativeC60FACrossSelected_bad_atom_obstructs
      T obs A τ K a ha hbad

/-- If all genuine source primitive defects descend into K, so does
their noncommutative signed total product; the converse for each
primitive does NOT follow from the total product alone. -/
theorem nativeC60FAPath_total_mem_target
    (τ : G →* H) (K : Subgroup H) [K.Normal]
    {x y : L.Total} (p : NativeC60AXStep T x y)
    (hall : ∀ a : NativeC60EYPrimitive T,
      a ∈ nativeC60EYPathAtoms T p →
      τ (nativeC60EYPrimitiveDefect T obs a) ∈ K) :
    τ (nativeC60EXFoldDefect T obs p) ∈ K := by
  have hle := (nativeC60FAImageNormal_le_iff_atoms T obs
    (nativeC60EYPathAtoms T p) τ K).mpr hall
  exact hle (nativeC60FAPath_defect_mem_image_normal T obs τ p)

end CrossPresentationFiniteSignedAtoms

