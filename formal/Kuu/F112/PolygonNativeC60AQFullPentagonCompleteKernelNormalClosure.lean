/-- Genuine original FJ transport: exact complete normal generation for
every word, not a statement that its single known defect suffices. -/
theorem nativeK5FOOldFullKernel_exact
    (W : NativeK5StructuralThirteenCell p U V) (word : List Bool) :
    (nativeC60DVFullWordTransport
      (nativeK5AXKuuSignature W) (nativeK5BCFrame W) word).ker =
      nativeC60FOFullKernelNormalClosure
        (nativeK5AXKuuSignature W) (nativeK5BCFrame W) word :=
  nativeC60FOFullTransport_kernel_eq_normalClosure
    (nativeK5AXKuuSignature W) (nativeK5BCFrame W) word

/-- The old shared FJ two-letter defect belongs to this EXACT whole
kernel normal closure in every nonempty genuine physical context. -/
theorem nativeK5FOOldUniversalDefect_mem
    (W : NativeK5StructuralThirteenCell p U V)
    (R : NativeK5FifteenFourteenFiber W)
    (word : List Bool) (hne : word ≠ []) :
    nativeK5FJPhysicalUniversalDefect W R ∈
      nativeC60FOFullKernelNormalClosure
        (nativeK5AXKuuSignature W) (nativeK5BCFrame W) word := by
  apply (nativeC60FOFullKernel_mem_iff
    (nativeK5AXKuuSignature W) (nativeK5BCFrame W) word _).mpr
  exact (nativeK5FJPhysicalUniversalDefect_all_nonempty W R).2 word hne

/-- All nonempty old physical contexts have NONTRIVIAL whole collision
normal closures, witnessed by the retained original FJ Type-valued pair. -/
theorem nativeK5FOOldFullKernel_ne_bot
    (W : NativeK5StructuralThirteenCell p U V)
    (word : List Bool) (hne : word ≠ []) :
    nativeC60FOFullKernelNormalClosure
      (nativeK5AXKuuSignature W) (nativeK5BCFrame W) word ≠ ⊥ := by
  intro hbot
  have hmem := nativeK5FOOldUniversalDefect_mem W
    (nativeK5FifteenCriticalLeft W) word hne
  rw [hbot, Subgroup.mem_bot] at hmem
  exact (nativeK5FJPhysicalUniversalDefect_all_nonempty W
    (nativeK5FifteenCriticalLeft W)).1 hmem

/-- The independently selected FK/FL/FM alternative has TRIVIAL complete
collision normal closure at EVERY finite word. Its alphabet is separate
from the original FJ one, and the old nontrivial closure is not erased. -/
theorem nativeK5FOAlternativeFullKernel_eq_bot
    (W : NativeK5StructuralThirteenCell p U V)
    (word : List Bool) :
    nativeC60FOFullKernelNormalClosure
      (nativeK5AXKuuSignature W) (nativeK5FKBCFrame W) word = ⊥ := by
  apply le_antisymm
  · intro z hz
    apply Subgroup.mem_bot.mpr
    exact nativeK5FMFullFree_kernel_trivial W word z
      ((nativeC60FOFullKernel_mem_iff
        (nativeK5AXKuuSignature W) (nativeK5FKBCFrame W) word z).mp hz)
  · exact bot_le

end OriginalAndAlternativePhysicalKernels

-- Regression obligations: arbitrary types, empty domain, constant map,
-- and a nonsurjective map. No additional inhabited/surjective assumptions.
example {A : Type u} {B : Type v} (f : A → B) :
    (FreeGroup.map f).ker = nativeC60DTNormalClosure
      {pair : FreeGroup A × FreeGroup A |
        ∃ a b : A, f a = f b ∧ pair = (FreeGroup.of a, FreeGroup.of b)} :=
  nativeC60FOFreeMap_ker_eq_normalClosure f

example : (FreeGroup.map (fun x : Empty => (Empty.elim x : Bool))).ker =
    nativeC60FOFiberNormalClosure (fun x : Empty => (Empty.elim x : Bool)) :=
  nativeC60FOFreeMap_ker_eq_normalClosure _

example : (FreeGroup.map (fun _ : Bool => ())).ker =
    nativeC60FOFiberNormalClosure (fun _ : Bool => ()) :=
  nativeC60FOFreeMap_ker_eq_normalClosure _

example : (FreeGroup.map (fun n : Nat => n + 1)).ker =
    nativeC60FOFiberNormalClosure (fun n : Nat => n + 1) :=
  nativeC60FOFreeMap_ker_eq_normalClosure _

