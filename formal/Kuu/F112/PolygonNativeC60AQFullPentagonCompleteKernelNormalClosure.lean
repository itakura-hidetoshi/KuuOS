universe u v w uD vD uE vE

/-- ALL exact source-letter fiber pairs, before any group quotient.
The entire source letters are retained, not their scalar shadows. -/
def nativeC60FOFiberPairs {A : Type u} {B : Type v} (f : A → B) :
    Set (FreeGroup A × FreeGroup A) :=
  {pair | ∃ a b : A, f a = f b ∧
    pair = (FreeGroup.of a, FreeGroup.of b)}

/-- Normal closure of every genuine two-letter fiber difference. -/
abbrev nativeC60FOFiberNormalClosure
    {A : Type u} {B : Type v} (f : A → B) :=
  nativeC60DTNormalClosure (nativeC60FOFiberPairs f)

abbrev NativeC60FOFiberQuotient
    {A : Type u} {B : Type v} (f : A → B) :=
  NativeC60DTQuotient (nativeC60FOFiberPairs f)

/-- Exact receiver factorization criterion for an arbitrary free-group map.
Target letters outside the image can be sent to identity. No source inhabitant
or surjectivity is needed. Such extensions are NOT asserted to be unique. -/
theorem nativeC60FOFreeMap_factor_iff
    {A : Type u} {B : Type v} {G : Type w} [Group G]
    (f : A → B) (receiver : FreeGroup A →* G) :
    (∃ target : FreeGroup B →* G,
      target.comp (FreeGroup.map f) = receiver) ↔
      ∀ a b : A, f a = f b →
        receiver (FreeGroup.of a) = receiver (FreeGroup.of b) := by
  classical
  constructor
  · rintro ⟨target, htarget⟩ a b hab
    have ha := DFunLike.congr_fun htarget (FreeGroup.of a)
    have hb := DFunLike.congr_fun htarget (FreeGroup.of b)
    change target ((FreeGroup.map f) (FreeGroup.of a)) =
      receiver (FreeGroup.of a) at ha
    change target ((FreeGroup.map f) (FreeGroup.of b)) =
      receiver (FreeGroup.of b) at hb
    have hm : (FreeGroup.map f) (FreeGroup.of a) =
        (FreeGroup.map f) (FreeGroup.of b) := by
      change FreeGroup.of (f a) = FreeGroup.of (f b)
      exact congrArg FreeGroup.of hab
    exact ha.symm.trans ((congrArg target hm).trans hb)
  · intro compatible
    let letter : B → G := fun b =>
      if hb : ∃ a : A, f a = b then
        receiver (FreeGroup.of (Classical.choose hb))
      else 1
    refine ⟨FreeGroup.lift letter, ?_⟩
    apply FreeGroup.ext_hom
    intro a
    change (FreeGroup.lift letter)
        ((FreeGroup.map f) (FreeGroup.of a)) = receiver (FreeGroup.of a)
    rw [FreeGroup.map.of, FreeGroup.lift_apply_of]
    have hex : ∃ x : A, f x = f a := ⟨a, rfl⟩
    dsimp only [letter]
    rw [dif_pos hex]
    exact compatible (Classical.choose hex) a (Classical.choose_spec hex)

/-- MAIN FO: the ENTIRE kernel, not merely a chosen nontrivial subgroup,
is normally generated by ALL source-letter collisions of f. -/
theorem nativeC60FOFreeMap_ker_eq_normalClosure
    {A : Type u} {B : Type v} (f : A → B) :
    (FreeGroup.map f).ker = nativeC60FOFiberNormalClosure f := by
  classical
  let project : FreeGroup A →* NativeC60FOFiberQuotient f :=
    QuotientGroup.mk' (nativeC60FOFiberNormalClosure f)
  have hproject : ∀ a b : A, f a = f b →
      project (FreeGroup.of a) = project (FreeGroup.of b) := by
    intro a b hab
    exact nativeC60DTQuotient_pair_equal (nativeC60FOFiberPairs f)
      (FreeGroup.of a, FreeGroup.of b) ⟨a, b, hab, rfl⟩
  obtain ⟨target, htarget⟩ :=
    (nativeC60FOFreeMap_factor_iff f project).mpr hproject
  apply le_antisymm
  · intro z hz
    apply (QuotientGroup.eq_one_iff
      (N := nativeC60FOFiberNormalClosure f) z).mp
    change project z = 1
    rw [← htarget]
    change target ((FreeGroup.map f) z) = 1
    rw [MonoidHom.mem_ker.mp hz, map_one]
  · apply (nativeC60DTNormalClosure_ker_iff
      (nativeC60FOFiberPairs f) (FreeGroup.map f)).mpr
    rintro pair ⟨a, b, hab, rfl⟩
    change FreeGroup.of (f a) = FreeGroup.of (f b)
    exact congrArg FreeGroup.of hab

section FullDependentEighteenCode

variable {L : NativeC60AXLayer.{u}}
variable (S : NativeC60AXSignature L) (F : Bool → NativeC60BCFrame L)

/-- The generating family is all collisions of the ACTUAL complete 18D
code map, including original endpoints and recursive Type-valued evidence. -/
abbrev nativeC60FOFullKernelNormalClosure (word : List Bool) :=
  nativeC60FOFiberNormalClosure (nativeC60DVTransportCompleteCode S F word)

/-- The exact whole-kernel normal presentation of the EXISTING DV
signed noncommutative full-word transport at every finite AQ word. -/
theorem nativeC60FOFullTransport_kernel_eq_normalClosure
    (word : List Bool) :
    (nativeC60DVFullWordTransport S F word).ker =
      nativeC60FOFullKernelNormalClosure S F word := by
  rw [nativeC60FCTransport_eq_freeMap S F word]
  exact nativeC60FOFreeMap_ker_eq_normalClosure _

/-- Every signed word is in the normal closure precisely when its actual
full DV image is identity; no projection to parity or abelianization. -/
theorem nativeC60FOFullKernel_mem_iff
    (word : List Bool) (z : NativeC60DTFullFree S F) :
    z ∈ nativeC60FOFullKernelNormalClosure S F word ↔
      (nativeC60DVFullWordTransport S F word) z = 1 := by
  rw [← nativeC60FOFullTransport_kernel_eq_normalClosure S F word]
  exact MonoidHom.mem_ker

/-- Equality of TWO full transported words is exactly membership of their
ordered, noncommutative difference in the collision-generated normal closure. -/
theorem nativeC60FOFullTransport_eq_iff_difference_mem
    (word : List Bool) (x y : NativeC60DTFullFree S F) :
    (nativeC60DVFullWordTransport S F word) x =
        (nativeC60DVFullWordTransport S F word) y ↔
      x * y⁻¹ ∈ nativeC60FOFullKernelNormalClosure S F word := by
  rw [nativeC60FOFullKernel_mem_iff S F word, map_mul, map_inv]
  constructor
  · intro h
    rw [h, mul_inv_cancel]
  · exact eq_of_mul_inv_eq_one

/-- A group-valued receiver descends through the actual full DV transport
iff it respects EVERY full source-code collision. The target is the existing
context-closed alphabet, not a newly invented receiver. Existence only:
values on unused target letters need not be unique. -/
theorem nativeC60FOReceiver_descends_iff_code_fibers
    {G : Type v} [Group G]
    (word : List Bool) (receiver : NativeC60DTFullFree S F →* G) :
    (∃ target : NativeC60DVClosedFullFree S F →* G,
      target.comp (nativeC60DVFullWordTransport S F word) = receiver) ↔
      ∀ a b : NativeC60DSCompleteEighteenCode S F,
        nativeC60DVTransportCompleteCode S F word a =
          nativeC60DVTransportCompleteCode S F word b →
        receiver (FreeGroup.of a) = receiver (FreeGroup.of b) := by
  rw [nativeC60FCTransport_eq_freeMap S F word]
  exact nativeC60FOFreeMap_factor_iff _ receiver

/-- Actual complete-code collisions give the defining normally generating
signed differences, not just some unrelated kernel elements. -/
theorem nativeC60FOCodeFiberDefect_mem
    (word : List Bool)
    {a b : NativeC60DSCompleteEighteenCode S F}
    (hab : nativeC60DVTransportCompleteCode S F word a =
      nativeC60DVTransportCompleteCode S F word b) :
    nativeC60FCCodeFiberDefect S F a b ∈
      nativeC60FOFullKernelNormalClosure S F word := by
  apply (nativeC60FOFullKernel_mem_iff S F word _).mpr
  exact nativeC60FCCodeFiberDefect_maps_one S F word hab

end FullDependentEighteenCode

